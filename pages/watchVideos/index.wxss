.container {
  width: 100%;
  height: 95vh;
  display: flex;
  flex-direction: column;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  touch-action: pan-x;
  position: relative;
}

/* 主要内容容器 */
.content-container {
  background-color: #fff;
  position: absolute;
  bottom: 10rpx;
  left: 0;
  right: 0;
  width: 96%;
  margin: auto;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  /* 子元素垂直排列 */
}


.video-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.play-area {
  background-color: #000;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
}

.video-player {
  width: 100%;
  height: 70vh;
}

.btn-group {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.operate-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 32rpx;
  border-radius: 40rpx;
}

.play-btn {
  background-color: #07c160;
  color: #fff;
}

.download-btn {
  background-color: #1677ff;
  color: #fff;
}

.tip-text {
  font-size: 28rpx;
  text-align: center;
  padding: 10rpx;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

.success {
  color: #07c160;
  background-color: #f0f9ff;
}

.error {
  color: #f53f3f;
  background-color: #fff2f2;
}

.info {
  color: #1677ff;
  background-color: #e8f3ff;
}