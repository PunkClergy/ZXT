<view class="container">
	<view class="page-header">
		<text class="main-title">车辆共享管理</text>
		<text class="sub-title">默认共享至全部OTA，可单独配置</text>
	</view>

	<scroll-view scroll-y class="car-scroll">
		<!-- 车辆列表 -->
		<view class="car-card" wx:for="{{carList}}" wx:key="carId">
			<!-- 车辆信息 + 全部OTA按钮 -->
			<view class="car-info-row">
				<view class="car-info">
					<text class="car-name">{{item.vehicleSerialName}}{{item.vehicleModeName}}</text>
					<text class="car-plate">{{item.platenumber}}</text>
				</view>

				<!-- 全部OTA 按钮 -->
				<view class="all-ota-btn {{item.otaStatus ? 'off' : 'on'}}" bindtap="handleAllOTA" data-vehId="{{item.id}}" data-item="{{item}}" data-status="{{item.otaStatus}}">
					{{item.otaStatus ? '取消共享' : '全部共享'}}
				</view>
			</view>

			<!-- 每辆车自己的 OTA 列表 -->
			<view class="ota-switch-group">
				<view wx:for="{{item.otaList}}" wx:key="id" wx:for-item="ota" class="ota-switch-item">
					<text class="ota-name">{{ota.name}}</text>
					<switch checked="{{ota.shared == 1}}" data-shared="{{ota.shared}}" data-carid="{{item.id}}" data-otaid="{{ota.id}}" bindchange="handleSingleOTA" color="#07c160" />
				</view>
			</view>
		</view>
	</scroll-view>

	<view wx:if="{{carList.length === 0}}" class="empty">暂无车辆</view>
</view>