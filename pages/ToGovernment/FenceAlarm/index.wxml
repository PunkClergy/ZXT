<view class="page-container">

<!-- 统计卡片 -->
<view class="stats-card">
  <view class="stats-item">
	<text class="stats-num risky">{{totalCount}}</text>
	<text class="stats-label">异常记录总数</text>
  </view>
  <view class="stats-item">
	<text class="stats-num risky">{{todayCount}}</text>
	<text class="stats-label">今日新增异常</text>
  </view>
</view>

<!-- 异常记录列表（滚动容器） -->
<view class="record-list-container">
  <view class="list-title">
	<text>出/入围栏异常记录</text>
	<view class="filter-btn" bindtap="openFilterModal">筛选 📋</view>
  </view>

  <view class="record-item" wx:for="{{filteredRecords}}" wx:key="recordId" bindtap="goRecordDetail" data-record="{{item}}">
	<view class="record-left">
	  <text class="record-time">{{item.platenumber}}【SN:{{item.sn}}】</text>
	  <text class="record-desc">⚠️ {{item.efencestateName}}</text>
	  <text class="record-vehicle">{{item.vehicleSerialName}}{{item.vehicleModeName}}</text>
	  <text class="record-vehicle">{{item.alarmtime}}</text>
	</view>
	<view class="record-right">
	  <button class="nav-btn" size="mini" bindtap="handleNavToRecord" data-record="{{item}}" catchtap>查看位置</button>
	  <text class="weidu">{{item.state == 1 ? '已读' : '未读'}}</text>
	</view>
  </view>

  <view class="empty" wx:if="{{filteredRecords.length === 0}}">暂无符合条件的异常记录</view>
</view>
</view>

<!-- 筛选弹窗 -->
<view class="filter-modal" wx:if="{{showFilterModal}}">
<view class="modal-mask" bindtap="closeFilterModal"></view>
<view class="modal-content">
  <view class="modal-title">筛选条件</view>

  <view class="filter-item">
	<text class="filter-label">选择日期：</text>
	<picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
	  <view class="picker-input">{{selectedDate || '请选择日期'}}</view>
	</picker>
  </view>

  <view class="filter-item">
	<text class="filter-label">车牌号：</text>
	<input class="input-box" placeholder="请输入车牌号（如京A00293）" value="{{inputCarNumber}}" bindinput="onCarNumberInput" focus="{{focusCarInput}}"/>
	<view class="car-list" wx:if="{{carCandidateList.length > 0}}">
	  <view class="car-item" wx:for="{{carCandidateList}}" wx:key="platenumber" bindtap="selectCarNumber" data-carnumber="{{item.platenumber}}">
		{{item.vehicleSerialName}}{{item.vehicleModeName}}（{{item.platenumber}}）
	  </view>
	</view>
  </view>

  <view class="btn-group">
	<button class="reset-btn" bindtap="resetFilter">重置</button>
	<button class="confirm-btn" bindtap="confirmFilter">确认筛选</button>
  </view>
</view>
</view>