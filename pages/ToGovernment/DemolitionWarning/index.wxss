page {
  height: 100vh;
  overflow: hidden;
  background: #f5f7fa;
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0 30rpx 10rpx 30rpx;
  /* 底部仅留极小呼吸空间 */
  box-sizing: border-box;
  background: #f5f7fa;
  overflow: hidden;
}

.stats-card {
  flex-shrink: 0;
  display: flex;
  margin: 20rpx 0 16rpx 0;
  padding: 30rpx 0;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  width: 100%;
  box-sizing: border-box;
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-num {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #fa4143;
}

.stats-label {
  font-size: 24rpx;
  color: #999;
}

/* 列表容器：自动占满剩余高度，内部滚动 */
.record-list-container {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  width: 100%;
  box-sizing: border-box;
  padding-bottom: 6rpx;
}

.list-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0 20rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  position: sticky;
  top: 0;
  background: #f5f7fa;
  z-index: 5;
  box-sizing: border-box;
}

.filter-btn {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  background: #f5f5f5;
  color: #333;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  flex-shrink: 0;
}

.record-item {
  display: flex;
  justify-content: space-between;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #fa4143;
  box-sizing: border-box;
}

.record-left {
  flex: 1;
  min-width: 0;
}

.record-time {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.record-desc {
  font-size: 28rpx;
  color: #fa4143;
  display: block;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.record-vehicle {
  font-size: 24rpx;
  color: #666;
  display: block;
  line-height: 1.6;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.weidu {
  font-size: 26rpx;
  color: #333;
  margin-top: 12rpx;
}

.nav-btn {
  background: #fa4143;
  color: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  line-height: 1.8;
  border: none;
}

.nav-btn::after {
  border: none;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 筛选弹窗 */
.filter-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 999;
}

.modal-mask {
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
  padding: 30rpx;
  box-sizing: border-box;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  text-align: center;
}

.filter-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
  position: relative;
}

.filter-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.picker-input,
.input-box {
  height: 80rpx;
  line-height: 80rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #666;
  box-sizing: border-box;
}

.car-list {
  width: 100%;
  max-height: 200rpx;
  overflow-y: auto;
  border: 1rpx solid #eee;
  border-top: none;
  border-radius: 0 0 8rpx 8rpx;
  margin-top: -1rpx;
  background: #fff;
}

.car-item {
  padding: 20rpx;
  font-size: 26rpx;
  color: #333;
  border-bottom: 1rpx solid #f5f5f5;
}

.car-item:last-child {
  border-bottom: none;
}

.car-item:active {
  background: #f5f5f5;
}

.btn-group {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.reset-btn,
.confirm-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
  text-align: center;
}

.reset-btn {
  background: #f5f5f5;
  color: #333;
}

.confirm-btn {
  background: #fa4143;
  color: #fff;
}

.reset-btn::after,
.confirm-btn::after {
  border: none;
}