<view class="container" style="height: {{c_screen_height}}px;">
  <!-- <custom-header title="采购下单" /> -->
  <!-- 自定义头部区域：包含系统状态栏高度适配，使用custom-header样式 -->
  <view class="custom-header" style="padding-top: {{height_from_head}}px;padding-left: {{capsule_distance_to_the_right}}px; height: {{head_height}}px;">
    <view class="custom-header-outer-layer">
      <image class="custom-header-outer-layer-image" src="/assets/images/index/home.png" bindtap="handleBackHome"></image>
      <view class="custom-header-outer-layer-title">采购下单</view>
      <view class="custom-header-outer-layer-user_name">
        <block wx:if="{{account}}">
          <text>{{account}}</text>
        </block>
        <block wx:else>
          <text bindtap="handleOnExistingAccountTap">请登录</text>
          <image bindtap="handleOnExistingAccountTap" src="/assets/images/home/right_1.png" />
        </block>
      </view>
    </view>
  </view>
  <view class="record-container" style="height: {{c_screen_height-(navBarHeight + statusBarHeight + 10 +80)}}px;margin-top: {{navBarHeight + statusBarHeight}}px;">
    <!-- 切换部分 -->
    <view class="record-tabs" bindtap="handleSwitchTab">
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 1?s_background_tabs_active_1:s_background_tabs_1}}');">采购订单</view>
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 2?s_background_tabs_2:s_background_tabs_active_2}}');">新增订单</view>
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 3?s_background_tabs_2:s_background_tabs_active_2}}');">续费充值</view>

    </view>
    <!-- 详情区域部分 -->
    <block wx:if="{{c_activeTab == 1}}">

      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50 +80)}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
        <block wx:for="{{g_items}}" wx:key="index" wx:for-item="item">
          <view class="content-item" data-item="{{item}}">
            <view class="content-item-head">
              <view class="head-left">
                <view class="left-category">
                  <text>原始订单 ：{{item.orderno||'-'}}</text>
                </view>
              </view>
              <view class="head-right">
                <image src="/assets/images/home/_see.png" data-item="{{item}}" catchtap="handleOriginalView" />
                <image wx:if="{{item.status == -1}}" src="/assets/images/home/_delete.png" data-item="{{item}}" bindtap="handleDelete" />
                <image wx:else src="/assets/images/home/qxdd.png" data-item="{{item}}" bindtap="handleCancel" />
              </view>
            </view>
            <view class="content-item-info">
              <view class="info-item  {{item.createdate.length > 8 ? 'long-info-item' : ''}}">
                <label>开单时间 ：</label>
                <text>{{item.createdate||'-'}}</text>
              </view>
              <view class="info-item  {{item.statusName.length > 8 ? 'long-info-item' : ''}}">
                <label>订单状态 ：</label>
                <text>{{item.statusName||'-'}}</text>
              </view>
              <view class="info-item  {{item.industry.length > 8 ? 'long-info-item' : ''}}">
                <label>行业 ：</label>
                <text>{{item.industry||'-'}}</text>
              </view>

              <view class="info-item  {{item.deviceclass.length > 15 ? 'long-info-item' : ''}}">
                <label>设备类型 ：</label>
                <text>{{item.deviceclass||'-'}}</text>
              </view>
              <view class="info-item  {{item.buycount.length > 15 ? 'long-info-item' : ''}}">
                <label>设备数量 ：</label>
                <text>{{item.buycount||'-'}}</text>
              </view>

              <block wx:for="{{item.childOrderList}}" wx:key="index" wx:for-item="childItem">
                <view class="content-item" data-item="{{childItem}}" bindtap="handleView" style="width: 100%;">
                  <view class="content-item-head">
                    <view class="head-left">
                      <view class="left-category">
                        <text>子订单{{index+1}} ：{{childItem.num||'-'}}</text>
                      </view>
                    </view>
                    <view class="head-right">
                      <image src="/assets/images/home/_see.png" data-item="{{childItem}}" catchtap="handleView" />
                    </view>
                  </view>
                  <view class="content-item-info">
                    <view class="info-item  {{childItem.deviceTypeName.length > 8 ? 'long-info-item' : ''}}">
                      <label>销售单代号 ：</label>
                      <text>{{childItem.deviceTypeName||'-'}}</text>
                    </view>
                    <view class="info-item  {{childItem.devicefun.length > 8 ? 'long-info-item' : ''}}">
                      <label>数量 ：</label>
                      <text>{{childItem.deviceCount||'-'}}</text>
                    </view>
                    <view class="info-item  {{childItem.cost.length > 15 ? 'long-info-item' : ''}}">
                      <label>金额 ：</label>
                      <text>{{childItem.cost||'待确认'}}</text>
                    </view>
                  </view>
                  <view class="content-item-footer">
                    <view class="footer-left"></view>
                    <view class="footer-right" data-item="{{childItem}}">
                      {{childItem.statusName}}
                    </view>
                  </view>
                </view>
              </block>
            </view>
            <!-- <view class="content-item-footer">
              <view class="footer-left">
                开单时间: {{item.createdate||'-'}}
              </view>
              <view class="footer-right" data-item="{{item}}">
                {{item.statusName}}
              </view>
            </view> -->
          </view>
        </block>
      </scroll-view>
    </block>
    <block wx:if="{{c_activeTab == 2}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50 +80)}}px;">
        <view class="card-info">
          <!-- 行业 -->
          <view class="card-info-item">
            <label>行业<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <picker range-key="name" range="{{g_industry}}" bindchange="handleIndustryType">
                  <block wx:if="{{g_industry_index==null}}">
                    <text style="color: #666;font-size: 26rpx; ">请选择所属行业</text>
                  </block>
                  <block wx:else>
                    <text style="color: #333;font-size: 26rpx;">{{g_industry[g_industry_index].name}}</text>
                  </block>
                </picker>
              </view>
            </block>
          </view>
          <!-- 设备单价 -->
          <view class="card-info-item" wx:if="{{industry_price}}">
            <label>设备单价</label>
            <view class="card-info-item-input">
              ￥{{industry_price}}
            </view>
          </view>
          <!-- 数量 -->
          <view class="card-info-item" wx:if="{{!g_core_type_index.isneedcar}}">
            <label>数量<text>*</text></label>
            <view class="card-info-item-input">
              <input disabled="{{g_device_type_list[g_device_type_index].id == 11}}" style="opacity: {{g_device_type_list[g_device_type_index].id == 11?'0.5':'1'}};" type="number" placeholder="请输入数量" value="{{buycount}}" data-item="buycount" bindinput="handleNumBindinput" />
            </view>
          </view>

          <!-- 是否安装 -->
          <view class="card-info-item" wx:if="{{installation_price!=0}}">
            <label>是否安装<text>*</text></label>
            <view class="card-info-item-input" style="display: flex;flex-direction: column;justify-content: flex-end;align-items: flex-end;">
              <radio-group bindchange="handleVicheRadioChange" style="display: flex;align-items: center;gap: 20rpx;">
                <label wx:for="{{g_install_list}}" wx:key="index" style="display: flex;align-items: center;">
                  <radio value="{{item.value}}" checked="{{g_install_index == item.value}}" style=" transform: scale(0.7);" />
                  <view>{{item.name}}</view>
                </label>
              </radio-group>
              <text style="color: #666;font-size: 22rpx;" wx:if="{{g_install_index==1}}">若需提供安装服务，每台将收取安装费用 {{installation_price}} 元</text>
            </view>
          </view>
          <!-- 订单总价 -->
          <view class="card-info-item" wx:if="{{industry_price&&buycount}}">
            <label>订单总价</label>
            <view class="card-info-item-input" style="display: flex;flex-direction: column;justify-content: flex-end;align-items: flex-end;">
              <text>￥{{totalPrice}}</text>
              <text style="color: #666;font-size: 22rpx;">{{industry_price}}(单价)X{{buycount}}(数量)+{{installation_price}}(安装费)X{{buycount}}(数量)={{totalPrice}}(总价)</text>
            </view>
          </view>

          <!-- 客户收货地址 -->
          <view class="card-info-item">
            <label>客户收货地址<text>*</text></label>
            <view class="card-info-item-input">
              <view disabled="true" data-type="receiving" data-item="{{g_receiving_address}}" bindtap="handleSelectAddress" style="font-size: 26rpx;color: #666;">
                {{g_receiving_address?g_receiving_address:'请输入客户收货地址'}}
              </view>
            </view>
          </view>
          <!-- 钥匙邮寄 -->
          <view class="card-info-item">
            <label>钥匙邮寄<text>*</text></label>
            <view class="card-info-item-input" style="display: flex;flex-direction: column;justify-content: flex-end;align-items: flex-end;">
              <picker range="{{goodsList}}" range-key="name" value="{{selectIndex}}" bindchange="onPickerChange">
                <!-- 下拉框的展示区域，自定义样式 -->
                <block wx:if="{{!selectItem.name}}">
                  <text style="color: #666;font-size: 26rpx; ">请选择取钥匙方式</text>
                </block>
                <block wx:else>
                  <text style="color: #333;font-size: 26rpx;">{{selectItem.name}}</text>
                </block>
              </picker>

            </view>
          </view>
          <!-- 上门取钥匙地址 -->
          <view class="card-info-item" wx:if="{{selectItem.id  == 3&&g_receiving_address}}">
            <label>上门取钥匙地址<text>*</text></label>
            <view class="card-info-item-input">
              <view disabled="true" data-type="door" data-item="{{g_receiving_address}}" bindtap="handleSelectAddress" style="font-size: 26rpx;color: #666;">
                {{g_door_address||g_receiving_address}}
              </view>
            </view>
          </view>
          <!-- 智信通地址 -->
          <view class="card-info-item" wx:if="{{selectItem.id  == 2}}">
            <label>智信通地址<text>*</text></label>
            <view class="card-info-item-input" bindtap="handleCopyAddress">
              <view class="card-info-item-input" style="display: flex;flex-direction: column;justify-content: flex-end;align-items: flex-end;">
                <text style="font-size: 24rpx;">{{allRes[0].linkperson}} {{allRes[0].linkmobile}}</text>
                <text style="color: #666;font-size: 22rpx;">{{allRes[0].address}}</text>
                <text style="color: #2196f3;font-size: 24rpx;">复制</text>
              </view>
            </view>
          </view>
          <!-- 订单备注 -->
          <view class="card-info-item">
            <label>订单备注</label>
            <view class="card-info-item-input">
              <input placeholder="请输入订单备注" value="{{bak}}" data-item="bak" bindinput="handleAddressBindinput" />
            </view>
          </view>
        </view>
        <view class="card-footer">
          <view bindtap="handleSubmit">提交并支付</view>
        </view>
      </scroll-view>
    </block>
    <block wx:if="{{c_activeTab == 3}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight  + 50 + 60 +10)}}px;">
        <view style="margin: 10rpx auto;padding: 5rpx;">
          <!-- 表格标题行 -->
          <view style="display: flex; border-bottom: 1px solid #e0e0e0; padding: 12rpx 0; background-color: #f5f5f5;">
            <view style="flex: 2; text-align: center; font-weight: bold;font-size: 26rpx;">产品名称</view>
            <view style="flex: 3; text-align: center; font-weight: bold;font-size: 26rpx;">消费项目</view>
            <view style="flex: 1; text-align: center; font-weight: bold;font-size: 26rpx;">价格</view>
            <view style="flex: 1; text-align: center; font-weight: bold;font-size: 26rpx;">
              <checkbox checked="{{allChecked}}" bindtap="toggleAll" style="margin-left: 6rpx; transform: scale(0.8) " />
            </view>
          </view>

          <!-- 表格数据行 -->
          <view wx:for="{{tableData}}" wx:key="index" style="display: flex; border-bottom: 1px solid #eee; padding: 20rpx 0; align-items: center; background-color: {{index % 2 === 0 ? '#fff' : '#fafafa'}}">
            <!-- 产品名称 -->
            <view style="flex: 2; padding: 0 10rpx; text-align: center;font-size: 26rpx;">{{item.product}}</view>

            <!-- 消费项目 -->
            <view style="flex: 3; padding: 0 10rpx; text-align: center; color: #666;font-size: 26rpx;">{{item.item}}</view>

            <!-- 价格 -->
            <view style="flex: 1; padding: 0 10rpx; text-align: center; color: #e64340; font-weight: bold;font-size: 26rpx;">
              ￥{{item.price}}
            </view>

            <!-- 复选框 -->
            <view style="flex: 1; display: flex; justify-content: center;">
              <checkbox data-value="{{index}}" checked="{{item.checked}}" bindtap="toggleCheck" style="transform: scale(0.8);" />
            </view>
          </view>

          <!-- 底部操作栏 -->
          <view style="width: 96%; background: #fff; padding: 10rpx; display: flex; justify-content: flex-end; align-items: center;margin-top: 20rpx;">
            <view style="display: flex;align-items: center;gap: 20rpx;font-size: 28rpx;">
              <text>已选：{{selectedCount}}项</text>
              <text>总价: ￥{{priceTotal}}</text>
              <text bindtap="submit" style="background: #07c160;color: #fff;font-size: 26rpx;padding: 5rpx 20rpx;border-radius: 10rpx;">支付</text>
            </view>
          </view>
        </view>
      </scroll-view>

    </block>
  </view>
</view>
<!-- 地址选择 -->
<block>
  <view class="modal-mask" wx:if="{{c_select_address}}" bindtap="handleHideSengKeyModal"></view>
  <view class="modal-base-map" wx:if="{{c_select_address}}">
    <form bindsubmit="handleFormSubmit">
      <view class="modal-container">
        <view class="modal-container-head">
          <text>{{c_address_type=='door'?'上门取钥匙地址':'客户收货地址'}}</text>
          <image src="/assets/images/home/right_1.png" bindtap="handleHideSengKeyModal" />
        </view>
        <view class="modal-container-middle">
          <view class="middle-form-item">
            <label>联系人姓名 :</label>
            <view class="modal-form-region">
              <input placeholder="请输入联系人选姓名" name='personName' style="text-align: right;font-size: 28rpx;" />
            </view>
          </view>
          <view class="middle-form-item">
            <label>手机号码 :</label>
            <view class="modal-form-region">
              <input placeholder="请输入手机号码" name='mobile' style="text-align: right;font-size: 28rpx;" />
            </view>
          </view>
          <view class="middle-form-item">
            <label>所在地区 :</label>
            <view class="modal-form-region">
              <picker mode="region" bindchange="bindRegionChange" value="{{region}}" custom-item="{{customItem}}">
                <view class="picker" style="font-size: 28rpx;">
                  <text wx:if="{{region[0]}}"> {{region[0]}}，{{region[1]}}，{{region[2]}}</text>
                  <text wx:else>请选择地区</text>
                </view>
              </picker>
            </view>
          </view>
          <view class="middle-form-item">
            <label>详细地址 :</label>
            <view class="modal-form-region">
              <input placeholder="请输入详细地址" name='bak' style="text-align: right;font-size: 28rpx;" />
            </view>
          </view>
        </view>
        <view class="modal-container-footer">
          <button formType="submit">确认</button>
        </view>
      </view>
    </form>
  </view>
</block>
<view class="tabbar" style="height: {{tabBarHeight}}px;">
  <view class="tabbar-tab-item {{currentTab === index ? 'tabbar-active' : ''}}" wx:for="{{tabList}}" wx:key="index" bindtap="handleSwitchTabNavigation" data-index="{{index}}">
    <image src="{{'https://k1sw.wiselink.net.cn/img/' + item.selectedIconPath}}" class="tabbar-tab-icon" mode="widthFix" wx:if="{{currentTab === index}}" />
    <image src="{{'https://k1sw.wiselink.net.cn/img/' + item.iconPath}}" class="tabbar-tab-icon" mode="widthFix" wx:else />
    <text>{{item.text}}</text>
  </view>
</view>