<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">

  <!-- 自定义头部 -->
  <custom-header title="下单采购" />
  <view class="content-container" style="top:{{c_statusBarHeight + c_navBarHeight +2}}px; height: {{c_screen_height-(c_statusBarHeight + c_navBarHeight +2)}}px;">
    <view class="card-head">
      <image src="/assets/images/home/car_icon.png" />
      <text>下单采购</text>
    </view>
    <view class="card-info">
      <!-- 产品类别 -->
      <view class="card-info-item">
        <label>产品类别<text>*</text></label>
        <view class="card-info-item-input">
          <picker range-key="name" range="{{g_product_type_list}}" bindchange="handleCategory">
            <block wx:if="{{!g_product_type_index}}">
              <text>请选择类别</text>
            </block>
            <block wx:else>
              <text style="color: #333;">{{g_product_type_list[g_product_type_index].name}}</text>
            </block>
          </picker>
        </view>
      </view>
      <!-- 国家地区 -->
      <view class="card-info-item">
        <label>国家地区<text>*</text></label>
        <view class="card-info-item-input">
          <picker range-key="name" range="{{g_country_list}}" bindchange="handleCountry">
            <block wx:if="{{!g_country_index}}">
              <text>请选择国家</text>
            </block>
            <block wx:else>
              <text style="color: #333;">{{g_country_list[g_country_index].name}}</text>
            </block>
          </picker>
        </view>
      </view>
      <!-- 价格类型 -->
      <view class="card-info-item">
        <label>价格类型<text>*</text></label>
        <view class="card-info-item-input">
          <picker range-key="name" range="{{g_device_version_list}}" bindchange="handleDeviceVersion">
            <block wx:if="{{!g_device_version_index}}">
              <text>请选择硬件版本</text>
            </block>
            <block wx:else>
              <text style="color: #333;">{{g_device_version_list[g_device_version_index].name}}</text>
            </block>
          </picker>
        </view>
      </view>
      <!-- 销售代号 -->
      <view class="card-info-item" wx:if="{{g_product_type_index}}">
        <label>销售代号<text>*</text></label>
        <view class="card-info-item-input">
          <picker range-key="name" range="{{g_device_type_list}}" bindchange="handleDeviceType">
            <block wx:if="{{g_device_type_index==null}}">
              <text>请选择硬件版本</text>
            </block>
            <block wx:else>
              <text style="color: #333;">{{g_device_type_list[g_device_type_index].name}}</text>
            </block>
          </picker>
        </view>
      </view>
      <!-- 类别选择-开始 -->
      <block wx:if="{{g_device_type_list[g_device_type_index].id == 11}}">
        <view class="card-info-item">
          <label>录入方式</label>
          <view class="card-info-item-tabs">
            <view class="card-info-item-tabs-btn">
              <text class="{{c_entry_method==1?'tabs-active':''}}" data-item="1" bindtap="handleEntryMethod">手动输入</text>
              <text class="{{c_entry_method==2?'tabs-active':''}}" data-item="2" bindtap="handleEntryMethod">拍照上传</text>
            </view>
          </view>
        </view>
      </block>

      <view class="vehicle-card-info-item" wx:if="{{c_entry_method==1&&g_device_type_list[g_device_type_index].id == 11}}">
        <view class="vehicle-container-info">
          <scroll-view scroll-x class="tabs-scroll" scroll-left="{{scrollLeft}}" scroll-with-animation>
            <view class="tabs-container">
              <block wx:for="{{tabs}}" wx:key="id">
                <view class="tab-item {{currentIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="handleSwitchTab">
                  {{params['carmodel' + item.id]?params['carmodel' + item.id]:item.title}}
                  <view wx:if="{{tabs.length > 1}}" class="close" data-id="{{item.id}}" bindtap="hadnleCloseTab">×</view>
                </view>
              </block>
              <view class="add-btn" bindtap="hadnleAddTab">+</view>
            </view>
          </scroll-view>

          <view class="content">

            <block wx:for="{{tabs}}" wx:key="id">
              <view wx:if="{{currentIndex === index}}">
                <view class="card-info-item">
                  <label>车型<text>*</text></label>
                  <view class="card-info-item-input">
                    <input placeholder="请输入车型" value="{{ params['carmodel' + item.id] }}" data-item="{{'carmodel'+item.id}}" bindinput="handleBindinput" />
                  </view>
                </view>
                <view class="card-info-item">
                  <label>车系<text>*</text></label>
                  <view class="card-info-item-input">
                    <input placeholder="请输入车系" value="{{ params['carserial' + item.id] }}" data-item="{{'carserial'+item.id}}" bindinput="handleBindinput" />
                  </view>
                </view>
                <view class="card-info-item">
                  <label>年款<text>*</text></label>
                  <view class="card-info-item-input">
                    <input placeholder="请输入年款" value="{{ params['carversion' + item.id] }}" data-item="{{'carversion'+item.id}}" bindinput="handleBindinput" />
                  </view>
                </view>
                <view class="card-info-item">
                  <label>启动方式<text>*</text></label>
                  <view class="card-info-item-tabs">
                    <view class="card-info-item-tabs-btn">
                      <text class="{{params['runType' + item.id]  == '一键启动'?'tabs-active':''}}" data-id="{{item.id}}" data-item="一键启动" bindtap="handleBatterylift">一键启动</text>
                      <text class="{{params['runType' + item.id]  == '机械钥匙'?'tabs-active':''}}" data-id="{{item.id}}" data-item="机械钥匙" bindtap="handleBatterylift">机械钥匙</text>
                    </view>
                  </view>
                </view>
                <view class="card-info-item">
                  <label>车架号<text>*</text></label>
                  <view class="card-info-item-input">
                    <input placeholder="请输入车架号" value="{{ params['vin' + item.id] }}" data-item="{{'vin'+item.id}}" bindinput="handleBindinput" />
                  </view>
                </view>
              </view>
            </block>

          </view>
        </view>
      </view>
      <view class="card-info-item" wx:if="{{c_entry_method==2&&g_device_type_list[g_device_type_index].id == 11}}">
        <label style="font-size: 26rpx;">上传照片<text>*</text></label>
        <view class="card-info-item-input" style="display: flex; align-items: center;gap: 10rpx;">
          <text src="{{file}}" class="card-upload" wx:if="{{file}}" bindtap="previewImage">预览</text>
          <text class="card-upload" bindtap="chooseImage">{{file?'重新上传':'选择图片/拍照'}}</text>
        </view>
      </view>
      <!-- 类别选择-结束 -->
      <!-- 数量 -->
      <view class="card-info-item">
        <label>数量<text>*</text></label>
        <view class="card-info-item-input">
          <input type="number" placeholder="请输入数量" value="{{deviceCount}}" data-item="deviceCount" bindinput="handleNumBindinput" />
        </view>
      </view>
      <!-- 联系人 -->
      <view class="card-info-item">
        <label>收货信息<text>*</text></label>
        <view class="card-info-item-input" bindtap="handleSelectAddress">
          <view class="card-consignee">
            <block wx:if="{{snitems}}">
              <text>{{snitems.address}}</text>
              <view class="card-information">
                <text>{{snitems.linkperson}}</text>
                <text>{{snitems.linkmobile}}</text>
              </view>
            </block>
            <block wx:else>
              <view style="font-size: 26rpx; color: #7b7c7c;">请选择地址</view>
            </block>
          </view>
          <image src="/assets/images/home/right_1.png" style="width: 30rpx;height: 30rpx;" />
        </view>

      </view>
      <!-- 金额 -->
      <view class="card-info-item" wx:if="{{g_cost}}">
        <label>金额</label>
        <view class="card-info-item-input">
          <text style="font-weight: bold;color: red;">￥{{g_cost}}</text>
        </view>
      </view>
    </view>
    <view class="card-footer">
      <view bindtap="handleSubmit">确认提交</view>
    </view>
  </view>

</view>