<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">

  <!-- 自定义头部 -->
  <custom-header title="订单清单" />
  <!-- 内容区 -->
  <view class="info-container" style="height:{{c_screen_height-(c_statusBarHeight + c_navBarHeight)}}px;margin-top: {{c_totalNavHeight}}px;">

    <!-- 顶部卡片 -->
    <view class="top-box">
      <view class="content-item-head">
        <view class="head-left">
          <view class="left-category">
            <text>客户信息</text>
          </view>
        </view>
      </view>
      <view class="content-item-info">
        <view class="info-item  {{all_data.deviceCount.length > 15 ? 'long-info-item' : ''}}">
          <label>客户名称 ：</label>
          <text>{{all_data.deviceCount||'-'}}</text>
        </view>

        <view class="info-item  {{all_data.typeName.length > 15 ? 'long-info-item' : ''}}">
          <label>客户号 ：</label>
          <text>{{all_data.typeName||'-'}}</text>
        </view>
        <view class="info-item  {{all_data.linkman.length > 15 ? 'long-info-item' : ''}}">
          <label>联系人 ：</label>
          <text>{{all_data.linkman||'-'}}</text>
        </view>
        <view class="info-item  {{all_data.linkmobile.length > 15 ? 'long-info-item' : ''}}">
          <label>联系电话 ：</label>
          <text>{{all_data.linkmobile||'-'}}</text>
        </view>
      </view>
    </view>
    <!-- 中部 -->
    <view class="middle-box">
      <view class="content-item-head">
        <view class="head-left">
          <view class="left-category">
            <text>产品信息</text>
          </view>
        </view>
      </view>
      <view class="middle-content-item-info">
        <view class="info-item  {{all_data.productTypeName.length > 8 ? 'long-info-item' : ''}}">
          <label>产品类别 ：</label>
          <text>{{all_data.productTypeName||'-'}}</text>
        </view>
        <view class="info-item  {{all_data.deviceVersionName.length > 8 ? 'long-info-item' : ''}}">
          <label>价格类型 ：</label>
          <text>{{all_data.deviceVersionName||'-'}}</text>
        </view>
        <view class="info-item  {{all_data.countryName.length > 8 ? 'long-info-item' : ''}}">
          <label>国家地区 ：</label>
          <text>{{all_data.countryName||'-'}}</text>
        </view>
        <view class="info-item  {{all_data.deviceTypeName.length > 8 ? 'long-info-item' : ''}}">
          <label>销售代号 ：</label>
          <text>{{all_data.deviceTypeName||'-'}}</text>
        </view>
        <view class="info-item  {{all_data.deviceCount.length > 8 ? 'long-info-item' : ''}}">
          <label>数量 ：</label>
          <text>{{all_data.deviceCount||'-'}}</text>
        </view>
      </view>
      <scroll-view scroll-x class="tabs-scroll" scroll-with-animation scroll-left="{{scrollLeft}}" scroll-into-view="{{'tab' + currentIndex}}" style="height: 50px;">
        <view class="tabs-container">
          <block wx:for="{{all_data.orderCarList}}" wx:key="index">
            <view id="tab{{index}}" class="tab-item {{currentIndex === index ? 'active' : ''}}" bindtap="handleSwitchTab" data-index="{{index}}" style="height:50px">
              {{item.carmodel}}
            </view>
          </block>
        </view>
      </scroll-view>
      <scroll-view scroll-y class="content-scroll">
        <view class="middle-content-item-info">
          <view class="info-item  {{all_data.orderCarList[currentIndex].carmodel.length > 8 ? 'long-info-item' : ''}}">
            <label>车型 ：</label>
            <text>{{all_data.orderCarList[currentIndex].carmodel||'-'}}</text>
          </view>
          <view class="info-item  {{all_data.orderCarList[currentIndex].carserial.length > 8 ? 'long-info-item' : ''}}">
            <label>车系 ：</label>
            <text>{{all_data.orderCarList[currentIndex].carserial||'-'}}</text>
          </view>
          <view class="info-item  {{all_data.orderCarList[currentIndex].carversion.length > 8 ? 'long-info-item' : ''}}">
            <label>年款 ：</label>
            <text>{{all_data.orderCarList[currentIndex].carversion||'-'}}</text>
          </view>
          <view class="info-item  {{all_data.orderCarList[currentIndex].runtype.length > 8 ? 'long-info-item' : ''}}">
            <label>启动方式 ：</label>
            <text>{{all_data.orderCarList[currentIndex].runtype||'-'}}</text>
          </view>
          <view class="info-item  {{all_data.orderCarList[currentIndex].vin.length > 8 ? 'long-info-item' : ''}}">
            <label>车架号 ：</label>
            <text>{{all_data.orderCarList[currentIndex].vin||'-'}}</text>
          </view>
        </view>
      </scroll-view>

    </view>


    <!-- 底部卡片 -->
    <view class="bottom-box">
      <view class="content-item-head">
        <view class="head-left">
          <view class="left-category">
            <text>物流信息</text>
          </view>
        </view>
      </view>
      <view class="content-item-info">
        <view class="info-item  {{item.deviceCount.length > 15 ? 'long-info-item' : ''}}">
          <label>发货时间 ：</label>
          <text>{{item.deviceCount||'-'}}</text>
        </view>
        <view class="info-item  {{item.typeName.length > 15 ? 'long-info-item' : ''}}">
          <label>提交安装时间 ：</label>
          <text>{{item.typeName||'-'}}</text>
        </view>
        <view class="info-item  {{item.linkman.length > 15 ? 'long-info-item' : ''}}">
          <label>安装确认时间 ：</label>
          <text>{{item.linkman||'-'}}</text>
        </view>
        <view class="info-item  {{item.linkmobile.length > 15 ? 'long-info-item' : ''}}">
          <label>安装完毕时间 ：</label>
          <text>{{item.linkmobile||'-'}}</text>
        </view>
        <view class="info-item  {{all_data.linkaddress.length > 8 ? 'long-info-item' : ''}}">
          <label>收货地址 ：</label>
          <text>{{all_data.linkaddress||'-'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>