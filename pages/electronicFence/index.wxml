<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="电子围栏" />
  <!-- index.wxml -->
  <view class="record-container" style="height: {{c_screen_height-(navBarHeight + statusBarHeight)}}px;margin-top: {{navBarHeight + statusBarHeight}}px;">
    <!-- 切换部分 -->
    <view class="record-tabs" bindtap="handleSwitchTab">
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 1?s_background_tabs_active_1:s_background_tabs_1}}');">围栏列表</view>
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 2?s_background_tabs_2:s_background_tabs_active_2}}');">新增围栏</view>
    </view>
    <!-- 详情区域部分 -->
    <block wx:if="{{c_activeTab == 1}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
        <block wx:for="{{g_items}}" wx:key="index">
          <view class="content-item">
            <view class="content-item-head">
              <view class="head-left">
                <view class="left-category">
                  <text>{{item.realname}}<text style="font-size: 22rpx;padding: 4rpx; border-radius: 6rpx;background: #f0f0f0; color: #575656;margin-left: 20rpx;" wx:if="{{item.acquiescent}}">超级管理员</text></text>
                </view>
              </view>
              <view class="head-right">
                <image src="/assets/images/home/_see.png" data-item="{{item}}" bindtap="handleEdit" />
                <image src="/assets/images/home/_edit.png" data-item="{{item}}" bindtap="handleEdit" />
                <image src="/assets/images/home/_delete.png" data-id="{{item.id}}" bindtap="handleDelete" />
              </view>
            </view>
            <view class="content-item-info">
              <view class="info-item  {{item.username.length > 15 ? 'long-info-item' : ''}}">
                <label>账号 ：</label>
                <text>{{item.username||'-'}}</text>
              </view>
              <view class="info-item  {{item.roleName.length > 15 ? 'long-info-item' : ''}}">
                <label>角色 ：</label>
                <text>{{item.roleName||'-'}}</text>
              </view>
              <view class="info-item  {{item.mobile.length > 15 ? 'long-info-item' : ''}}">
                <label>手机号 ：</label>
                <text>{{item.mobile||'-'}}</text>
              </view>
            </view>
          </view>
        </block>
      </scroll-view>
    </block>
    <block wx:if="{{c_activeTab == 2}}">
      <block wx:if="{{1==2}}">
        <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;">
          <view class="card-info">
            <!-- 围栏名称 -->
            <view class="card-info-item">
              <label>围栏名称<text>*</text></label>
              <block>
                <view class="card-info-item-input">
                  <input placeholder="请输入围栏名称" value="{{params.platenumber}}" data-item="platenumber" bindinput="handleBindinput" />
                </view>
              </block>
            </view>
            <!-- 监控开始时间 -->
            <view class="card-info-item">
              <label>监控开始时间<text>*</text></label>
              <block>
                <view class="card-info-item-input" style="display: flex;gap: 20rpx;">
                  <picker mode="date" data-index="startDate" bindchange="bindTimeChange">
                    <view class="form-item-text">
                      <text>{{startDate}}</text>
                    </view>
                  </picker>
                  <picker mode="time" data-index="startTime" bindchange="bindTimeChange">
                    <view class="form-item-text">
                      <text>{{startTime}}</text>
                    </view>
                  </picker>
                </view>
              </block>
            </view>
            <!-- 监控结束时间 -->
            <view class="card-info-item">
              <label>监控结束时间<text>*</text></label>
              <block>
                <block>
                  <view class="card-info-item-input" style="display: flex;gap: 20rpx;">
                    <picker mode="date" data-index="endDate" bindchange="bindTimeChange">
                      <view class="form-item-text">
                        <text>{{endDate}}</text>
                      </view>
                    </picker>
                    <picker mode="time" data-index="endTime" bindchange="bindTimeChange">
                      <view class="form-item-text">
                        <text>{{endTime}}</text>
                      </view>
                    </picker>
                  </view>
                </block>
              </block>

            </view>
            <!-- 控制类型 -->
            <view class="card-info-item">
              <label>控制类型<text>*</text></label>
              <block>
                <view class="card-info-item-tabs">
                  <view class="card-info-item-tabs-btn">
                    <text class="{{batterylift == '一键启动'?'tabs-active':''}}" data-item="一键启动" bindtap="handleBatterylift">禁止驶入</text>
                    <text class="{{batterylift == '其他'?'tabs-active':''}}" data-item="其他" bindtap="handleBatterylift">禁止驶出</text>
                  </view>
                </view>
              </block>

            </view>
          </view>
          <view class="card-footer">
            <view bindtap="handleSubmit">确认{{btnState}}</view>
          </view>
        </scroll-view>
      </block>

      <block wx:else>
        <map id="map" longitude="{{longitude}}" latitude="{{latitude}}" scale="16" show-location polygons="{{polygons}}" markers="{{markers}}" bindtap="onMapTap" style="width: 100%; min-height: 80%;">
          <view class="map-bottom-buttons">
            <text class="map-button" bindtap="handleEliminate">清除上一步</text>
            <text class="map-button" bindtap="handleClear">清空</text>
          </view>
        </map>
        <view class="confirm-container">
          <text class="confirm-button" bindtap="handleSumit">确定</text>
        </view>
      </block>
    </block>
  </view>
</view>




