<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="电子围栏" />
  <!-- index.wxml -->
  <view class="record-container" style="height: {{c_screen_height-(navBarHeight + statusBarHeight)}}px;margin-top: {{navBarHeight + statusBarHeight}}px;">
    <!-- 切换部分 -->
    <view class="record-tabs" bindtap="handleSwitchTab">
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 1?s_background_tabs_active_1:s_background_tabs_1}}');">围栏列表</view>
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 2?s_background_tabs_2:s_background_tabs_active_2}}');">新增围栏</view>
    </view>
    <!-- 详情区域部分 -->
    <block wx:if="{{c_activeTab == 1}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
        <block wx:for="{{g_items}}" wx:key="index">
          <view class="content-item">
            <view class="content-item-head">
              <view class="head-left">
                <view class="left-category">
                  <text>{{item.efencename}}<text style="font-size: 22rpx;padding: 4rpx; border-radius: 6rpx;background: #f0f0f0; color: #575656;margin-left: 20rpx;" wx:if="{{item.acquiescent}}">超级管理员</text></text>
                </view>
              </view>
              <view class="head-right">
                <!-- <image src="/assets/images/home/_see.png" data-item="{{item}}" bindtap="handleEdit" /> -->
                <image src="/assets/images/home/_edit.png" data-item="{{item}}" bindtap="handleEdit" />
                <image src="/assets/images/home/_delete.png" data-id="{{item.id}}" bindtap="handleDelete" />
              </view>
            </view>
            <view class="content-item-info">
              <view class="info-item  {{item.username.length > 15 ? 'long-info-item' : ''}}">
                <label>报警类型 ：</label>
                <text>{{item.alarmtype == 0?'全部':(item.alarmtype ==1?'入区报警':'出区报警')}}</text>
              </view>
              <view class="info-item  {{item.roleName.length > 15 ? 'long-info-item' : ''}}">
                <label>状态 ：</label>
                <text>{{item.isEnableName}}</text>
              </view>
              <view class="info-item  long-info-item">
                <label>生效时间 ：</label>
                <text>{{item.startdate||'00:00'}} - {{item.enddate||'00:00'}}</text>
              </view>
              <view class="info-item long-info-item">
                <label>绑定车辆 </label>
                <block wx:for="{{item.vehList}}" wx:key="index" wx:for-item="g_item">
                  <view style="display: flex;gap: 20rpx;">
                    <text>{{g_item.plateNumber}}</text>
                    <text style="color: cornflowerblue;" bindtap="handleUnbind" data-item="{{item}}" data-gitem="{{g_item}}">解绑</text>
                  </view>
                </block>
              </view>
            </view>
            <view class="content-item-footer">
              <view class="footer-left"></view>
              <view class="footer-right" style="display: flex;gap: 10rpx;">
                <view class="footer-right-btn" data-item="{{item}}" bindtap="handleSwitchChange">
                  <text>{{item.isenable == 1?'停用':'启用'}}</text>
                </view>
                <view class="footer-right-btn" data-item="{{item}}" bindtap="handleSelectJump">
                  <text>绑定车辆</text>
                </view>
                <view class="footer-right-btn" data-item="{{item}}" bindtap="handleUnbindAll">
                  <text>全部解绑</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </scroll-view>
    </block>
    <block wx:if="{{c_activeTab == 2}}">
      <block wx:if="{{add_type==1}}">
        <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;">
          <view class="card-info">
            <!-- 围栏名称 -->
            <view class="card-info-item">
              <label>围栏名称<text>*</text></label>
              <block>
                <view class="card-info-item-input">
                  <input placeholder="请输入围栏名称" value="{{params.efencename}}" data-item="efencename" bindinput="handleBindinput" />
                </view>
              </block>
            </view>
            <!-- 监控开始时间 -->
            <view class="card-info-item">
              <label>监控开始时间<text>*</text></label>
              <block>
                <view class="card-info-item-input" style="display: flex;gap: 20rpx;">
                  <picker mode="time" data-index="startdate" bindchange="bindTimeChange">
                    <view class="form-item-text">
                      <text>{{startdate}}</text>
                    </view>
                  </picker>
                </view>
              </block>
            </view>
            <!-- 监控结束时间 -->
            <view class="card-info-item">
              <label>监控结束时间<text>*</text></label>
              <block>
                <block>
                  <view class="card-info-item-input" style="display: flex;gap: 20rpx;">
                    <picker mode="time" data-index="enddate" bindchange="bindTimeChange">
                      <view class="form-item-text">
                        <text>{{enddate}}</text>
                      </view>
                    </picker>
                  </view>
                </block>
              </block>
            </view>
            <!-- 控制类型 -->
            <view class="card-info-item">
              <label>报警类型<text>*</text></label>
              <block>
                <view class="card-info-item-tabs">
                  <view class="card-info-item-tabs-btn">
                    <text class="{{batterylift == 0?'tabs-active':''}}" data-item="0" bindtap="handleBatterylift">全部</text>
                    <text class="{{batterylift == 1?'tabs-active':''}}" data-item="1" bindtap="handleBatterylift">入区报警</text>
                    <text class="{{batterylift == '2'?'tabs-active':''}}" data-item="2" bindtap="handleBatterylift">出区报警</text>
                  </view>
                </view>
              </block>
            </view>
          </view>
          <view class="card-footer">
            <view bindtap="handleSubmit">下一步</view>
          </view>
        </scroll-view>
      </block>

      <block wx:else>
        <view class="map-container-bar">
          <view class="map-left-group">

            <picker class="map-button" mode="multiSelector" range="{{multiArray}}" bindchange="bindMultiPickerChange" bindcolumnchange="bindMultiPickerColumnChange" value="{{multiIndex}}">
              <view>
                {{province_temp||'请选择省市'}}{{province_temp}}
                <!-- {{multiArray[0][multiIndex[0]]||'请选择省市'}}{{multiArray[1][multiIndex[1]]}} -->
              </view>
            </picker>

            <text bindtap="handleMapType" data-item="1" class="map-button" style="color: {{map_type==1?'#fff':'#333'}};background: {{map_type == 1?'cornflowerblue':''}};">圆形</text>
          </view>
          <view class="map-right-group">
            <picker bindchange="handlePickerChangeRadius" value="{{radius_array_index}}" range="{{radius_array}}" wx:if="{{map_type==1}}">
              <view class="picker map-picker">
                <text>围栏半径:{{radius_array[radius_array_index]}}米</text>
                <image src="/assets/images/home/down.png" />
              </view>
            </picker>
            <text class="map-submit" bindtap="handleSumit">保存</text>
          </view>
        </view>
        <block wx:if="{{map_type == 3}}">
          <map id="map" longitude="{{longitude}}" latitude="{{latitude}}" scale="6" show-location polygons="{{polygons}}" style="width: 100%;height: {{c_screen_height-statusBarHeight -100-50-navBarHeight}}px;">
            <view class="map-bottom-buttons">
              <text class="map-button" bindtap="handleClear">清空</text>
            </view>
          </map>
        </block>
        <block wx:else>
          <map id="myMap" style="width: 100%;height: {{c_screen_height-statusBarHeight -100-50-navBarHeight}}px;" show-location longitude="{{longitude}}" latitude="{{latitude}}" scale="{{scale}}" circles="{{circles}}" bindtap="handleMapTap">
          </map>
        </block>
      </block>
    </block>
  </view>
</view>