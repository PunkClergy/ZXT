<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="车辆清单" />
  <!-- index.wxml -->
  <view class="record-container" style="height: {{c_screen_height-(navBarHeight + statusBarHeight)}}px;margin-top: {{navBarHeight + statusBarHeight}}px;">
    <!-- 切换部分 -->
    <view class="record-tabs" bindtap="handleSwitchTab">
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 1?s_background_tabs_active_1:s_background_tabs_1}}');">车辆列表</view>
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 2?s_background_tabs_2:s_background_tabs_active_2}}');">{{btnState}}车辆</view>
    </view>
    <!-- 详情区域部分 -->
    <block wx:if="{{c_activeTab == 1}}">
      <view class="record-tabs-1" style="display: flex;flex-direction: column;">
        <view class="search-box">
          <icon type="search" size="16" class="search-icon" />
          <input placeholder="车牌号/设备号/车型/车系" class="search-input" bindblur="bindblurSea" />
        </view>

      </view>
      <view class="tabs-1-conut" style="display: flex;justify-content: {{g_flagMulti&&'space-between'}};">
        <view></view>
        <view>共有{{g_total}}条记录</view>
        <view style="display: flex;align-items: center;flex-direction: row;justify-content: center;gap: 10rpx;" wx:if="{{g_flagMulti}}">
          <view style="font-size: 24rpx;">全选</view>
          <checkbox style="transform: scale(0.9);" bindtap="handleAllC" checked="{{all_c}}"></checkbox>
        </view>
      </view>
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
        <block wx:for="{{g_items}}" wx:key="index">
          <view class="content-item">
            <view class="content-item-head">
              <view class="head-left">
                <view class="left-category">
                  <image src="/assets/images/home/car_icon.png" />
                  <text>{{item.platenumber}}</text>
                </view>
                <view class="left-split_line"></view>
                <view class="left-model">
                  {{item.vehicleSerialName||'-'}}{{item.vehicleModeName||''}}
                </view>
              </view>
              <view class="head-right" wx:if="{{!(g_flagMulti)}}">
                <image src="/assets/images/home/_edit.png" data-item="{{item}}" bindtap="handleEdit" />
                <image src="/assets/images/home/_delete.png" data-item="{{item}}" bindtap="handleDelete" />
              </view>
              <view wx:else>
                <checkbox-group data-item="{{item}}" bindchange="handleChangeBlack">
                  <checkbox class="custom-checkbox" style="transform: scale(1);" checked="{{item.checked}}" />
                </checkbox-group>
                <!-- <checkbox-group data-item="{{item}}" bindchange="handleChangeBlack">
                  <checkbox style="transform: scale(1);" checked="{{item.checked}}" />
                </checkbox-group> -->
              </view>
            </view>
            <view class="content-item-info">
              <view class="info-item  {{item.sn.length > 15 ? 'long-info-item' : ''}}">
                <label>设备号 ：</label>
                <text>{{item.sn||'-'}}</text>
              </view>
              <view class="info-item long-info-item">
                <label>生效周期 ：</label>
                <text>{{item.startDate||''}}-{{item.endDate||''}}</text>
              </view>
            </view>
            <view class="content-item-footer" wx:if="{{g_source}}">
              <view class="footer-left"></view>
              <view class="footer-right">
                <view class="footer-right-btn" data-item="{{item}}" bindtap="handleSelectJump" wx:if="{{!g_flagMulti}}">
                  <text>选择此车</text>
                </view>
                <view wx:else>
                  <!-- <checkbox-group data-item="{{item}}" bindchange="handleChangeBlack">
                    <checkbox style="transform: scale(0.7);" checked="{{item.checked}}" />
                  </checkbox-group> -->
                </view>
              </view>
            </view>
          </view>
        </block>

      </scroll-view>
    </block>
    <block wx:if="{{c_activeTab == 2}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;">

        <view class="card-info">
          <!-- 车牌号 -->
          <view class="card-info-item">
            <label>车牌号<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入车牌号" value="{{params.platenumber}}" data-item="platenumber" bindinput="handleBindinput" />
              </view>
            </block>

          </view>
          <!-- 设备号 -->
          <view class="card-info-item">
            <label>设备号(sn)<text>*</text></label>
            <block>
              <view class="card-info-item-input" style="display: flex;flex-direction: row;align-items: center;">
                <block wx:if="{{id!=''}}">
                  <text wx:if="{{id!=''}}" style="font-size: 26rpx;">{{params.sn||'空'}}</text>
                </block>
                <block wx:else>
                  <input placeholder="请输入设备号" value="{{params.sn}}" data-item="sn" bindinput="handleBindinput" />
                  <image src="/assets/images/ss.png" mode="" bindtap="scanCode" style="width: 50rpx;height: 50rpx;" />
                </block>

              </view>
            </block>
          </view>
          <view class="card-info-item">
            <label>code<text>*</text></label>
            <block>
              <view class="card-info-item-input" style="display: flex;flex-direction: row;align-items: center;">
                <text wx:if="{{id!=''}}" style="font-size: 26rpx;">{{params.code||'空'}}</text>
                <input wx:else placeholder="请输入code" value="{{params.code}}" data-item="code" bindinput="handleBindinput" />
              </view>
            </block>
          </view>
          <!-- 车系 -->
          <view class="card-info-item">
            <label>车系</label>

            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入车系" value="{{params.vehicleSerialName}}" data-item="vehicleSerialName" bindinput="handleBindinput" />
              </view>
            </block>


          </view>
          <!-- 车型 -->
          <view class="card-info-item">
            <label>车型</label>

            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入车型" value="{{params.vehicleModeName}}" data-item="vehicleModeName" bindinput="handleBindinput" />
              </view>
            </block>
          </view>
          <!-- 年款 -->
          <view class="card-info-item">
            <label>年款</label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入年款" value="{{params.ccdate}}" data-item="ccdate" bindinput="handleBindinput" />
              </view>
            </block>
          </view>

          <!-- 车架号 -->
          <view class="card-info-item" wx:if="{{(!params.initMileage)||params.initMileage<1}}">
            <label>初始化里程(km)</label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入车辆当前里程" value="{{params.initMileage}}" data-item="initMileage" bindinput="handleBindinput" />
              </view>
            </block>

          </view>
          <!-- 油箱容积 -->
          <view class="card-info-item">
            <label>保养周期里程(km)</label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入车辆保养周期里程" value="{{params.maintainMileageInterval}}" data-item="maintainMileageInterval" bindinput="handleBindinput" />
              </view>
            </block>

          </view>
          <!-- 启动方式 -->
        </view>
        <view class="card-footer">
          <view bindtap="handleSubmit">确认{{btnState}}</view>
        </view>
      </scroll-view>
    </block>
  </view>
  <view class="levitation-button" wx:if="{{c_activeTab==1&&g_flagMulti&&g_black.length>0}}" bindtap="handleJumpBlackInfo">
    <text>确定</text>
  </view>
</view>