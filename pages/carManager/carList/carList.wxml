<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <!-- 自定义头部 -->
  <view class="custom-navbar" style="height:{{c_totalNavHeight}}px;">
    <view class="status-bar" style="height:{{c_statusBarHeight}}px;"></view>
    <view class="nav-bar" style="height:{{c_navBarHeight}}px;">
      <view class="title-container">
        <image src="/assets/images/home/left.png" bindtap="handleJumpBack" />
        <text class="title">车辆管理</text>
      </view>
    </view>
  </view>

  <!-- 搜索框 -->
  <view class="search-container" style="height:{{c_searchBarHeight}}px;margin-top: {{c_totalNavHeight}}px;">
    <view class="search-box">
      <icon type="search" size="16" class="search-icon" />
      <input placeholder="搜索车牌号/VIN/设备号" bindblur="handleBlur" class="search-input" />
    </view>
    <view class="search-count">
      <text>共有{{g_total}}辆车</text>
    </view>
  </view>

  <!-- 主要内容区域 -->
  <scroll-view class="content-container" scroll-y="true" style="top:{{c_statusBarHeight + c_navBarHeight + c_searchBarHeight+2}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
    <block wx:for="{{g_items}}" wx:key="index">
      <view class="content-item">
        <view class="content-item-head">
          <view class="head-left">
            <view class="left-category">
              <image src="/assets/images/home/car_icon.png" />
              <text>{{item.platenumber}}</text>
            </view>
            <view class="left-split_line"></view>
            <view class="left-model">
              {{item.vehicleSerialName||'-'}}{{item.vehicleModeName||''}}
            </view>
            <view class="left-brand">
              短租
            </view>
          </view>
          <view class="head-right">
            <image src="/assets/images/home/_see.png" data-item="{{item}}" bindtap="handleView" />
            <image src="/assets/images/home/_edit.png" data-item="{{item}}" bindtap="handleEdit" />
            <image wx:if="{{!item.sn}}" src="/assets/images/home/_delete.png" data-item="{{item}}" bindtap="handleDelete" />
          </view>
        </view>
        <view class="content-item-info">
          <view class="info-item  {{item.vin.length > 15 ? 'long-info-item' : ''}}">
            <label>车架号 ：</label>
            <text>{{item.vin||'-'}}</text>
          </view>
          <view class="info-item  {{item.xsgw.length > 15 ? 'long-info-item' : ''}}">
            <label>油箱容积 ：</label>
            <text>{{item.xsgw?item.xsgw+'L':'-' }}</text>
          </view>
          <view class="info-item">
            <label>车辆类型 ：</label>
            <text>{{item.sn?'自助取还':'非自助取还'}}</text>
          </view>
          <view class="info-item  {{item.carOwnerName.length > 15 ? 'long-info-item' : ''}}">
            <label>设备平台 ：</label>
            <text>{{item.carOwnerName||'-'}}</text>
          </view>
          <view class="info-item  {{item.sn.length > 15 ? 'long-info-item' : ''}}">
            <label>设备号 ：</label>
            <text>{{item.sn||'-'}}</text>
          </view>

        </view>
        <view class="content-item-footer" wx:if="{{g_source}}">
          <view class="footer-left"></view>
          <view class="footer-right">
            <view class="footer-right-btn" data-item="{{item}}" bindtap="handleSelectJump" wx:if="{{!g_flagMulti}}">
              <text>选择此车</text>
            </view>
            <view wx:else>
              <checkbox-group data-item="{{item}}" bindchange="handleChangeBlack">
                <checkbox style="transform: scale(0.7);" />
              </checkbox-group>
            </view>
          </view>
        </view>
      </view>
    </block>
  </scroll-view>

  <!-- 一键操作按钮 -->
  <view class="levitation-button" wx:if="{{!g_source}}" bindtap="handleJumpInfo">
    <text>新增车辆</text>
  </view>
  <view class="levitation-button" wx:if="{{g_flagMulti&&g_black.length>0}}" bindtap="handleJumpBlackInfo">
    <text>确定</text>
  </view>
</view>