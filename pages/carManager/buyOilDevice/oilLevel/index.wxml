<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <!-- 自定义头部 -->
  <custom-header title="购买和充值" />
  <!-- 筛选部分 -->
  <view class="search-container" style="height:{{c_searchBarHeight+40}}px;margin-top: {{c_totalNavHeight}}px;">
    <view class="search-box">
      <icon type="search" size="16" class="search-icon" />
      <input placeholder="搜索收货人/电话/收货地址" bindblur="handleBlur" class="search-input" />
    </view>
    <view class="search-drop">
      <block wx:for="{{filter_aggregate}}" wx:key="index">
        <drop-filter-com data-id="{{item.id}}" range="{{item.filter_work}}" filter="{{item.name}}" bindTransmit="bindPickerChange" />
      </block>
      <image class="search-box-date" src="/assets/images/home/date.png" bindtap="handleShowMask"/>
    </view>
    <view class="search-count">
      <text>共有{{g_total}}个工单</text>
    </view>
  </view>
    <!-- 主要内容区域 -->
    <scroll-view class="content-container" scroll-y="true" style="top:{{c_statusBarHeight + c_navBarHeight + c_searchBarHeight+40}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
    <block wx:for="{{g_items}}" wx:key="index" wx:for-item="item">
      <view class="content-item">
        <view class="content-item-head">
          <view class="head-left">
            <view class="left-category">
              <image src="/assets/images/home/01.png" />
              <text>{{item.ordertypename}}</text>
            </view>
            <view class="left-brand">
              {{item.platenumber}}
            </view>
            <view class="left-model">
              {{item.vehicleSerialName||'-'}}{{item.vehicleModeName||''}}
            </view>
          </view>
          <view class="head-right">
            <view class="right-special-state" wx:if="{{item.timeout==1}}">超时</view>
            <view class="right-state">
              <view class="right-state">
                <block wx:key="type" wx:for="{{c_status}}" wx:for-item="statusItem">
                  <block wx:if="{{item.status == statusItem.status}}">
                    <text class="{{statusItem.colorClass}}">{{statusItem.text}}</text>
                  </block>
                </block>
              </view>
            </view>
          </view>
        </view>
        <view class="content-item-info">
          <view class="info-item  {{item.createdate.length > 15 ? 'long-info-item' : ''}}">
            <label>下单时间 ：</label>
            <text>{{item.createdate||'-'}}</text>
          </view>

          <view class="info-item  {{item.ispatchtype.length > 15 ? 'long-info-item' : ''}}">
            <label>派单方式 ：</label>
            <text>{{item.ispatchtype||'-'}}</text>
          </view>

          <view class="info-item  {{item.carmanagername.length > 15 ? 'long-info-item' : ''}}">
            <label>车务人员 ：</label>
            <text>{{item.carmanagername||'-'}}</text>
          </view>
        </view>
        <view class="content-item-footer">
          <view class="footer-left">要求完成时间: {{item.finishdate||'-'}}</view>
          <view class="footer-right">
            <block wx:if="{{item.paystatus != 1}}">待支付</block>
            {{item.cost !== null ? '￥' + item.cost : (item.paystatus == 1 ? '' : '待协商')}}
          </view>
        </view>
      </view>
    </block>
  </scroll-view>
</view>
