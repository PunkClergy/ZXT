<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="余额明细" />
  <!-- index.wxml -->
  <view class="record-container" style="height: {{c_screen_height-(navBarHeight + statusBarHeight)}}px;margin-top: {{navBarHeight + statusBarHeight}}px;">
    <!-- 切换部分 -->
    <view class="record-tabs" bindtap="handleSwitchTab">
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 1?s_background_tabs_active_1:s_background_tabs_1}}');">充值记录</view>
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 2?s_background_tabs_2:s_background_tabs_active_2}}');">充值</view>
    </view>
    <!-- 详情区域部分 -->
    <block wx:if="{{c_activeTab == 1}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
        <block wx:for="{{g_items}}" wx:key="index">
          <view class="content-item">
            <view class="content-item-head">
              <view class="head-left">
                <view class="left-category">
                  <text>充值</text>
                </view>
              </view>
              <view class="head-right">
                <view class="right-state"> {{item.paydate}}</view>
              </view>
            </view>
            <view class="content-item-info">
              <view class="info-item  {{item.wxpayorder.length > 15 ? 'long-info-item' : ''}}">
                <label>充值单号 ：</label>
                <text>{{item.wxpayorder||'-'}}</text>
              </view>
              <view class="info-item  {{item.selfpayorder.length > 15 ? 'long-info-item' : ''}}">
                <label>支付单号 ：</label>
                <text>{{item.selfpayorder||'-'}}</text>
              </view>
            </view>
          </view>
        </block>
      </scroll-view>
    </block>
    <block wx:if="{{c_activeTab == 2}}">
      <view class="recharge-page">
  <!-- 充值面额区 -->
  <view class="various-denom">
    <text class="various-denom-title">余额充值</text>
    <view class="various-denom-list">
      <view class="various-denom-item {{index ==selected?'active':'' }}" data-value="{{item.value}}" wx:for="{{amounts}}" wx:key="id" data-index="{{index}}" bindtap="handleVarious">
        <text>{{item.label}}</text>
      </view>
    </view>
    <view class="various-denom-custom {{selected == 'custom'?'active':''}}" bindtap="handleCustom">
      <text>自定义面额</text>
    </view>
    <view class="various-denom-custom-num" wx:if="{{selected == 'custom'}}">
      <input placeholder="请输入充值金额" bindinput="handleCustomBlur"/>
    </view>
  </view>

  <view class="recharge-amount-total">
    <view class="recharge-amount-title">合计</view>
    <view class="recharge-amount-num">{{amount}}元</view>
  </view>
  <view class="recharge-btn" bindtap="handlePayment">
    <text>充值 </text>
  </view>
</view>
    </block>
  </view>

</view>