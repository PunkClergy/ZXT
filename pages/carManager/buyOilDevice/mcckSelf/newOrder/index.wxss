.container {
  width: 100%;
  height: 95vh;
  display: flex;
  flex-direction: column;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  touch-action: pan-x;
  position: relative;
}
.main-container {
  position: absolute;
  bottom: 10rpx;
  width: 96%;
  margin: auto;
  border-radius: 10rpx;
  left: 0;
  right: 0;
  overflow-y: auto;
  background-color: #fff;
  border: 1px solid #f0f0f0;
}
/* 头部 */
.main-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  border-bottom: 1px solid #f0f0f0;
  padding: 0rpx 15rpx;
}
/* 头部左侧 */
.main-head-left-category {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.main-head-left-category image {
  width: 43rpx;
  height: 35rpx;
}
.main-head-left-category text {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #333333;
}
/* 头部右侧 */
.main-head-right-category {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.main-head-right-category image {
  width: 35rpx;
  height: 35rpx;
}
/* 内容区域 */
.main-central-scroll-view {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.main-central-layar {
  border: 1px solid #f0f0f0;
}
.main-central-layar-info {
  font-size: 26rpx;
  color: #333333;
  margin: 20rpx 10rpx;
}
.vehicle-main {
  width: 95%;
  margin: auto;
  box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  padding: 10rpx;
  gap: 20rpx;
  border: 1px solid #f0f0f0;
}
.vehicle-main-info {
  flex-basis: 100% !important;
  box-sizing: border-box;
  word-wrap: break-word;
  transition: all 0.3s;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #333333;
}

