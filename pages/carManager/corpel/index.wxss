.container {
  width: 100%;
  height: 95vh;
  display: flex;
  flex-direction: column;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  touch-action: pan-x;
  position: relative;
}

/* 自定义头部容器 */
.custom-navbar {
  width: 100%;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
}

/* 状态栏占位符 */
.status-bar {
  width: 100%;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 16px;
  box-sizing: border-box;
}

/* 标题容器 */
.title-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 100%;
}

.title-container image {
  width: 40rpx;
  height: 40rpx;
}

/* 标题文本 */
.title {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 33rpx;
  color: #010101;
  line-height: 30rpx;
}

/* 主要内容容器 */
.content-container {
  position: absolute;
  bottom: 10rpx;
  left: 0;
  right: 0;
  overflow-y: auto;
}

/* 内容项 */
.content-item {
  margin: 15rpx;
  background-color: #ffffff;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.content-item-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  border-bottom: 1px solid #f0f0f0;
  padding: 20rpx 15rpx;
}

.head-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.left-category {
  display: flex;
  align-items: center;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #333333;
  gap: 10rpx;
}

.left-model {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #333333;
}

.content-item-info {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  padding: 10rpx;
  gap: 20rpx;
  border-bottom: 1px solid #f0f0f0;
}

.info-item {
  flex: 0 0 48%;
  box-sizing: border-box;
  word-wrap: break-word;
  transition: all 0.3s;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #333333;
}

.long-info-item {
  flex-basis: 100% !important;
}

.content-item-footer {
  display: flex;
  padding: 15rpx;
  justify-content: space-between;
}

.footer-right {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.footer-right-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 22rpx;
  color: #ffffff;
  background-color: #1B64B1;
  border-radius: 8rpx;
  padding: 4rpx 15rpx;
}

.pop-car-text {
  color: #1B64B1;
  margin-left: 10rpx;
}

/* 弹窗通用样式 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.popup-wrap {
  width: 85%;
  max-height: 75vh;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.popup-header {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}
.popup-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.popup-close {
  font-size: 40rpx;
  color: #999;
}
.popup-scroll {
  width: 90%;
  flex: 1;
  padding: 0 30rpx;
  overflow-y: auto;
}
.scroll-bottom-placeholder {
  height: 140rpx;
  width: 100%;
}
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: #999;
}
.popup-bottom {
  flex-shrink: 0;
  padding: 25rpx 30rpx;
  padding-bottom: calc(25rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee;
}

/* 查看弹窗车辆条目 */
.car-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.plate {
  font-size: 28rpx;
  color: #333;
}
.unbind-btn {
  font-size: 24rpx;
  color: #d9534f;
  padding: 6rpx 16rpx;
  border: 1rpx solid #d9534f;
  border-radius: 6rpx;
  flex-shrink: 0;
}
.unbind-all-btn {
  width: 100%;
  text-align: center;
  background: #d9534f;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-radius: 10rpx;
}

/* 绑定弹窗复选框 */
.car-check-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 20rpx;
}
.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 1rpx solid #ccc;
  border-radius: 6rpx;
  flex-shrink: 0;
  position: relative;
}
.checkbox.checked {
  background: #1B64B1;
  border-color: #1B64B1;
}
.checkbox.checked::after {
  content: "✓";
  color: #fff;
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 24rpx;
}
.bind-confirm-btn {
  width: 100%;
  text-align: center;
  background: #1B64B1;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-radius: 10rpx;
}