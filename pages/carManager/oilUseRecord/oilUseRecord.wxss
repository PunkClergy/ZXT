/* pages/order/orderList.wxss */
page {
    background-color: var(--weui-BG-0);
      height: 100%;
    }
  .bg-img {
    width: 100%;
    height: 100%;
    position: fixed;
  }
  .giftListView {
    width: 100%;
    bottom: 0;
    top: 0rpx;
    /* background-color: red; */
    position: absolute;
  
  }
  /* cell */
  .item {
