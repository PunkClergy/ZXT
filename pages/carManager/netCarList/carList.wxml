<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="车辆清单" />
  <!-- index.wxml -->
  <view class="record-container" style="height: {{c_screen_height-(navBarHeight + statusBarHeight)}}px;margin-top: {{navBarHeight + statusBarHeight}}px;">
    <!-- 切换部分 -->
    <view class="record-tabs" bindtap="handleSwitchTab">
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 1?s_background_tabs_active_1:s_background_tabs_1}}');">车辆列表</view>
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 2?s_background_tabs_2:s_background_tabs_active_2}}');">{{btnState}}车辆</view>
    </view>
    <!-- 详情区域部分 -->
    <block wx:if="{{c_activeTab == 1}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
        <block wx:for="{{g_items}}" wx:key="index">
          <view class="content-item">
            <view class="content-item-head">
              <view class="head-left">
                <view class="left-category">
                  <image src="/assets/images/home/car_icon.png" />
                  <text>{{item.platenumber}}</text>
                </view>
                <view class="left-split_line"></view>
                <view class="left-model">
                  {{item.vehicleSerialName||'-'}}{{item.vehicleModeName||''}}
                </view>
              </view>
              <view class="head-right" wx:if="{{!(g_flagMulti)}}">
                <image src="/assets/images/home/_edit.png" data-item="{{item}}" bindtap="handleEdit" />
              </view>
            </view>
            <view class="content-item-info">
              <view class="info-item  {{item.vin.length > 15 ? 'long-info-item' : ''}}">
                <label>车架号 ：</label>
                <text>{{item.vin||'-'}}</text>
              </view>
              <view class="info-item  {{item.sn.length > 15 ? 'long-info-item' : ''}}">
                <label>设备号 ：</label>
                <text>{{item.sn||'-'}}</text>
              </view>
              <!-- <view class="info-item  long-info-item">
                <label>生效周期 ：</label>
                <text>{{item.startDate||''}}-{{item.endDate||''}}</text>
              </view> -->
            </view>
            <view class="content-item-footer" wx:if="{{g_source}}">
              <view class="footer-left"></view>
              <view class="footer-right">
                <view class="footer-right-btn" data-item="{{item}}" bindtap="handleSelectJump" wx:if="{{!g_flagMulti}}">
                  <text>选择此车</text>
                </view>
                <view>
                  <checkbox-group data-item="{{item}}" bindchange="handleChangeBlack">
                    <checkbox style="transform: scale(0.7);" />
                  </checkbox-group>
                </view>
              </view>
            </view>
            <view class="content-item-footer" wx:else>
              <view class="footer-left" style="max-width: 70%;">
                <block wx:for="{{item.driverList}}" wx:for-item="g_item" wx:key="index">

                  <view style="display: flex;gap: 15rpx;line-height: 50rpx;">
                    <text>{{g_item.drivername}}12</text>
                    <text>{{g_item.drivermobile}}</text>
                    <text style="color:#1b64b1;" data-item="{{g_item}}" bindtap="handleUnBindDriver">解绑</text>
                  </view>
                  <view>
                    <!-- <label style="font-size: 22rpx;">生效周期 ：</label> -->
                    <text style="font-size: 22rpx;font-weight: 500;">{{g_item.rentstartdate}} - {{g_item.rentenddate}}</text>
                  </view>
                </block>

              </view>
              <view class="footer-right" style="display: flex;gap: 10rpx;">
                <view class="footer-right-btn" data-item="{{item}}" bindtap="handleShowSendNetKeyModal">
                  <text>绑定用车人</text>
                </view>
                <!-- <view class="footer-right-btn" data-item="{{item}}" bindtap="handleShowSendKeyModal">
                  <text>发送钥匙</text>
                </view> -->
              </view>
            </view>
          </view>
        </block>
      </scroll-view>
    </block>
    <block wx:if="{{c_activeTab == 2}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;">

        <view class="card-info">
          <!-- 车牌号 -->
          <view class="card-info-item">
            <label>车牌号<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入车牌号" value="{{params.platenumber}}" data-item="platenumber" bindinput="handleBindinput" />
              </view>
            </block>

          </view>
          <!-- 设备号 -->
          <view class="card-info-item">
            <label>设备号<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入设备号" value="{{params.sn}}" disabled="{{id}}" data-item="sn" bindinput="handleBindinput" />
              </view>
            </block>
          </view>
          <!-- code -->
          <view class="card-info-item">
            <label>code<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入code" value="{{params.code}}" disabled="{{id}}" data-item="code" bindinput="handleBindinput" />
              </view>
            </block>
          </view>
          <!-- 车系 -->
          <view class="card-info-item">
            <label>车系</label>

            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入车系" value="{{params.vehicleSerialName}}" data-item="vehicleSerialName" bindinput="handleBindinput" />
              </view>
            </block>


          </view>
          <!-- 车型 -->
          <view class="card-info-item">
            <label>车型</label>

            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入车型" value="{{params.vehicleModeName}}" data-item="vehicleModeName" bindinput="handleBindinput" />
              </view>
            </block>
          </view>
          <!-- 年款 -->
          <view class="card-info-item">
            <label>年款</label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入年款" value="{{params.ccdate}}" data-item="ccdate" bindinput="handleBindinput" />
              </view>
            </block>
          </view>

          <!-- 车架号 -->
          <view class="card-info-item">
            <label>车架号</label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入车架号" value="{{params.vin}}" data-item="vin" bindinput="handleBindinput" />
              </view>
            </block>

          </view>
          <!-- 油箱容积 -->
          <view class="card-info-item">
            <label>油箱容积</label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入油箱容积" value="{{params.xsgw}}" data-item="xsgw" bindinput="handleBindinput" />
              </view>
            </block>

          </view>
          <!-- 启动方式 -->
          <view class="card-info-item">
            <label>启动方式</label>
            <block>
              <view class="card-info-item-tabs">
                <view class="card-info-item-tabs-btn">
                  <text class="{{batterylift == '一键启动'?'tabs-active':''}}" data-item="一键启动" bindtap="handleBatterylift">一键启动</text>
                  <text class="{{batterylift == '机械钥匙'?'tabs-active':''}}" data-item="机械钥匙" bindtap="handleBatterylift">机械钥匙</text>
                  <text class="{{batterylift == '其他'?'tabs-active':''}}" data-item="其他" bindtap="handleBatterylift">其他</text>
                </view>
                <view class="tabs-footer">
                  <view>说明：</view>
                  <view class="card-info-item-tips">
                    <view>[一键启动]为使用按键按下启动；</view>
                    <view>[机械钥匙]为使用钥匙片拧动启动；</view>
                  </view>
                </view>
              </view>
            </block>

          </view>
        </view>
        <view class="card-footer">
          <view bindtap="handleSubmit">确认{{btnState}}</view>
        </view>
      </scroll-view>
    </block>
  </view>
</view>

<!-- 绑定人员 -->
<block>
  <view class="modal-mask" wx:if="{{net_send_key_show_momal}}" bindtap="handleHideSengKeyModal"></view>
  <view class="modal-base-map" wx:if="{{net_send_key_show_momal}}">
    <form bindsubmit="handleNetFormSubmit">
      <view class="modal-container">
        <view class="modal-container-head">
          <text>绑定用车人</text>
          <image src="/assets/images/home/right_1.png" bindtap="handleHideSengKeyModal" />
        </view>
        <view class="modal-container-middle">
          <view class="middle-form-item">
            <label>车牌号</label>
            <view class="modal-form-region">
              {{cellData.platenumber}}
            </view>

          </view>
          <view class="middle-form-item">
            <label>绑定用车人</label>
            <view class="modal-form-region">
              <input placeholder="请输入使用人" name='personName' style="text-align: right;font-size: 28rpx;" />
            </view>
          </view>
          <view class="middle-form-item">
            <label>手机号</label>
            <view class="modal-form-region">
              <input placeholder="请输入手机号" name='mobile' style="text-align: right;font-size: 28rpx;" />
            </view>

          </view>
          <view class="middle-form-item">
            <label>开始时间</label>
            <view class="modal-form-region">
              <picker mode="date" data-index="startDate" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{startDate}}</text>
                </view>
              </picker>
              <picker mode="time" data-index="startTime" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{startTime}}</text>
                </view>
              </picker>
            </view>

          </view>
          <view class="middle-form-item">
            <label>结束时间</label>
            <view class="modal-form-region">
              <picker mode="date" data-index="endDate" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{endDate}}</text>
                </view>
              </picker>
              <picker mode="time" data-index="endTime" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{endTime}}</text>
                </view>
              </picker>
            </view>

          </view>
        </view>
        <view class="modal-container-footer">
          <button formType="submit">确认</button>
        </view>
      </view>
    </form>
  </view>
</block>