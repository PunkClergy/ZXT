<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="{{g_title}}" />
  <view class="record-container" style="height: {{c_screen_height-(navBarHeight + statusBarHeight)}}px;margin-top: {{navBarHeight + statusBarHeight}}px;">
    <!-- 详情区域部分 -->
    <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
      <block wx:for="{{g_items}}" wx:key="index">
        <view class="content-item">
          <view class="content-item-head">
            <view class="head-left">
              <view class="left-category">
                <text>{{item.filename}}</text>
              </view>
            </view>
            <view class="head-right">
              <image src="/assets/images/home/_see.png" data-item="{{item}}" bindtap="hadleView" />
            </view>
          </view>
          <view class="content-item-info">
            <view class="info-item  {{item.filename.length > 15 ? 'long-info-item' : ''}}">
              <label>名称 ：</label>
              <text>{{item.filename||'-'}}</text>
            </view>
            <view class="info-item  {{item.roleName.length > 15 ? 'long-info-item' : ''}}" style="display: flex;flex-direction: row;">
              <label>备注 ：</label>
              <text>{{item.bak}}</text>
            </view>
            <view class="info-item  {{item.publishDate.length > 15 ? 'long-info-item' : ''}}">
              <label>发布时间 ：</label>
              <text>{{item.publishDate||'-'}}</text>
            </view>
          </view>
        </view>
      </block>
      <block wx:if="{{g_items.length<1}}">
        <view style="display: flex;justify-content: center; align-items: center;font-size: 26rpx;color: #ccc;height: 80vh;">
          无数据
        </view>
      </block>
    </scroll-view>
  </view>
</view>