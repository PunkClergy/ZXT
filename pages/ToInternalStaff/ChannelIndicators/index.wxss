/* 全局样式 */
page {
  background-color: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 搜索区域 */
.search-box {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.search-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  background: #f9fafb;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.search-item text:first-child {
  color: #666;
}

.search-input-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.search-input-box input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  background: #f9fafb;
  border-radius: 10rpx;
  font-size: 28rpx;
  border: none;
}

.search-input-box button {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 10rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

/* 列表卡片 */
.list-container {
  padding: 0 20rpx;
}

.list-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 一行显示两列字段 */
.item-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.item-col {
  flex: 1;
  min-width: 200rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
}

.item-row:last-of-type {
  margin-bottom: 0;
}

.label {
  color: #8c8c8c;
  margin-right: 8rpx;
  white-space: nowrap;
}

.content {
  color: #333;
  font-weight: 500;
  word-break: break-all;
}

.file-path {
  color: #2b85e6;
  font-weight: 500;
  text-decoration: underline;
}

/* 空数据 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #bbb;
  font-size: 28rpx;
}

/* PDF弹窗 */
.pdf-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  display: none;
  z-index: 9999;
}

.pdf-modal.show {
  display: block;
}

.modal-content {
  position: absolute;
  top: 8%;
  left: 5%;
  width: 90%;
  height: 84%;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #fafafa;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.close-btn {
  font-size: 44rpx;
  color: #666;
  line-height: 1;
}

.pdf-body {
  height: calc(100% - 88rpx);
}

web-view {
  width: 100%;
  height: 100%;
}