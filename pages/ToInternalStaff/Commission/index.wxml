<!-- 搜索条件区域 -->
<view class="search-box">
  <!-- 月份选择 -->
  <picker mode="date" fields="month" value="{{searchDate}}" bindchange="onDateChange">
    <view class="search-item date-picker">
      <text>月份：</text>
      <text>{{searchDate || '请选择月份'}}</text>
    </view>
  </picker>

  <!-- 搜索框 -->
  <view class="search-input-box">
    <input placeholder="公司名称" value="{{keyword}}" bindinput="onKeywordInput" />
    <button bindtap="onSearch" type="primary" size="mini">搜索</button>
  </view>
</view>
<view class="stats-bar">
  <!-- 总佣金 独占一行 -->
  <view class="stats-row">
    <text>总佣金</text>
    <text class="num">￥{{sumCommissionTatol}}</text>
  </view>

  <!-- 数量 一行 -->
  <view class="stats-row">
    <text>MCCK设备</text>
    <text class="num">{{deviceCountTotal}}台</text>
    <text>失联保障</text>
    <text class="num">{{loseInsuranceCountTatol}}单</text>
    <text>停运无忧</text>
    <text class="num">{{shutInsuranceCountTotal}}单</text>
  </view>

  <!-- 钱数 一行 -->
  <view class="stats-row">
    <text>MCCK佣金</text>
    <text class="num">￥{{deviceAmountTatol}}</text>
    <text>失联佣金</text>
    <text class="num">￥{{loseCommissionTatol}}</text>
    <text>停运佣金</text>
    <text class="num">￥{{shutCommissionTatol}}</text>
  </view>
</view>

<!-- 列表区域 -->
<view class="list-container">
  <block wx:if="{{list.length === 0}}">
    <view class="empty">暂无数据</view>
  </block>
  <block wx:else>
    <view class="list-item" wx:for="{{list}}" wx:key="index">
      <view class="item-row">
        <view class="item-col">
          <text class="label">公司名称：</text>
          <text class="content">{{item.companyName}}</text>
        </view>
      </view>
      <view class="item-row">
        <view class="item-col">
          <text class="label">月份：</text>
          <text class="content">{{item.month||''}}</text>
        </view>
        <view class="item-col">
          <text class="label">合计返佣：</text>
          <text class="content">{{item.sumCommission}}</text>
        </view>
      </view>


      <view class="item-row">
        <view class="item-col">
          <text class="label">停运无忧单数：</text>
          <text class="content">{{item.shutInsuranceCount||''}}</text>
        </view>
        <view class="item-col">
          <text class="label">停运无忧返佣：</text>
          <text class="content">{{item.shutCommission}}</text>
        </view>
      </view>
      <view class="item-row">
        <view class="item-col">
          <text class="label">失联保障单数：</text>
          <text class="content">{{item.loseInsuranceCount||''}}</text>
        </view>
        <view class="item-col">
          <text class="label">失联保障返佣：</text>
          <text class="content">{{item.loseCommission}}</text>
        </view>
      </view>
      <view class="item-row">
        <view class="item-col">
          <text class="label">MCCK设备台数：</text>
          <text class="content">{{item.deviceCount||0}}</text>
        </view>
        <view class="item-col">
          <text class="label">MCCK设备返佣：</text>
          <text class="content">{{item.deviceCommission||0}}</text>
        </view>
      </view>
    </view>
  </block>
</view>