.container {
  width: 100%;
  height: 95vh;
  display: flex;
  flex-direction: column;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  touch-action: pan-x;
  position: relative;
}

/* 状态栏占位符 */
.status-bar {
  width: 100%;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  /* 使内容靠左对齐 */
  padding-left: 16px;
  /* 可选：增加一些左边距 */
  box-sizing: border-box;
  /* 确保padding不会影响总宽度 */
}

/* 标题容器 */
.title-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 100%;
}

.title-container image {
  width: 40rpx;
  height: 40rpx;
}

/* 标题文本 */
.title {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 33rpx;
  color: #010101;
  line-height: 30rpx;
}

/* 搜索框容器 */
.search-container {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  gap: 20rpx;
}

.search-drop {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 90%;
}

.search-box-date {
  width: 30rpx;
  height: 30rpx;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 200rpx;
  padding: 8px 12px;
  width: 90%;
}

/* 搜索图标 */
.search-icon {
  margin-right: 8px;
  /* 图标与输入框之间留出间距 */
}

/* 输入框 */
.search-input {
  flex: 1;
  border: none;
  background-color: transparent;
  outline: none;
  font-size: 16px;
}

.search-count {
  display: flex;
  flex-direction: row;
  justify-content: center;
  width: 90%;
}

.search-count text {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 22rpx;
  color: #7b7c7c;
}

/* 主要内容容器 */
.content-container {
  position: absolute;
  bottom: 10px;
  left: 0;
  right: 0;
  overflow-y: auto;
}

/* 内容项 */
.content-item {
  margin: 15rpx;
  background-color: #ffffff;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}
.content-item-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  border-bottom: 1px solid #f0f0f0;
  padding: 10rpx;
}
.head-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.left-category {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #333333;
}
.head-right {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  align-items: center;
  justify-content: center;
}
.head-right text {
  font-size: 24rpx;
  color: #1576dc;
}

/* 主要内容区域 */
.content-item-info {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  padding: 10rpx;
  gap: 20rpx;
  border-bottom: 1px solid #f0f0f0;
}
.info-item {
  flex: 0 0 48%;
  box-sizing: border-box;
  word-wrap: break-word;
  transition: all 0.3s;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #333333;
}
.long-info-item {
  flex-basis: 100% !important;
}

/* 一键下单样式 */
.levitation-button {
  position: absolute;
  bottom: 60rpx;
  width: 100%;
  display: flex;
  justify-content: center;
}
.levitation-button text {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 75rpx;
  width: 40%;
  background: linear-gradient(88deg, #1576dc, #1b64b1);
  box-shadow: 0rpx 1rpx 13rpx 0rpx rgba(51, 63, 92, 0.31);
  border-radius: 36rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #ffffff;
}
/* 遮罩层样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

/* 弹窗容器样式 */
.modal-container {
  position: fixed;
  top: 50%;
  left: 5%;
  transform: translate(0%, -50%);
  width: 90%;
  max-width: 500px;
  background-color: white;
  border-radius: 16px;
  z-index: 1001;
  overflow: hidden;
}

/* 弹窗头部样式 */
.modal-header {
  padding: 16px;
  border-bottom: 1px solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 24px;
  color: #999;
  cursor: pointer;
}

/* 弹窗内容区域样式 */
.modal-content {
  padding: 16px;
  max-height: 90vh;
  /* 限制最大高度，避免超出屏幕 */
}



.content-text {
  font-size: 16px;
  line-height: 1.6;
  color: #666;
}




/* 蒙层样式优化 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  /* 加深透明度，增强遮罩效果 */
  z-index: 1000;
  backdrop-filter: blur(2px);
  /* 毛玻璃效果，现代感更强 */
  -webkit-backdrop-filter: blur(2px);
  /* 兼容微信小程序 */
  transition: opacity 0.3s ease;
  /* 淡入淡出动画 */
  opacity: 0;
  animation: fadeIn 0.3s forwards;
  /* 显示时的淡入动画 */
}

/* 蒙层淡入动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}