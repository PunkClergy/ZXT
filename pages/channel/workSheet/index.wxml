<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <!-- 自定义头部 -->
  <custom-header title="互动看板" />
  <!-- 搜索框 -->
  <view class="search-container" style="height:{{c_searchBarHeight+40}}px;margin-top: {{c_totalNavHeight}}px;">
    <view class="search-box">
      <icon type="search" size="16" class="search-icon" />
      <input placeholder="搜索订单号" bindblur="handleBlur" class="search-input" />
    </view>
    <view class="search-count">
      <text>共有{{g_total}}个工单</text>
    </view>
  </view>
  <!-- 主要内容区域 -->
  <scroll-view class="content-container" scroll-y="true" style="top:{{c_statusBarHeight + c_navBarHeight + c_searchBarHeight+40}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
    <block wx:for="{{g_items}}" wx:key="index" wx:for-item="item">
      <view class="content-item" data-item="{{item}}" bindtap="handleView">
        <view class="content-item-head">
          <view class="head-left">
            <view class="left-category">
              <image src="/assets/images/home/car_icon.png" />
              <text>{{item.companyName||'-'}}</text>
            </view>
          </view>
          <view class="head-right">
            <text>{{item.notReadCount}} 未读消息</text>
          </view>
        </view>
        <view class="content-item-info">
          <view class="info-item  {{item.receiveCompanyName.length > 15 ? 'long-info-item' : ''}}">
            <label>所属BD ：</label>
            <text>{{item.receiveCompanyName||'-'}}</text>
          </view>
          <view class="info-item  {{item.maxCreateDate.length > 15 ? 'long-info-item' : ''}}">
            <label>时间 ：</label>
            <text>{{item.maxCreateDate||'-'}}</text>
          </view>
        </view>
      </view>
    </block>
  </scroll-view>
  <!-- 一键操作按钮 -->
  <view class="levitation-button" bindtap="handleOneClickOrdering">
    <text>一键下单</text>
  </view>
</view>