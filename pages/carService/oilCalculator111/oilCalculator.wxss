/* 遮盖层 */
 
.modal-mask {
  width: 100%;
  height: 100%;
  position: fixed;
  top: 0;
  left: 0;
  background: #000;
  opacity: 0.5;
  overflow: hidden;
  z-index: 100;
  color: #fff;
}


 
/* 白色背景 */
 
.modal-content {
  position: fixed;
  top: 220rpx;
  left: 50rpx;
  z-index: 9500;
  width: 650rpx;
  height: 600rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 20rpx;
}
