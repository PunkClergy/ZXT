<!-- 检测完毕弹窗 -->
<block>
  <view class="modal-mask" wx:if="{{oilShowModal}}" bindtap="oilcancelButttonTap"></view>
  <view class="modal-base-map" wx:if="{{oilShowModal}}">
    <view class="modal-container">
      <view class="modal-container-head">
        <text>检测完毕！请选择检测状态</text>
        <image src="/assets/images/home/right_1.png" bindtap="oilcancelButttonTap" />
      </view>
      <view class="modal-container-middle">
        <view class="yh-container">
          <canvas type="2d" id="progressCanvas" style="width: 200px; height: 200px;"></canvas>
          <!-- 中间的内容 -->
          <view class="center-content">
            <view class="info">本次检测油量</view>
            <view class="num">50.87<text class="info" style="font-weight: bold;">L</text></view>
            <view class="progress">{{progress}}%</view>
          </view>

        </view>
      </view>
      <view class="modal-container-footer">
        <button style="width: 30%;" bindtap='startRent'>起租</button>
        <button style="width: 30%;background: #fff;border:1px solid #1B64B1 ; color: #1B64B1;" bindtap='rentEnd'>还租</button>
      </view>
    </view>
  </view>
</block>




<view class="modal-mask" bindtap="hideModal" wx:if="{{orderShowModal}}"></view>
<view wx:if="{{orderShowModal}}">
  <view class="modal-content">
    <view style="margin-top: 50rpx;">
      <view class="model-text" style="color: gray;">请选择起租订单：</view>
      <scroll-view scroll-y="true" class="model-text" style="height: 390rpx; margin-top: 20rpx;">
        <radio-group bindchange="orderRadioChange">
          <label style="display: flex;height: 70rpx;" wx:for="{{qzOrderitems}}" wx:key="id">

            <view style="height: 60rpx;">
              <radio value="{{item.id}}" style="transform:scale(0.8);line-height: 60rpx;" />
            </view>
            <view style="height: 60rpx;line-height: 60rpx;">{{item.startdate + '   油量：'+item.startoil+'L'}}</view>
          </label>
        </radio-group>
      </scroll-view>
      <view class="fengexian" style="position:absolute;bottom:92rpx;"></view>
      <view style="display:flex;width: 100%;position:absolute;bottom:0;">
        <button class='btn' bindtap='zhijieRentEnd'>直接还租</button>
        <button class='btn' bindtap='qizhuRentEnd'>选订单还租</button>
        <button class='btn' bindtap='rentEndCancel'>关闭</button>
      </view>
    </view>
  </view>
</view>