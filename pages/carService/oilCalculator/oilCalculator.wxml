<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">

  <!-- 自定义头部 -->
  <custom-header title="油量计算器-手动" />
  <!-- 车辆基本信息Card -->
  <view class="vehicle-basic-info-container" style="height:{{searchBarHeight}}px;margin-top: {{totalNavHeight}}px">
    <view class="vehicle-basic-content-item">
      <view class="vehicle-content-item-head">
        <view class="vehicle-head-left">
          <view class="vehicle-left-category">
            <image src="/assets/images/home/01.png" />
            <text>{{carItem.platenumber||'-'}}</text>
          </view>
          <view class="split-line"></view>
          <view class="vehicle-left-brand">
            {{carItem.vehicleSerialName||'-'}}{{carItem.vehicleModeName||''}}
          </view>
          <view class="split-line"></view>
          <view class="vehicle-left-model">
            {{carItem.sn ?'自助取还':carItem.sn===null?'非自助取还':'-'}}
          </view>
        </view>
        <view class="vehicle-head-right">
          <view class="vehicle-right-state" bindtap="handleJumpCarList">
            <text>{{carItem?'重新选择':'选择车辆'}}</text>
            <image src="/assets/images/home/right_1.png" />
          </view>
        </view>
      </view>
      <view class="vehicle-content-item-info">
        <view class="info-item  {{carItem.vin.length > 15 ? 'long-info-item' : ''}}">
          <label>车架号 ：</label>
          <text>{{carItem.vin||'-'}}</text>
        </view>

        <view class="info-item  {{carItem.xsgw.length > 15 ? 'long-info-item' : ''}}">
          <label>油箱容积 ：</label>
          <text>{{item.xsgw||0}}L</text>
        </view>

      </view>
    </view>
  </view>
  <!-- 详细信息 -->
  <view class="record-container" style="height: {{c_screen_height-(searchBarHeight+totalNavHeight)}}px;">
    <view class="record-head">
      <text>油量计算器</text>
      <view class="search-box">
        <icon type="search" size="16" class="search-icon" />
        <input placeholder="车牌号/设备号/租车人" class="search-input" />
      </view>
    </view>
    <view class="record-info">
      <view class="search-container" style="height:{{searchBarHeight}}px">
        <view class="search-drop">
          <picker bindchange="bindPickerChange" value="{{index}}" range="{{array}}">
            <view class="picker">
              <text>所有状态</text>
              <image src="/assets/images/home/up.png" style="width: 20rpx;height: 30rpx;" />
            </view>
          </picker>
          <picker bindchange="bindPickerChange" value="{{index}}" range="{{array}}">
            <view class="picker">
              <text>所有类型</text>
              <image src="/assets/images/home/up.png" style="width: 20rpx;height: 30rpx;" />
            </view>
          </picker>

          <picker bindchange="bindPickerChange" value="{{index}}" range="{{array}}">
            <view class="picker">
              <text>所有时间</text>
              <image src="/assets/images/home/up.png" style="width: 20rpx;height: 30rpx;" />
            </view>
          </picker>
        </view>
        <view class="count-text">共有{{g_total}}条记录 </view>
      </view>
      <scroll-view class="content-container" scroll-y="true" style="top:{{25+5 + 8+10+10 + searchBarHeight}}px;" bindscrolltolower="handleLower">
        <block wx:for="{{items}}" wx:key="index">
          <view class="content-item">
            <view class="content-item-head">
              <view class="head-left">
                <view class="left-category">
                  <image src="/assets/images/home/01.png" />
                  <text>{{item.platenumber}}</text>
                </view>
                <view class="split-line"></view>
                <view class="left-model">
                  {{carItem.vehicleSerialName||'-'}}{{carItem.vehicleModeName||''}}
                </view>
              </view>
              <view class="head-right">
                <image src="/assets/images/home/01.png" style="width: 40rpx;;height: 40rpx;" />
                <text>Li lili</text>
              </view>
            </view>
            <view class="content-item-info">
              <view class="content-item-info-left">
                <view class="info-item  {{item.startoil.length > 15 ? 'long-info-item' : ''}} info-item-title">
                  <label>起租油量 ：</label>
                  <text>{{item.startoil||0}}L</text>
                </view>
                <view class="info-item  {{item.startusername.length > 15 ? 'long-info-item' : ''}}">
                  <label>起租检测人 ：</label>
                  <text>{{item.startusername||'-'}}</text>
                </view>

                <view class="info-item  {{item.startsn.length > 15 ? 'long-info-item' : ''}}">
                  <label>检测设备 ：</label>
                  <text>{{item.startsn||'-'}}</text>
                </view>

                <view class="info-item  {{item.startdate.length > 15 ? 'long-info-item' : ''}}">
                  <label>检测时间 ：</label>
                  <text>{{item.startdate||'-' }}</text>
                </view>
              </view>
              <view class="content-item-info-right">
                <view class="info-item  {{item.endoil.length > 15 ? 'long-info-item' : ''}} info-item-title">
                  <label>还租油量 ：</label>
                  <text>{{item.endoil||0}}L</text>
                </view>

                <view class="info-item  {{item.endusername.length > 15 ? 'long-info-item' : ''}}">
                  <label>还租检测人 ：</label>
                  <text>{{item.endusername||'-'}}</text>
                </view>

                <view class="info-item  {{item.endsn.length > 15 ? 'long-info-item' : ''}}">
                  <label>检测设备 ：</label>
                  <text>{{item.endsn||'-'}}</text>
                </view>

                <view class="info-item  {{item.enddate.length > 15 ? 'long-info-item' : ''}}">
                  <label>检测时间 ：</label>
                  <text>{{item.enddate||'-'}}</text>
                </view>
              </view>
              <!-- <view class="info-item  {{item.startoil.length > 15 ? 'long-info-item' : ''}}">
                <label>起租油量 ：</label>
                <text>{{item.startoil||0}}L</text>
              </view>

              <view class="info-item  {{item.startusername.length > 15 ? 'long-info-item' : ''}}">
                <label>起租检测人 ：</label>
                <text>{{item.startusername||'-'}}</text>
              </view>

              <view class="info-item  {{item.startsn.length > 15 ? 'long-info-item' : ''}}">
