<!-- 请选择设备 -->
<block>
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="cancelButttonTap"></view>
  <view class="modal-base-map" wx:if="{{showModal}}">
    <form bindsubmit="sureButtonTap">
      <view class="modal-container">
        <view class="modal-container-head">
          <text>发送电子钥匙</text>
          <image src="/assets/images/home/right_1.png" bindtap="cancelButttonTap" />
        </view>
        <view class="modal-container-middle">
          <radio-group bindchange="radioChange" style="display: flex;flex-direction: column;gap: 25rpx;">
            <view class="middle-form-item" wx:for="{{snitems}}" wx:key="{{index}}">
              <label>设备编号</label>
              <view class="modal-form-region">
                <view>{{item.idc}}</view>
                <view>
                  <radio value="{{item.idc}}" style="transform:scale(0.8)" />
                </view>
              </view>
            </view>
          </radio-group>

        </view>
        <view class="modal-container-footer">
          <button formType="submit">确认</button>
        </view>
      </view>
    </form>
  </view>
</block>




