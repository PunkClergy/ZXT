                <text>{{item.endoil||0}}L</text>
              </view>

              <view class="info-item  {{item.endusername.length > 15 ? 'long-info-item' : ''}}">
                <label>还租检测人 ：</label>
                <text>{{item.endusername||'-'}}</text>
              </view>

              <view class="info-item  {{item.endsn.length > 15 ? 'long-info-item' : ''}}">
                <label>检测设备 ：</label>
                <text>{{item.endsn||'-'}}</text>
              </view>

              <view class="info-item  {{item.enddate.length > 15 ? 'long-info-item' : ''}}">
                <label>检测时间 ：</label>
                <text>{{item.enddate||'-'}}</text>
              </view> -->

            </view>
            <view class="content-item-footer">
              <view class="footer-left">
                <view class="footer-left--one">
                  <view>油量差额：{{item.diff||0}}L</view>
                  <view class="footer-text">收费状态：{{item.chargestatusname||'-'}}</view>
                </view>
                <view class="footer-left-two">
                  <view>预估服务费：{{item.cost||0}}
                    <image src="/assets/images/home/wh.png" style="width: 25rpx;height: 25rpx;" bindtap="handleOilStatus" />
                  </view>
                  <view class="footer-text">实收服务费：{{item.realcost||0}}</view>
                </view>
              </view>
              <view class="footer-right">
                <view class="footer-right-btn" data-item="{{item}}" bindtap="handleMarkStatus">
                  <text>标记状态</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>
  <!-- 操作按钮 -->
  <view id="{{index}}" class="detection_button" bindtap="getOilButtonTap" wx:if="{{carItem}}">
    <text>检测油量</text>
  </view>
</view>
<!-- 标记状态弹窗 -->
<view wx:if="{{markStatusMod}}">
  <view class="new-modal-content" style="height: {{c_screen_height/4}}px;top: {{c_screen_height/3}}px;width: {{c_screen_width-50}}px;">
    <view class="new-modal-head">
      标记收费状态
    </view>
    <view class="new-modal-info">
      <radio-group bindchange="handleRadioChange">
        <label>
          <radio value="1" checked="{{charging == 1}}" />已收费
          <input placeholder="实收金额" bindinput="handleBindinput" />
        </label>
        <label>
          <radio value="2" checked="{{charging == 2}}" />未收费
        </label>
      </radio-group>
    </view>
    <view class="new-modal-footer">
      <view class="new-modal-footer-btn" bindtap="handleMarkCance">取消</view>
      <view class="new-modal-footer-btn blue-button" bindtap="handleMarkSubmit">确定</view>
    </view>
  </view>
</view>
<!-- 油量计算弹窗 -->
<view wx:if="{{oidStatusMod}}">
  <view class="new-modal-content" style="height: {{c_screen_height/4}}px;top: {{c_screen_height/3}}px;width: {{c_screen_width-50}}px;">
    <view class="new-modal-head">
      预估服务费计算方式
    </view>
    <view class="new-modal-info">
      <view class="oid-text">油价*差额+设定服务费</view>
    </view>
    <view class="new-modal-footer">
      <view class="new-modal-footer-btn blue-button" bindtap="handleOidMarkSubmit">确定</view>
    </view>
  </view>
</view>


<!-- 原有部分 -->
<view wx:if="{{items.length == 0}}" class="scrollView_noDataTip">无数据</view>

<action-sheet hidden="{{isShowOilSheet}}" bindchange="actionSheetChange" z-index="{{ 999 }}">
  <block wx:for-items="{{oilItems}}" wx:key="index">
    <action-sheet-item id="{{item.id}}" bindtap="sheetTap">{{item.name}}</action-sheet-item>
  </block>
  <action-sheet-cancel class="cancel">取消</action-sheet-cancel>
</action-sheet>
