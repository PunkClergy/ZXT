  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #333333;
}

.left-category image {
  width: 40rpx;
  height: 40rpx;
}

.left-brand {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #1B64B1;
  /* background: #EEF7FF; */
  border-radius: 5rpx;
