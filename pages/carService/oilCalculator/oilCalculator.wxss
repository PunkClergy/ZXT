/* pages/order/orderList.wxss */
.container {
  width: 100%;
  height: 95vh;
  display: flex;
  flex-direction: column;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  touch-action: pan-x;
}

.split-line {
  border-left: 1px solid #f0f0f0;
  width: 1px;
  height: 80%;
}

/* 自定义同步部分 */
.custom-navbar {
  width: 100%;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
}

.status-bar {
  width: 100%;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  /* 使内容靠左对齐 */
  padding-left: 10px;
  /* 可选：增加一些左边距 */
  box-sizing: border-box;
  /* 确保padding不会影响总宽度 */
}

.title-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 100%;
}

.title-container image {
  width: 40rpx;
  height: 40rpx;
}

.title {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 33rpx;
  color: #010101;
  line-height: 30rpx;
}

/* 车辆基本信息Card */
.vehicle-basic-info-container {}

.vehicle-basic-content-item {
  margin: 15rpx;
  background-color: #ffffff;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.vehicle-content-item-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  border-bottom: 1px solid #f0f0f0;
  padding: 10rpx;
}

.vehicle-content-item-info {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  padding: 10rpx;
  gap: 20rpx;
}

.vehicle-head-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.vehicle-left-category {
  display: flex;
  align-items: center;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #333333;
}

.vehicle-left-category image {
  width: 40rpx;
  height: 40rpx;
}

.vehicle-left-brand {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  /* color: #1B64B1; */
  border-radius: 5rpx;
  padding: 0 15rpx;
}

.vehicle-left-model {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #333333;
}

.vehicle-head-right {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
  align-items: center;
  justify-content: center;
}

.vehicle-right-state {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #1B64B1;
  display: flex;
  align-items: center;
}

.vehicle-right-state image {
  width: 30rpx;
  height: 30rpx;
}

.vehicle-info-item {
  flex: 0 0 48%;
  box-sizing: border-box;
  word-wrap: break-word;
  transition: all 0.3s;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #333333;

}

.vehicle-long-info-item {
  flex-basis: 100% !important;
}

/* 油量检测记录部分 */
.record-container {
  margin: 15rpx;
  position: relative;
  border-radius: 8rpx;
  background-color: #fff;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.record-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 30px;
  /* border-bottom: 1px solid #f0f0f0; */
  padding: 10rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #333333;
}

.record-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  /* padding: 15rpx; */
}




/* 搜索框容器 */
.search-container {
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #fff;
  flex-direction: column;
  border-radius: 8rpx;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  gap: 30rpx;
  padding: 10px 0px;
  width: 100%;
  border-bottom: 1px solid #f0f0f0;
  z-index: 998;


}

.search-drop {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  width: 90%;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  border: 1px solid #f0f0f0;
  border-radius: 200rpx;
  padding: 4px 12px;
  width: 50%;
}

/* 搜索图标 */
.search-icon {
  margin-right: 8px;
  /* 图标与输入框之间留出间距 */
}

/* 输入框 */
.search-input {
  flex: 1;
  border: none;
  background-color: transparent;
  outline: none;
  font-size: 22rpx;
}

.count-text {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 22rpx;
  color: #7B7C7C;
}

.picker {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-family: PingFang SC;
}

.picker text {
  font-weight: bold;
  font-size: 26rpx;
  color: #333333;
}


/* 主要内容容器 */
.content-container {
  position: absolute;
  bottom: 10rpx;
  left: 0;
  right: 0;
  overflow-y: auto;
  /* 当内容超出高度时显示滚动条 */

}

/* 内容项 */
.content-item {
  margin: 15rpx;
  background-color: #ffffff;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.content-item-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  border-bottom: 1px solid #f0f0f0;
