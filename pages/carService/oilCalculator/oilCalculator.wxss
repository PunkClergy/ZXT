  flex-direction: column;
  gap: 15rpx;
}

.content-item-info-right {
  width: 48%;
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.info-item-title {
  font-weight: bold !important;
  font-size: 26rpx !important;
  color: #4587FD !important;
}

.info-item {
  /* flex: 0 0 48%; */
  box-sizing: border-box;
  word-wrap: break-word;
  transition: all 0.3s;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #333333;

}

.long-info-item {
  flex-basis: 100% !important;
  /* 长内容时占满整行 */
}

.content-item-footer {
  display: flex;
  padding: 10rpx;
  justify-content: space-between;
}

.footer-text {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #333333;
}

.footer-left {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 24rpx;
  color: #333333;
  display: flex;
  flex-direction: row;
  gap: 30rpx;
}

.footer-right {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.footer-right-btn {
  display: flex;
