<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="用车人" />
  <map-com multiple="false" source="desk" sn="{{sn_specific_value}}" style="width: 100%;height: {{c_screen_height-(navBarHeight+80)}}px;margin-top: {{navBarHeight + statusBarHeight}}px;" id="myChild" />
  <!-- 固定底部导航栏区域：使用tabbar样式，高度自适应 -->
  <view class="tabbar" style="height: {{tabBarHeight}}px;">
    <view class="tab-item {{currentTab === index ? 'active' : ''}}" wx:for="{{tabList}}" wx:key="index" bindtap="handleSwitchTabNavigation" data-index="{{index}}">
      <image src="{{item.icon}}" class="tab-icon" mode="widthFix"></image>
      <text>{{item.name}}</text>
    </view>
  </view>
</view>