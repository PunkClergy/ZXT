/* pages/pay/pay.wxss */
.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.order-info,
.pay-methods {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.order-header,
.pay-header {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.order-item {
  font-size: 28rpx;
  color: #666;
  line-height: 50rpx;
}

.pay-item {
  display: flex;
  align-items: center;
  padding: 30rpx 10rpx;
  justify-content: space-between;
  position: relative;
}
.pay-item-title {
  display: flex;
  justify-content: center;
}

.pay-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 20rpx;
}

.pay-name {
  font-size: 30rpx;
  color: #333;
}

.check-icon {
  width: 40rpx;
  height: 40rpx;
  position: absolute;
  right: 0;
}

.footer {
  position: fixed;
  bottom: 20rpx;
  left: 0;
  right: 0;
  padding: 20rpx;
}

.pay-btn {
  background: #07c160;
  color: white;
  text-align: center;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 32rpx;
}
