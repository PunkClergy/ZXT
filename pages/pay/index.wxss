/* 原有样式不变 */
.container {
  padding: 20rpx;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  touch-action: pan-x;
  align-items: center;
}

.order-info,
.pay-methods {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.order-header,
.pay-header {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.order-item {
  font-size: 28rpx;
  color: #666;
  line-height: 50rpx;
}

.pay-item.balance-display {
  display: flex;
  align-items: center;
  padding: 30rpx 10rpx;
  justify-content: space-between;
  position: relative;
  border-bottom: 1rpx solid #f5f5f5;
  margin-bottom: 20rpx;
}
.pay-item.selectable {
  display: flex;
  align-items: center;
  padding: 30rpx 10rpx;
  justify-content: space-between;
  position: relative;
  border-bottom: 1rpx solid #f5f5f5;
}
.pay-item.selectable:last-child {
  border-bottom: none;
}

.pay-item-title {
  display: flex;
  align-items: center;
}

.pay-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 20rpx;
}

.pay-name {
  font-size: 30rpx;
  color: #333;
}

.check-icon {
  width: 40rpx;
  height: 40rpx;
  position: absolute;
  right: 0;
}

.footer {
  position: fixed;
  bottom: 20rpx;
  left: 0;
  right: 0;
  padding: 20rpx;
}

.pay-btn {
  background: #07c160;
  color: white;
  text-align: center;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 32rpx;
}
.pay-btn.disabled {
  background: #cccccc;
  color: #999999;
  pointer-events: none;
}

/* 新增：自定义弹窗样式 */
.corporate-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-mask {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
}

.modal-box {
  width: 85%;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  z-index: 10;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.modal-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.close-icon {
  width: 40rpx;
  height: 40rpx;
}

.modal-body {
  padding: 40rpx 30rpx;
}

.account-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 30rpx;
}
.account-item:last-child {
  margin-bottom: 0;
}

.item-label {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 10rpx;
}

.item-value {
  font-size: 30rpx;
  color: #333333;
  line-height: 40rpx;
}

.account-number {
  font-weight: 500;
  letter-spacing: 2rpx;
}

.copy-icon {
  width: 36rpx;
  height: 36rpx;
  margin-top: 8rpx;
}

.modal-footer {
  padding: 20rpx 30rpx 30rpx;
}

.confirm-btn {
  width: 100%;
  background: #07c160;
  color: #ffffff;
  border: none;
  border-radius: 10rpx;
  padding: 0rpx 0;
  font-size: 32rpx;
  font-weight: 500;
}
.confirm-btn::after {
  border: none;
}