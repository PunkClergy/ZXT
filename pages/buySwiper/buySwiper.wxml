<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="自助下单" />
  <!-- index.wxml -->
  <view class="record-container" style="height: {{c_screen_height-(navBarHeight + statusBarHeight)}}px;margin-top: {{navBarHeight + statusBarHeight}}px;">
    <!-- 切换部分 -->
    <view class="record-tabs" bindtap="handleSwitchTab">
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 1?s_background_tabs_active_1:s_background_tabs_1}}');">购买历史</view>
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 2?s_background_tabs_2:s_background_tabs_active_2}}');">购买保险</view>
    </view>
    <!-- 详情区域部分 -->
    <block wx:if="{{c_activeTab == 1}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
        <block wx:for="{{g_items}}" wx:key="index">
          <view class="content-item">
            <view class="content-item-head">
              <view class="head-left">
                <view class="left-category">
                  <text>保险单号：{{item.insuranceNo||'-'}}</text>
                </view>
              </view>
            </view>
            <view class="content-item-info">
              <view class="info-item  {{item.applicantName.length > 15 ? 'long-info-item' : ''}}">
                <label>被保险人 ：</label>
                <text>{{item.applicantName||'-'}}</text>
              </view>
              <view class="info-item  {{item.applicantIdcard.length > 15 ? 'long-info-item' : ''}}">
                <label>证件号码 ：</label>
                <text>{{item.applicantIdcard||'-' }}</text>
              </view>
              <view class="info-item">
                <label>车牌号 ：</label>
                <text>{{item.plateNumber||'-'}}</text>
              </view>
              <view class="info-item  {{item.startDate.length > 15 ? 'long-info-item' : ''}}">
                <label>保险起期 ：</label>
                <text>{{item.startDate||'-'}}</text>
              </view>
              <view class="info-item  {{item.endDate.length > 15 ? 'long-info-item' : ''}}">
                <label>保险止期 ：</label>
                <text>{{item.endDate||'-'}}</text>
              </view>

            </view>
          </view>
        </block>

      </scroll-view>
    </block>
    <block wx:if="{{c_activeTab == 2}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;">

        <view class="card-info">
          <!-- 司机姓名 -->
          <view class="card-info-item">
            <label>司机姓名<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入司机姓名" value="{{params.applicantName}}" data-item="applicantName" bindinput="handleBindinput" />
              </view>
            </block>

          </view>
          <!-- 身份证号 -->
          <view class="card-info-item">
            <label>身份证号<text>*</text></label>

            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入身份证号" value="{{params.applicantIdcard}}" data-item="applicantIdcard" bindinput="handleBindinput" />
              </view>
            </block>


          </view>
          <!-- 车牌号 -->
          <view class="card-info-item">
            <label>车牌号<text>*</text></label>

            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入车牌号" value="{{params.plateNumber}}" data-item="plateNumber" bindinput="handleBindinput" />
              </view>
            </block>
          </view>
          <!-- 保险时长 -->
          <view class="card-info-item">
            <label>保险时长</label>
            <block>
              <view class="card-info-item-input">
                <text style="font-size: 26rpx;">一年(共365天)</text>
              </view>
            </block>
          </view>

          <!-- 服务费 -->
          <view class="card-info-item">
            <label>服务费</label>
            <block>
              <view class="card-info-item-input">
                <text style="font-size: 26rpx;">{{params.service_charge}}</text>
              </view>
            </block>
          </view>

        </view>
        <view class="card-footer">
          <view bindtap="handleSubmit">确认支付</view>
        </view>
      </scroll-view>
    </block>
  </view>
</view>