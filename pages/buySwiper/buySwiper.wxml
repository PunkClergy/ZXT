<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="{{insurance_type==1?'失联直赔保障':'事故停运补偿险'}}" />
  <!-- index.wxml -->
  <view class="btn-container"  style="margin-top: {{navBarHeight + statusBarHeight}}px;">
    <view class="pay-container" bindtap="handlePay2359">去购买</view>
  </view>
  <view class="record-container" style="display: none; height: {{c_screen_height-(navBarHeight + statusBarHeight)}}px;margin-top: {{navBarHeight + statusBarHeight}}px;">
    <!-- 切换部分 -->
    <view class="record-tabs" bindtap="handleSwitchTab">
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 1?s_background_tabs_active_1:s_background_tabs_1}}');">购买历史</view>
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 2?s_background_tabs_2:s_background_tabs_active_2}}');">购买保险</view>
    </view>
    <!-- 详情区域-列表部分 -->
    <block wx:if="{{c_activeTab == 1}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
        <block wx:for="{{g_items}}" wx:key="index">
          <view class="content-item">
            <!-- 列表共用头部 -->
            <view class="content-item-head">
              <view class="head-left">
                <view class="left-category">
                  <text>保险单号：{{item.insuranceNo||'-'}}</text>
                </view>
              </view>
              <view class="head-right" style="display: flex;justify-content: center;align-items: center;">
                <image src="/assets/images/stop.png" data-id="{{item.id}}" bindtap="handleStop" style="width: 45rpx;height: 45rpx;" />
                <image src="/assets/images/home/_edit.png" data-id="{{item.id}}" data-item="{{item}}" bindtap="handleEdit" style="width: 35rpx;height: 35rpx;" />
              </view>
            </view>
            <!-- 失联险部分 -->
            <view class="content-item-info" wx:if="{{insurance_type==1}}">
              <view class="info-item  {{item.ylname.length > 15 ? 'long-info-item' : ''}}">
                <label>被保险人名称 ：</label>
                <text>{{item.ylname||'-'}}</text>
              </view>
              <view class="info-item  {{item.yladdresss.length > 15 ? 'long-info-item' : ''}}">
                <label>被保险人地址 : </label>
                <text>{{item.yladdresss||'-'}}</text>
              </view>
              <view class="info-item  {{item.sn.length > 15 ? 'long-info-item' : ''}}">
                <label>设备号(sn) ：</label>
                <text>{{item.sn||'-'}}</text>
              </view>
              <view class="info-item  {{item.platenumber.length > 15 ? 'long-info-item' : ''}}">
                <label>车牌号：</label>
                <text>{{item.platenumber||'-'}}</text>
              </view>
              <view class="info-item  {{item.vin.length > 15 ? 'long-info-item' : ''}}">
                <label>车架号 : </label>
                <text>{{item.vin||'-'}}</text>
              </view>
              <view class="info-item  {{item.insuranceamount.length > 15 ? 'long-info-item' : ''}}">
                <label>投保金额 : </label>
                <text>{{item.insuranceamount||'-'}}</text>
              </view>
            </view>
            <!-- 停运险部分 -->
            <view class="content-item-info" wx:else>
              <view class="info-item  {{item.applicantName.length > 15 ? 'long-info-item' : ''}}">
                <label>被保险人 ：</label>
                <text>{{item.applicantName||'-'}}</text>
              </view>
              <view class="info-item  {{item.applicantIdcard.length > 15 ? 'long-info-item' : ''}}">
                <label>证件号码 ：</label>
                <text>{{item.applicantIdcard||'-' }}</text>
              </view>
              <view class="info-item">
                <label>车牌号 ：</label>
                <text>{{item.platenumber||'-'}}</text>
              </view>
              <view class="info-item" wx:if="{{item.insuranceFile}}">
                <label>保单 ：</label>
                <text style="color: cornflowerblue;" data-item="{{item.insuranceFile}}" bindtap="handlePolicy">查看</text>
              </view>
              <view class="info-item  {{item.startDate.length > 15 ? 'long-info-item' : ''}}">
                <label>保险起期 ：</label>
                <text>{{item.startDate||'-'}}</text>
              </view>
              <view class="info-item  {{item.endDate.length > 15 ? 'long-info-item' : ''}}">
                <label>保险止期 ：</label>
                <text>{{item.endDate||'-'}}</text>
              </view>
            </view>
          </view>
        </block>
      </scroll-view>
    </block>
    <!-- 详情区域-购买部分 -->
    <block wx:if="{{c_activeTab == 2}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;">
        <!-- 购买部分-编辑 -->
        <block wx:if="{{edit == 1}}">
          <!-- 失联险购买编辑部分 -->
          <block wx:if="{{insurance_type==1}}">
            <view class="card-info">
              <!-- 被保险人名称 -->
              <view class="card-info-item">
                <label>被保险人名称<text>*</text></label>
                <block>
                  <view class="card-info-item-input">
                    <input placeholder="请输入被保险人名称" value="{{datails_one_params.ylname}}" data-item="ylname" bindinput="handleEditBindinput" />
                  </view>
                </block>
              </view>
              <!-- 被保险人地址 -->
              <view class="card-info-item">
                <label>被保险人地址<text>*</text></label>
                <block>
                  <view class="card-info-item-input">
                    <input placeholder="请输入被保险人地址" data-price="1" value="{{datails_one_params.yladdresss}}" data-item="yladdresss" bindinput="handleEditBindinput" />
                  </view>
                </block>
              </view>
              <!-- 设备号 -->
              <view class="card-info-item">
                <label>设备号(sn)<text>*</text></label>
                <block>
                  <view class="card-info-item-input">
                    <input placeholder="请输入设备号" value="{{datails_one_params.sn}}" data-item="sn" bindinput="handleEditBindinput" />
                  </view>
                </block>
              </view>
              <!-- 车牌号 -->
              <view class="card-info-item">
                <label>车牌号<text>*</text></label>
                <block>
                  <view class="card-info-item-input">
                    <text style="font-size: 26rpx;color: #333;" wx:if="{{datails_one_params.platenumber}}" bindtap="handleCarList">{{datails_one_params.platenumber}}</text>
                    <text style="font-size: 26rpx;color: rgb(95, 91, 91);" bindtap="handleCarList" wx:else>请选择车辆</text>
                  </view>
                </block>
              </view>
              <!-- 车架号 -->
              <view class="card-info-item">
                <label>车架号<text>*</text></label>
                <block>
                  <view class="card-info-item-input">
                    <input placeholder="请输入车架号" value="{{datails_one_params.vin}}" data-item="vin" bindinput="handleEditBindinput" />
                  </view>
                </block>
              </view>
              <!-- 投保金额 -->
              <view class="card-info-item">
                <label>投保金额<text>*</text></label>
                <block>
                  <view class="card-info-item-input">
                    <input placeholder="请输入投保金额" data-price="1" value="{{datails_one_params.insuranceamount}}" data-item="insuranceamount" bindinput="handleEditBindinput" />
                  </view>
                </block>
              </view>
            </view>
          </block>
          <!-- 停运险购买编辑部分 -->
          <block wx:else>
            <view class="card-info">
              <!-- 司机姓名 -->
              <view class="card-info-item">
                <label>司机姓名<text>*</text></label>
                <block>
                  <view class="card-info-item-input">
                    <input placeholder="请输入司机姓名" value="{{datails_params.applicantName}}" data-item="applicantName" bindinput="handleEditBindinput" />
                  </view>
                </block>
              </view>
              <!-- 身份证号 -->
              <view class="card-info-item">
                <label>身份证号<text>*</text></label>
                <block>
                  <view class="card-info-item-input">
                    <input placeholder="请输入身份证号" value="{{datails_params.applicantIdcard}}" data-item="applicantIdcard" bindinput="handleEditBindinput" />
                  </view>
                </block>


              </view>
              <!-- 车牌号 -->
              <view class="card-info-item">
                <label>车牌号<text>*</text></label>

                <block>
                  <view class="card-info-item-input">
                    <text style="font-size: 26rpx;color: #333;" wx:if="{{datails_params.platenumber}}" bindtap="handleCarList">{{datails_params.platenumber}}</text>
                    <text style="font-size: 26rpx;color: rgb(95, 91, 91);" bindtap="handleCarList" wx:else>请选择车辆</text>
                  </view>
                </block>
              </view>
              <!-- 保险时长 -->
              <view class="card-info-item">
                <label>保险时长</label>
                <block>
                  <view class="card-info-item-input">
                    <text style="font-size: 26rpx;">一年(共365天)</text>
                  </view>
                </block>
              </view>

              <!-- 服务费 -->
              <!-- <view class="card-info-item">
                <label>服务费</label>
                <block>
                  <view class="card-info-item-input">
                    <text style="font-size: 26rpx;">{{service_charge}}</text>
                  </view>
                </block>
              </view> -->
            </view>
          </block>
        </block>
        <!-- 购买部分-新增 -->
        <block wx:else>
          <view class="content-item" wx:for="{{insurance_type==1?datalistOne:datalist}}" wx:key="index">
            <view class="content-item-head">
              <view class="head-left">
                <view class="left-category">
                  <text>序号：{{index+1}}</text>
                </view>
              </view>
              <view class="head-right">
                <block wx:if="{{insurance_type==1}}">
                  <image src="/assets/images/home/add.png" wx:if="{{index+1==datalistOne.length}}" style="width: 40rpx;height: 40rpx;" bindtap="handleAddListOne" />
                  <image src="/assets/images/home/_delete.png" wx:if="{{datalistOne.length !=1 }}" data-index="{{index}}" bindtap="handleDeteleListOne" />
                </block>

                <block wx:else>
                  <image src="/assets/images/home/add.png" wx:if="{{index+1==datalist.length}}" style="width: 40rpx;height: 40rpx;" bindtap="handleAddList" />
                  <image src="/assets/images/home/_delete.png" wx:if="{{datalist.length !=1 }}" data-index="{{index}}" bindtap="handleDeteleList" />
                </block>

              </view>
            </view>
            <!-- 失联险部分 -->
            <view class="card-info" wx:if="{{insurance_type==1}}">
              <!-- 被保险人名称 -->
              <view class="card-info-item">
                <label>被保险人名称<text>*</text></label>
                <block>
                  <view class="card-info-item-input">
                    <input placeholder="请输入被保险人名称" data-index="{{index}}" value="{{item.ylname}}" data-item="ylname" bindinput="handleBindinput" />
                  </view>
                </block>
              </view>
              <!-- 被保险人地址 -->
              <view class="card-info-item">
                <label>被保险人地址<text>*</text></label>
                <block>
                  <view class="card-info-item-input">
                    <input placeholder="请输入被保险人地址" data-price="1" data-index="{{index}}" value="{{item.yladdresss}}" data-item="yladdresss" bindinput="handleBindinput" />
                  </view>
                </block>
              </view>

              <!-- 设备号 -->
              <view class="card-info-item">
                <label>设备号(sn)<text>*</text></label>
                <block>
                  <view class="card-info-item-input">
                    <input placeholder="请输入设备号" data-index="{{index}}" value="{{item.sn}}" data-item="sn" bindinput="handleBindinput" />
                  </view>
                </block>
              </view>
              <!-- 车牌号 -->
              <view class="card-info-item">
                <label>车牌号<text>*</text></label>
                <block>
                  <view class="card-info-item-input">
                    <text style="font-size: 26rpx;color: #333;" wx:if="{{item.platenumber}}">{{item.platenumber}}</text>
                    <text style="font-size: 26rpx;color: rgb(95, 91, 91);" data-item="{{index}}" bindtap="handleCarList" wx:else>请选择车辆</text>
                  </view>
                </block>
              </view>
              <!-- 车架号 -->
              <view class="card-info-item">
                <label>车架号<text>*</text></label>
                <block>
                  <view class="card-info-item-input">
                    <input placeholder="请输入车架号" data-index="{{index}}" value="{{item.vin}}" data-item="vin" bindinput="handleBindinput" />
                  </view>
                </block>
              </view>
              <!-- 投保金额 -->
              <view class="card-info-item">
                <label>投保金额<text>*</text></label>
                <block>
                  <view class="card-info-item-input">
                    <input placeholder="请输入投保金额" data-price="1" data-index="{{index}}" value="{{item.insuranceamount}}" data-item="insuranceamount" bindinput="handleBindinput" />
                  </view>
                </block>
              </view>
            </view>
            <!-- 停运险部分 -->
            <view class="card-info" wx:else>
              <!-- 司机姓名 -->
              <view class="card-info-item">
                <label>司机姓名<text>*</text></label>
                <block>
                  <view class="card-info-item-input">
                    <input placeholder="请输入司机姓名" data-index="{{index}}" value="{{item.applicantName}}" data-item="applicantName" bindinput="handleBindinput" />
                  </view>
                </block>

              </view>
              <!-- 身份证号 -->
              <view class="card-info-item">
                <label>身份证号<text>*</text></label>
                <block>
                  <view class="card-info-item-input">
                    <input placeholder="请输入身份证号" data-index="{{index}}" value="{{item.applicantIdcard}}" data-item="applicantIdcard" bindinput="handleBindinput" />
                  </view>
                </block>


              </view>
              <!-- 车牌号 -->
              <view class="card-info-item">
                <label>车牌号<text>*</text></label>

                <block>
                  <view class="card-info-item-input">
                    <text style="font-size: 26rpx;color: #333;" wx:if="{{item.platenumber}}">{{item.platenumber}}</text>
                    <text style="font-size: 26rpx;color: rgb(95, 91, 91);" data-item="{{index}}" bindtap="handleCarList" wx:else>请选择车辆</text>
                    <!-- <input placeholder="请输入车牌号" data-index="{{index}}" value="{{item.platenumber}}" data-item="platenumber" bindinput="handleBindinput" /> -->
                  </view>
                </block>
              </view>
              <!-- 保险时长 -->
              <view class="card-info-item">
                <label>保险时长</label>
                <block>
                  <view class="card-info-item-input">
                    <text style="font-size: 26rpx;">一年(共365天)</text>
                  </view>
                </block>
              </view>

              <!-- 服务费 -->
              <!-- <view class="card-info-item">
                <label>服务费</label>
                <block>
                  <view class="card-info-item-input">
                    <text style="font-size: 26rpx;">{{service_charge}}</text>
                  </view>
                </block>
              </view> -->

            </view>
          </view>
        </block>
        <!-- 底部-确认支付 -->
        <view class="card-footer">
          <block wx:if="{{edit == 1}}">
            <view bindtap="handleEditSubmit">确认提交</view>
          </block>
          <block wx:else>
            <view bindtap="handleInsuranceSubmit" wx:if="{{insurance_type==1}}">确认支付 {{price}}</view>
            <view bindtap="handleSubmit" wx:else>确认支付 {{price}}</view>
          </block>
        </view>
      </scroll-view>
    </block>
  </view>
</view>