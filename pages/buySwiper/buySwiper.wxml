<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="{{insurance_type==1?'失联直赔保障':'事故停运补偿险'}}" />
  <!-- index.wxml -->
  <view class="record-container" style="height: {{c_screen_height-(navBarHeight + statusBarHeight)}}px;margin-top: {{navBarHeight + statusBarHeight}}px;">
    <!-- 切换部分 -->
    <view class="record-tabs" bindtap="handleSwitchTab">
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 1?s_background_tabs_active_1:s_background_tabs_1}}');">购买历史</view>
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 2?s_background_tabs_2:s_background_tabs_active_2}}');">购买保险</view>
    </view>
    <!-- 详情区域部分 -->
    <block wx:if="{{c_activeTab == 1}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
        <block wx:for="{{g_items}}" wx:key="index">

          <view class="content-item">
            <view class="content-item-head">
              <view class="head-left">
                <view class="left-category">
                  <text>保险单号：{{item.insuranceNo||'-'}}</text>
                </view>
              </view>
            </view>
            <view class="content-item-info" wx:if="{{insurance_type==1}}">
              <view class="info-item  {{item.rentorderno.length > 15 ? 'long-info-item' : ''}}">
                <label>主单号 ：</label>
                <text>{{item.rentorderno||'-'}}</text>
              </view>
              <view class="info-item  {{item.sn.length > 15 ? 'long-info-item' : ''}}">
                <label>设备号(sn) ：</label>
                <text>{{item.sn||'-'}}</text>
              </view>
              <view class="info-item  {{item.ylname.length > 15 ? 'long-info-item' : ''}}">
                <label>运营商名称：</label>
                <text>{{item.ylname||'-'}}</text>
              </view>
              <view class="info-item  {{item.otaname.length > 15 ? 'long-info-item' : ''}}">
                <label>平台名称：</label>
                <text>{{item.otaname||'-'}}</text>
              </view>
              <view class="info-item  {{item.platenumber.length > 15 ? 'long-info-item' : ''}}">
                <label>车牌号：</label>
                <text>{{item.platenumber||'-'}}</text>
              </view>
              <view class="info-item  {{item.rentdays.length > 15 ? 'long-info-item' : ''}}">
                <label>租车天数：</label>
                <text>{{item.rentdays||'-'}}</text>
              </view>
              <view class="info-item  {{item.rentstartcity.length > 15 ? 'long-info-item' : ''}}">
                <label>取车城市：</label>
                <text>{{item.rentstartcity||'-'}}</text>
              </view>
              <view class="info-item  {{item.rentendcity.length > 15 ? 'long-info-item' : ''}}">
                <label>还车城市：</label>
                <text>{{item.rentendcity||'-'}}</text>
              </view>
              <view class="info-item  {{item.rentstarttime.length > 15 ? 'long-info-item' : ''}}">
                <label>租车开始时间：</label>
                <text>{{item.rentstarttime||'-'}}</text>
              </view>
              <view class="info-item  {{item.rentendtime.length > 15 ? 'long-info-item' : ''}}">
                <label>租车结束时间：</label>
                <text>{{item.rentendtime||'-'}}</text>
              </view>

            </view>
            <view class="content-item-info" wx:else>
              <view class="info-item  {{item.applicantName.length > 15 ? 'long-info-item' : ''}}">
                <label>被保险人 ：</label>
                <text>{{item.applicantName||'-'}}</text>
              </view>
              <view class="info-item  {{item.applicantIdcard.length > 15 ? 'long-info-item' : ''}}">
                <label>证件号码 ：</label>
                <text>{{item.applicantIdcard||'-' }}</text>
              </view>
              <view class="info-item">
                <label>车牌号 ：</label>
                <text>{{item.plateNumber||'-'}}</text>
              </view>
              <view class="info-item  {{item.startDate.length > 15 ? 'long-info-item' : ''}}">
                <label>保险起期 ：</label>
                <text>{{item.startDate||'-'}}</text>
              </view>
              <view class="info-item  {{item.endDate.length > 15 ? 'long-info-item' : ''}}">
                <label>保险止期 ：</label>
                <text>{{item.endDate||'-'}}</text>
              </view>

            </view>
          </view>
        </block>

      </scroll-view>
    </block>
    <block wx:if="{{c_activeTab == 2}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;">
        <view class="card-info" wx:if="{{insurance_type==1}}">
          <!-- 主单号 -->
          <view class="card-info-item">
            <label>主单号<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入主单号" value="{{params.rentorderno}}" data-item="rentorderno" bindinput="handleBindinput" />
              </view>
            </block>
          </view>
          <!-- 设备号 -->
          <view class="card-info-item">
            <label>设备号(sn)<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入设备号" value="{{params.sn}}" data-item="sn" bindinput="handleBindinput" />
              </view>
            </block>
          </view>
          <!-- 运营商名称 -->
          <view class="card-info-item">
            <label>运营商名称<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入运营商名称" value="{{params.ylname}}" data-item="ylname" bindinput="handleBindinput" />
              </view>
            </block>
          </view>
          <!-- 平台名称 -->
          <view class="card-info-item">
            <label>平台名称<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入平台名称" value="{{params.otaname}}" data-item="otaname" bindinput="handleBindinput" />
              </view>
            </block>
          </view>
          <!-- 车牌号 -->
          <view class="card-info-item">
            <label>车牌号<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入车牌号" value="{{params.platenumber}}" data-item="platenumber" bindinput="handleBindinput" />
              </view>
            </block>
          </view>

          <!-- 租车天数 -->
          <view class="card-info-item">
            <label>租车天数<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入租车天数" value="{{params.rentdays}}" data-item="rentdays" bindinput="handleBindinput" />
              </view>
            </block>
          </view>
          <!-- 租车时间 -->
          <view class="card-info-item">
            <label>租车开始时间<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <picker mode="date" value="{{params.rentstarttime}}" bindchange="handleOnStartDateChange">
                  <view class="picker">
                    {{params.rentstarttime || '请选择租车开始时间'}}
                  </view>
                </picker>
              </view>
            </block>
          </view>
          <!-- 还车时间 -->
          <view class="card-info-item">
            <label>租车结束时间<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <picker mode="date" value="{{params.rentendtime}}" bindchange="handleOnEndDateChange">
                  <view class="picker">
                    {{params.rentendtime || '请选择租车结束时间'}}
                  </view>
                </picker>
              </view>
            </block>
          </view>
          <!-- 取车城市 -->
          <view class="card-info-item">
            <label>取车城市<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入取车城市" value="{{params.rentstartcity}}" data-item="rentstartcity" bindinput="handleBindinput" />
              </view>
            </block>
          </view>
          <!-- 还车城市 -->
          <view class="card-info-item">
            <label>还车城市<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入还车城市" value="{{params.rentendcity}}" data-item="rentendcity" bindinput="handleBindinput" />
              </view>
            </block>
          </view>
        </view>
        <view class="card-info" wx:else>
          <!-- 司机姓名 -->
          <view class="card-info-item">
            <label>司机姓名<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入司机姓名" value="{{params.applicantName}}" data-item="applicantName" bindinput="handleBindinput" />
              </view>
            </block>

          </view>
          <!-- 身份证号 -->
          <view class="card-info-item">
            <label>身份证号<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入身份证号" value="{{params.applicantIdcard}}" data-item="applicantIdcard" bindinput="handleBindinput" />
              </view>
            </block>


          </view>
          <!-- 车牌号 -->
          <view class="card-info-item">
            <label>车牌号<text>*</text></label>

            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入车牌号" value="{{params.plateNumber}}" data-item="plateNumber" bindinput="handleBindinput" />
              </view>
            </block>
          </view>
          <!-- 保险时长 -->
          <view class="card-info-item">
            <label>保险时长</label>
            <block>
              <view class="card-info-item-input">
                <text style="font-size: 26rpx;">一年(共365天)</text>
              </view>
            </block>
          </view>

          <!-- 服务费 -->
          <view class="card-info-item">
            <label>服务费</label>
            <block>
              <view class="card-info-item-input">
                <text style="font-size: 26rpx;">{{params.service_charge}}</text>
              </view>
            </block>
          </view>

        </view>
        <view class="card-footer">
          <view bindtap="handleInsuranceSubmit" wx:if="{{insurance_type==1}}">确认支付</view>
          <view bindtap="handleSubmit" wx:else>确认支付</view>
        </view>
      </scroll-view>
    </block>
  </view>
</view>