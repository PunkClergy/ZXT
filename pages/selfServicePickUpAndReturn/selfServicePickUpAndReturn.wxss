}

.action-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 250px;
}

.bottom_floating_button {
  position: absolute;
  bottom: 15px;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  width: 100%;
}

.bottom_floating_button button {
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 80rpx;
  padding: 0rpx 50rpx;
  background: rgba(0, 119, 190, 0.5);
}