/* 页面page */
page {
  background-color: var(--weui-BG-0);
  height: 100%;
}

/* 筛选区域 */
.giftListView {
  width: 100%;
  bottom: 0;
  top: 0rpx;
  background-color: #ded9d952;
  position: relative;
}

.boxContainer {
  background-color: var(--weui-BG-0);
  border-radius: 4rpx;
}

.boxSear {
  width: 100%;
  display: flex;
}

.boxPlaceOrder {
  align-items: center;
  display: flex;
  margin-left: 0rpx;
}

.boxPicker {
  padding: 8rpx 24rpx 12rpx;
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
}

.picker {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12px;
}

.picker image {
  width: 20rpx;
  height: 20rpx;
}







/* cell */
