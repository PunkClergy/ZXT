<!-- 页面根容器：设置整体背景图，使用container样式控制布局 -->
<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');">

  <!-- 自定义头部区域：包含系统状态栏高度适配，使用custom-header样式 -->
  <view class="custom-header" style="padding-top: {{height_from_head}}px;padding-left: {{capsule_distance_to_the_right}}px; height: {{head_height}}px;">
    <view class="custom-header-outer-layer">
      <image class="custom-header-outer-layer-image" src="/assets/images/home/logo.png"></image>
      <view class="custom-header-outer-layer-title">智信通Wiselink</view>
      <view class="custom-header-outer-layer-user_name">
        <block wx:if="{{account}}">
          <text>{{account}}</text>
        </block>
        <block wx:else>
          <text bindtap="handleOnExistingAccountTap">请登录</text>
          <image bindtap="handleOnExistingAccountTap" src="/assets/images/home/right_1.png" />
        </block>
      </view>
    </view>
  </view>

  <!-- 中间滚动内容区：使用scroll-view实现垂直滚动，设置顶部和底部偏移量 -->
  <scroll-view class="content" scroll-y="true" style="top: {{90}}px; bottom: {{tabBarHeight}}px;">

    <!-- 第一块：轮播图区域 -->
    <view class="swiper-container">
      <swiper indicator-dots="{{false}}" autoplay="{{true}}" interval="3000" duration="500" style="height: {{s_banner_height}}px;">
        <swiper-item wx:for="{{g_banner_image}}" wx:key="index">
          <image bindtap="handleJumpInfo" src="{{c_link}}/img/{{item.fileType==1?item.img:item.videoImg}}" data-item="{{item}}" class="banner-img" mode="widthFix" data-flag='banner' bindload="LoadOnUseGuideImageLoad" />
        </swiper-item>
      </swiper>
    </view>

    <!-- 第二块：公告模块区域 -->
    <view class="notice">
      <view class="notice-outer-layer" data-info="{{notice_data}}" bindtap="handleNotice">
        <view class="notice-outer-layer-left">
          <image class="notice-icon" src="https://k1sw.wiselink.net.cn/img/app2.0/notice.png" />
          <text class="notice-content">{{notice_data.content}}</text>
        </view>
        <view class="notice-outer-layer-right">
          <image class="notice-icon" src="/assets/images/home/right_1.png" />
        </view>
      </view>
    </view>
    <view class="full-width-swiper" style="display: flex;justify-content: space-between;align-items: center;">
      <view class="full-width-use">
        <image src="/assets/images/index/useGuideIcon.png" />
        <text>功能专区</text>
      </view>
      <!-- 暂时注释下面两行代码 20260428 -->
      <!-- <view wx:if="{{longPress}}" bindtap="handleCancelSettings" style="font-size: 28rpx;color: cornflowerblue;">取消</view>
      <view wx:else bindtap="handleLongPress" style="font-size: 28rpx;color: cornflowerblue;">设置</view> -->
      <view bindtap="handleShowPopupRegion" style="font-size: 28rpx;color: cornflowerblue;">更多专区</view>
    </view>
    <!-- 第三块：专区入口区域（一行两列布局） -->
    <view class="special-zone">
      <view class="zone-item" wx:for="{{temporaryZoneList.length>0?temporaryZoneList:zoneList}}" wx:key="index" style="margin: {{ index % 2 === 0 ? '0 2% 0 0' : '0 0 0 2%' }}">
        <view bindlongpress="handleLongPress" class="zone-out {{isLongPressShaking ? 'shake-rotate' : ''}}" style="background-color: {{item.bgcolor}};position: relative;" data-info="{{item}}" bindtap="handleGetMenuList">
          <view style="position: absolute;top: 10rpx;right: 15rpx;" data-item="{{item}}" wx:if="{{longPress}}" catchtap="handleCloseZone">
            <image src="/assets/images/close.png" style="width: 40rpx;height: 40rpx;" />
          </view>
          <image class="zone-img" src="{{'https://k1sw.wiselink.net.cn/img/' + item.icon}}" />
          <view class="zone-name">
            <text class="zone-name-title">{{item.name}}</text>
            <text class="zone-name-desc" style="font-size: {{item.stfontSize||11}}px">{{item.subtitle}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 第四块：全宽图片轮播区域 -->
    <view class="full-width-swiper">
      <view class="full-width-use">
        <image src="/assets/images/index/useGuideIcon.png" />
        <text>使用指南</text>
      </view>
      <swiper indicator-dots="{{false}}" autoplay="{{true}}" interval="4000" duration="500" style="height: {{s_use_height}}px;">
        <swiper-item wx:for="{{fullBannerList}}" wx:key="index" data-info="{{item}}">
          <image src="{{'https://k1sw.wiselink.net.cn/img/' + item.imgpath}}" class="full-banner-img" data-flag='use' data-url="{{item.bookPath}}" data-title="{{item.title}}" bindtap="handlePlayVideo" bindload="LoadOnUseGuideImageLoad" mode="widthFix"></image>
        </swiper-item>
      </swiper>
    </view>

    <!-- 第五块：全宽海报区域 -->
    <!-- <view class="poster">
      <image src="{{'https://k1sw.wiselink.net.cn/img/' + posterImg.img}}" class="poster-img" mode="widthFix"></image>
    </view> -->
  </scroll-view>

  <!-- 固定底部导航栏区域：使用tabbar样式，高度自适应 -->
  <view class="tabbar" style="height: {{tabBarHeight}}px;" wx:if="{{!regionShow}}">
    <view class="tab-item {{currentTab === index ? 'active' : ''}}" wx:for="{{tabList}}" wx:key="index" bindtap="handleSwitchTabNavigation" data-index="{{index}}">
      <image src="{{'https://k1sw.wiselink.net.cn/img/' + item.selectedIconPath}}" class="tab-icon" mode="widthFix" wx:if="{{currentTab === index}}" />
      <image src="{{'https://k1sw.wiselink.net.cn/img/' + item.iconPath}}" class="tab-icon" mode="widthFix" wx:else />
      <text>{{item.text}}</text>
    </view>
  </view>
  <!-- 底部固定按钮区域 -->
  <view class="bottom-btn-bar" style="bottom: {{tabBarHeight}}px;" wx:if="{{longPress}}">
    <view style="display: flex;flex-direction: row;">
      <view class="bottom-btn btn-white" catchtap="handleCancelSettings">取消</view>
      <view class="bottom-btn btn-blue" catchtap="handleConfirmSettings">确定</view>
    </view>
    <view>
      <view class="bottom-btn btn-blue-dark" catchtap="handleResetSettings">重置</view>
    </view>

  </view>
</view>

<!-- 弹窗代码 -->
<!-- 优惠券图片容器（点击图片触发授权） -->
<view class="mask-container" wx:if="{{coupon_modal}}">
  <view class="coupon-wrapper">
    <button class="image-auth-btn" open-type="getPhoneNumber" hover-class="btn_tapcolor" bindgetphonenumber="handleOnGetPhoneNumber">
      <image src="https://k3a.wiselink.net.cn/img/app/coupon50.png" mode="widthFix" class="coupon-image"></image>
    </button>
    <button class="existing-account-btn" bindtap="handleOnExistingAccountTap">
      已有账号？点击登录
    </button>
  </view>
</view>
<!-- 点击咨询入群 -->
<view class="float-button" wx:if="{{!regionShow}}">
  <!-- bindtap="handleShowContact" -->
  <button open-type="contact" show-message-card="{{true}}" send-message-title="我想咨询问题" send-message-path="/pages/index/index" class="hidden-contact-btn" bindcontact="handleContact"></button>
  <image src="https://k1sw.wiselink.net.cn/img/app2.0/desk/consulting.png" />
  <image src="/assets/images/tel400.png" style="width: 80rpx;height: 80rpx;" bindtap="handleMakePhoneCallWithConfirm" />
</view>

<view class="qr-group-container" wx:if="{{join_the_group_modal}}">
  <view class="qr-group-mask" bindtap="handleQRClose">
    <!-- 关闭按钮 -->
    <view class="qr-group-close" bindtap="handleQRClose">×</view>
    <view class="qr-group-preview-content">
      <image catchtap="handleQRShowImageMask" class="qr-group-preview-img" src="{{personal_qr_code}}" mode="widthFix"></image>
      <text class="qr-group-preview-desc">请点击、长按二维码添加官方客服，获取体验权限！</text>
    </view>
  </view>
</view>
<!-- 更新日志弹窗 -->
<view class="mask-container" wx:if="{{JournalFlag}}" style="display: none;">
  <!-- 更新日志弹窗 -->
  <view class="updateLog">
    <!-- 弹窗主体 -->
    <view class="updateLog-theme">
      <!-- 弹窗头部 -->
      <view class="updateLog-theme-head">
        <view class="updateLog-theme-head-title">更新日志</view>
        <!-- 关闭按钮 -->
        <view class="updateLog-theme-head-close">x</view>
      </view>

      <!-- 日志内容区域（优化滚动体验） -->
      <view class="updateLog-theme-contentArea">
        <!-- 增加内边距和背景区分，提升可读性 -->
        <view class="updateLog-theme-contentArea-main" style="width: 100%;">
          <view class="updateLog-theme-contentArea-main-title">{{version}} 版本更新</view>
          <view class="updateLog-theme-contentArea-main-text" wx:for="{{Journal}}" wx:key="index">{{index + 1}}、{{item}}</view>
        </view>
      </view>

      <!-- 底部确认按钮 -->
      <view style="padding: 12px 20px;border-top: 1px solid #f0f0f0;">
        <view bindtap="handleSetVersion" style="width: 100%;height: 44px;background: #007aff;border-radius: 8px;color: #fff;display: flex;justify-content: center;align-items: center;font-size: 16px;cursor: pointer;">
          我知道了
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 更多选项弹窗 -->
<view class="mask" wx:if="{{regionShow}}" bindtap="handleHidePopup"></view>
<view class="popup" wx:if="{{regionShow}}">
  <view class="popup-title">请选择您想要显示的专区</view>
  <view class="checkbox-list">
    <checkbox-group bindchange="handleOnCheckboxChange">
      <label class="checkbox-item" wx:for="{{regionList}}" wx:key="id">
        <checkbox value="{{item.id}}" checked="{{item.checked}}" />
        <text>{{item.name}}</text>
      </label>
    </checkbox-group>
  </view>

  <view class="popup-buttons">
    <button bindtap="handleHidePopup" class="btn cancel">取消</button>
    <button bindtap="handleOnConfirm" class="btn confirm">确定</button>
  </view>
</view>