page {
  background-color: var(--weui-BG-0);
  height: 100%;
}

.work_order_details_page_container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.work_order_details_page-tabs {
  flex: 1;
  display: flex;
  width: 98%;
  position: fixed;
  z-index: 1000;
  border: 1rpx solid rgb(135, 206, 235, 0.5);
  border-radius: 8rpx;

}

.details-tab {
  flex: 1;
  background: #fff;
  text-align: center;
  border-radius: 6rpx;
  color: #9c9a9a;
  font-weight: bold;
  font-size: 26rpx;
  padding: 10rpx 0;
}

.active {
  background-color: #00bfff;
  color: #000 !important;
}

/* 工单信息 */
.outer_layer_of_work_order_information {
  display: flex;
  flex-direction: column;
  background-color: #fff;
  width: 98%;
  margin: auto;
  margin-top: 6px;
  border-radius: 8rpx;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.outer_layer_of_work_order_information image {
  width: 20px !important;
  height: 20px !important;

}

.work_order_information_header {
  display: flex;
  flex: 1;
  border-bottom: 1px solid #eee;
  align-items: center;
  padding: 6rpx;
  font-size: 26rpx;
  font-weight: bold;
}

.work_order_information_content_area {
  padding: 6rpx;
}

.content-container-info-item {
  min-width: 48%;
  height: 50rpx;
  color: gray;
  box-sizing: border-box;
  font-size: 26rpx;
}

.title_inside_the_card {
  font-weight: bold;
  font-size: 24rpx;
  color: #000;
}

.multiple-choice-service-center {
  display: flex;
  flex-wrap: wrap;
  padding: 0 0 40rpx 0;
}

.multiple-choice-service-center_label {
  display: flex;
  flex-direction: row;
  min-width: 30%;
  max-width: 50%;
  font-size: 24rpx;
  gap: 6rpx;
  height: 50rpx;
  line-height: 50rpx;
  color: #9c9a9a;
}

.multiple_selection_box_scaling {
  transform: scale(0.7);
}

.page-section-radio {
  display: flex;
  flex-wrap: wrap;
}

.page-section-radio label {
  width: 33%;
  font-size: 26rpx;
  color: #9c9a9a;
}



.service_information_switching {
  display: flex;
  flex-direction: column;
  margin-top: 10px;
}

.service_information_switching_slider {
  width: 100%;
  white-space: nowrap;
  overflow-x: auto;
  box-sizing: border-box;
  background-color: #fff;
}


.service_information_switching_bar {
  display: flex;
  border-bottom: 1px solid #ddd;
}

.service_information_switching_bar-button {
  flex: 0 0 auto;
  text-align: center;
  padding: 8rpx 10rpx;
  font-size: 24rpx;
  min-width: 30%;
}

.service_information_switching_bar-button_active {
  border-bottom: 1px solid #eee;
  background-color: #eee;
  border-radius: 8rpx;
}

.provide_service_photos {
  display: flex;
  gap: 20rpx;
  font-size: 26rpx;
  color: #000;
}

.provide_service_detail_photos {
  display: flex;
  flex-direction: column;
  text-align: center;
  align-items: center;
}

.provide_service_photos_text {
  min-width: 130rpx !important;

}

.provide_service_detail_photos image {
  width: 80rpx !important;
  height: 80rpx !important;
}

.switching_content {
  font-size: 26rpx;
  display: flex;
  height: 60rpx;
  line-height: 60rpx;
  color: #9c9a9a;
}

.switching_content label {
  min-width: 30%;
  display: flex;
  justify-content: flex-end;

}

.switching_content text {
  min-width: 30%;
  display: flex;
}

.selected_internal_car_service {
  font-size: 26rpx;
  display: flex;
  flex-direction: column;
  color: #9c9a9a;
}

.selected_internal_car_service_single {
  font-size: 26rpx;
}

.chewubao_service {
  font-size: 26rpx;
  margin-top: 10px;
  display: flex;
  flex-direction: row;
  justify-content: center;
  font-weight: bold;
  border: 1px solid #ccc;
  padding: 10rpx;
  border-radius: 6px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.price_module {
  font-size: 26rpx;
  padding: 20rpx;
  color: #9c9a9a;
}