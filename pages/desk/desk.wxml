<privacy />
<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <!-- 自定义头部 -->
  <view class="custom-navbar" style="height:{{totalNavHeight}}px;">
    <view class="status-bar" style="height:{{statusBarHeight}}px;"></view>
    <view class="nav-bar" style="height:{{navBarHeight}}px;">
      <view class="title-container">
        <image src="{{logoSrc}}" bindtap="handleJumpHome" />
        <text class="title">智信通wiselink</text>
        <view wx:if="{{account}}" style="color: #575756;font-size: 26rpx;">{{account}}（已登录）</view>
        <view wx:else style="color: #575756;font-size: 26rpx;" bindtap="handleLogin">请登录</view>
      </view>
    </view>
  </view>
  <!-- 轮播图部分 -->
  <view class="swiper-outer-container" style="background-image: url('{{s_background_image_of_the_banner}}');margin-top: {{totalNavHeight}}px;height: {{s_banner_height}}px;">
    <swiper class="banner-swiper" vertical="{{false}}" circular="{{false}}" autoplay="{{true}}" interval="3000" duration="500" style="height: {{s_banner_height}}px;">
      <swiper-item wx:for="{{g_banner_image}}" wx:key="index" style="height: 100%; overflow: hidden;">
        <image bindtap="handleJumpInfo" data-item="{{item}}" show-menu-by-longpress="{{true}}" src="{{c_link}}/img/{{item.img}}" class="slide-image" mode="aspectFill" bindload="initialiOnImageLoad" wx:if="{{item.fileType==1}}" />
        <image wx:else src="{{c_link}}/img/{{item.videoImg}}" style="width: 100%;" data-item="{{item}}" bindtap="hadleView" class="slide-image" mode="aspectFill"></image>
      </swiper-item>
    </swiper>
  </view>
  <!-- 快捷入口部分 -->
  <view class="middle" style="height: {{s_quick_entrance_height}}px;">
    <swiper current="{{g_quickIndex}}" class="middle-swiper" bindchange="handleQuickEntry">
      <swiper-item wx:for="{{pagedIcons}}" wx:key="index">
        <view class="middle-swiper-item">
          <block wx:for="{{item}}" wx:key="index">
            <view class="middle-swiper-container" wx:if="{{item.name}}">
              <view class="middle-swiper-container-icon" data-item="{{item}}" bindtap="handleGetMenuList" style="font-weight: {{item.id == menuId?'bold':''}};">
                <image src="{{!item.icon ? '/assets/images/index/icon5.png' : c_link + 'img/' + item.icon}}" />
                <text>{{item.name}}</text>
              </view>
            </view>
          </block>
        </view>
      </swiper-item>
    </swiper>
  </view>
  <!-- 指示点部分 -->
  <view class="dots-container">
    <view wx:for="{{pagedIcons.length}}" wx:key="index" class="dot {{index === g_quickIndex ? 'active-dot' : ''}}"></view>
  </view>
  <!-- 主要功能区 -->
  <!-- 40为新增tabs高度；10为圆点高度;s_platform_height可能在苹果x以下异常 -->
  <view class="main-content" style="height: {{(c_screen_height + (sn_state?60:0))-(totalNavHeight+s_banner_height+s_quick_entrance_height+s_platform_height+30)}}px;">
    <block wx:if="{{sn_state}}">
      <map-com multiple="false" source="desk" sn="{{sn_specific_value}}" style="width: 100%;" id="myChild" />
    </block>
    <block wx:else>
      <view class="main-content-left" style="background-image: url('{{s_background_image_of_the_tree}}')">
        <scroll-view class="scroll-view-container" scroll-y="true" show-scrollbar="{{false}}" enhanced="{{true}}">
          <tree dataTree="{{g_tree_structure_data}}" selectKey="{{g_th_crrntly_slctd_tr_nd}}" bind:select="handleSwitchChild" isSelectLastNode="true"></tree>
        </scroll-view>
      </view>
      <view class="main-content-right">
        <scroll-view class="scroll-view-container" scroll-y="true" show-scrollbar="{{false}}" enhanced="{{true}}" scroll-with-animation bindscroll="handleBinddragstart" scroll-into-view="{{ scrollIntoId }}">
          <view wx:for="{{g_right_data}}" wx:key="id" wx:for-item="item" wx:key="index" style="background-color:#fff;margin-bottom: 10rpx;border-radius: 10rpx;padding: 10rpx 10rpx;">
            <!-- 第一层数据 -->
            <block wx:if="{{item.isdir == 1}}">
              <view id="{{'section'+item.id}}" class="section" style="font-weight: bold; font-size: 26rpx;color: #333;display: flex;justify-content: flex-start;gap: 10rpx;">{{item.name}}</view>
              <!-- 第二层数据 -->
              <view class="classification-department">
                <block wx:for="{{item.children}}" wx:for-item="item" wx:key="index">
                  <block wx:if="{{item.isdir == 1}}">
                    <view id="{{'section'+item.id}}" class="section" style="display: flex;justify-content: space-between; color: #f0f0f0;font-size: 25rpx;width: 100%;margin: 0;font-weight: bold;">
                      <!-- <view>————</view> -->
                      <text style="color: #7B7C7C;">{{item.name}}</text>
                      <!-- <view>————</view> -->
                    </view>
                    <!-- 第三层数据 -->
                    <block wx:for="{{item.children}}" wx:for-item="item" wx:key="index">
                      <block wx:if="{{item.isdir== 1}}">
                        <view id="{{'section'+item.id}}" class="section" style="font-size: 23rpx; color: #333;min-width: 100rpx;">{{item.name}}</view>
                      </block>
                      <view wx:else class="classification-department-item {{item.isdevelop == 0?'developed':'not-developed'}}" data-item="{{item}}" bindtap="handleJumpPage">
                        <image src="{{c_link}}/img/{{item.icon}}" style="width: 80rpx;height: 80rpx;" />
                        <view style="color: #333;font-size: 23rpx;text-align: left;">{{item.name}}</view>
                      </view>
                    </block>
                  </block>
                  <view wx:else class="classification-department-item {{item.isdevelop == 0?'developed':'not-developed'}}" data-item="{{item}}" bindtap="handleJumpPage">
                    <image src="{{c_link}}/img/{{item.icon}}" style="width: 80rpx;height: 80rpx;" />
                    <view style="color: #333;font-size: 23rpx;text-align: left;">{{item.name}}</view>
                  </view>
                </block>
              </view>
            </block>
            <view wx:else class="classification-department-item {{item.isdevelop == 0?'developed':'not-developed'}}" data-item="{{item}}" bindtap="handleJumpPage" style="position: relative;">
              <image style="width: 80rpx;height: 80rpx;" src="/assets/images/home/01.png" />
              <view style="color: #333;font-size: 23rpx;text-align: left;">
                <text>{{item.name}}</text>
              </view>
            </view>
          </view>
        </scroll-view>

      </view>
    </block>
  </view>
  <!-- 咨询部分 -->
  <view class="float-button" bindtap="handleShowContact">
    <text style="font-size: 24rpx;color: #fff;">咨询</text>
  </view>
  <!-- 咨询弹窗 -->
  <view class="contact-modal" wx:if="{{showModal}}" bindtap="hideContact">

  </view>



  <!-- 专业商务登录弹窗（精致版） -->
  <view class="pop-popup" wx:if="{{showLoginPopup}}">
    <view class="pop-mask"></view>

    <view class="pop-card">
      <!-- 品牌头部（带精致分割） -->
      <view class="pop-header">
        <view class="pop-header-inner">
          <view class="pop-brand-identity">
            <text class="pop-brand-name">智信通 Wiselink</text>
          </view>
          <view class="pop-brand-tag" bindtap="handleLogin">已有账号</view>
        </view>
      </view>

      <view class="pop-content">
        <!-- 标题区域（专业排版） -->
        <view class="pop-title-group">
          <text class="pop-main-title">欢迎回来</text>
          <text class="pop-sub-title">体验更多功能，咨询领取专属权益</text>
        </view>
        <!-- 信任标识区（精致图标+文字） -->
        <view class="pop-trust-container">
          <view class="pop-trust-item">
            <view class="pop-trust-icon">
              <view class="pop-icon-shield"></view>
            </view>
            <text class="pop-trust-text">租车专属方案</text>
          </view>
          <view class="pop-trust-item">
            <view class="pop-trust-icon">
              <view class="pop-icon-check"></view>
            </view>
            <text class="pop-trust-text">网约车服务方案</text>
          </view>
          <view class="pop-trust-item">
            <view class="pop-trust-icon">
              <view class="pop-icon-clock"></view>
            </view>
            <text class="pop-trust-text">私家车定制方案</text>
          </view>
        </view>

        <!-- 按钮组（专业质感按钮） -->
        <view class="pop-button-group">
          <button class="pop-btn-login" class="pop-btn-login" open-type="getPhoneNumber" hover-class="btn_tapcolor" bindgetphonenumber="onGetPhoneNumber">
            <text class="pop-btn-text">体验功能</text>
          </button>
          <button class="pop-btn-consult" bindtap="handleConsult">
            <text class="pop-btn-text">在线咨询</text>
          </button>
        </view>
      </view>
    </view>
  </view>

</view>
<!-- 发送电子钥匙弹窗 -->
<block>
  <view class="modal-mask" wx:if="{{c_send_key_show_momal}}" bindtap="handleHideSengKeyModal"></view>
  <view class="modal-base-map" wx:if="{{c_send_key_show_momal}}">
    <form bindsubmit="handleFormSubmit">
      <view class="modal-container">
        <view class="modal-container-head">
          <text>增设账号和密码</text>
          <image src="/assets/images/home/right_1.png" bindtap="handleHideSengKeyModal" />
        </view>
        <view class="modal-container-middle">
          <view class="middle-form-item">
            <label>手机号</label>
            <view class="modal-form-region">
              <text>{{mobie_info}}</text>
            </view>
          </view>
          <view class="middle-form-item">
            <label>请输入账号</label>
            <view class="modal-form-region">
              <input placeholder="请输入用户名" name='name_1' style="text-align: right;font-size: 28rpx;" />
            </view>
          </view>
          <view class="middle-form-item">
            <label>请输入密码</label>
            <view class="modal-form-region">
              <input placeholder="请输入密码" name='name_3' style="text-align: right;font-size: 28rpx;" />
            </view>
          </view>
          <view class="middle-form-item">
            <label>请再次输入密码</label>
            <view class="modal-form-region">
              <input placeholder="再次请输入密码" name='name_4' style="text-align: right;font-size: 28rpx;" />
            </view>
          </view>
        </view>
        <view class="modal-container-footer">
          <button formType="submit">确认</button>
        </view>
      </view>
    </form>
  </view>
</block>
<custom-tab-bar selectedtext='首页' wx:if="{{!sn_state&&!join_the_group_modal&&!special_area_modal}}" />
<!-- 选择专区 -->
<view class="car-select-mask" wx:if="{{special_area_modal}}">
  <view class="car-select-container">
    <view class="car-select-title">请选择您想关注的专区</view>

    <view class="car-select-grid">
      <checkbox wx:for="{{areaOptions}}" wx:key="value" bindtap="handleMoreToggleSelect" data-value="{{item.id}}" class="car-select-item {{item.isLong ? 'long-item' : ''}}" style=" border: 2rpx solid #ddd; background-color:white; color: {{selected.includes(item.value) ? '#4096ff' : '#666'}};">
        <text>{{item.name}}</text>
      </checkbox>
    </view>

    <view class="car-select-actions">
      <view class="car-select-action-btn car-select-cancel" bindtap="handleCloseMask">取消</view>
      <view class="car-select-action-btn car-select-confirm" bindtap="handleSpecialAreaConfirmSelect">确认</view>
    </view>
  </view>
</view>

<!-- 专区之后的群二维码弹窗 -->
<view class="qr-group-container" wx:if="{{join_the_group_modal}}">
  <view class="qr-group-mask" bindtap="handleQRClose">
    <view class="qr-group-preview-content">
      <image catchtap="handleQRShowImageMask" class="qr-group-preview-img" src="{{personal_qr_code}}" mode="widthFix"></image>
      <text class="qr-group-preview-desc">请点击、长按官方群二维码加入交流群，获取体验权限！</text>
    </view>
  </view>
</view>

<!-- 遮罩层 -->
<view class="identity-modal-mask" wx:if="{{btypeM}}"></view>
<view class="identity-modal-container" wx:if="{{btypeM}}">
  <view class="identity-modal-content">
    <view class="identity-modal-title">请选择您的身份</view>

    <view class="identity-modal-options">
      <!-- 选项1：动态class切换选中状态 -->
      <view class="identity-modal-option {{selectedqu === 1 ? 'identity-modal-option--selected' : ''}}" bindtap="handleSelectOption" data-value="1">
        我是商家
      </view>

      <!-- 选项2：动态class切换选中状态 -->
      <view class="identity-modal-option {{selectedqu === 2 ? 'identity-modal-option--selected' : ''}}" bindtap="handleSelectOption" data-value="2">
        我是个人
      </view>
    </view>

    <!-- 确认按钮：动态class切换可用状态 -->
    <button class="identity-modal-confirm {{selectedqu ? 'identity-modal-confirm--enabled' : 'identity-modal-confirm--disabled'}}" bindtap="handleConfirmSelect" disabled="{{!selected}}">
      确定
    </button>
  </view>

</view>