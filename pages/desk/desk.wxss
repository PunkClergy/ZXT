/* 最外层样式 */
.container {
  width: 100%;
  display: flex;
  flex-direction: column;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  touch-action: pan-x;
  align-items: center;
}

/* 自定义头部部分 */
.custom-navbar {
  width: 100%;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
}

.status-bar {
  width: 100%;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 10px;
  box-sizing: border-box;
}

.title-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 100%;
}

.title-container image {
  width: 40rpx;
  height: 40rpx;
}

.title {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 33rpx;
  color: #010101;
  line-height: 30rpx;
}

/* 轮播图部分 */
.swiper-outer-container {
  width: 100%;
  max-height: 500rpx;
  /* 设置最大高度 */
  overflow: hidden;
  /* 裁剪溢出内容 */
  position: relative;
  background-size: cover;
  background-position: center;
}

.banner-swiper {
  margin: auto;
  width: 96%;
  height: 100% !important;
  /* 强制继承容器高度 */
}

.slide-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  /* 图片裁剪适配 */
  transform: translateZ(0);
  /* 触发硬件加速 */
}


/* 快捷入口 */
.middle {
  width: 96%;
  height: 210px;
  /* 3 行高度 */
  border-top-left-radius: 8rpx;
  border-top-right-radius: 8rpx;
  background-color: #fff;
  padding: 10rpx 0;
  border: 1rpx solid #f1f1f1;
  border-bottom: none;
  margin-top: 5rpx;
}

.middle-swiper {
  width: 100%;
  height: 100%;
}

.middle-swiper-item {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  height: 100%;
}

.middle-swiper-container {
  box-sizing: border-box;
  width: 20%;
  /* 5列：100% / 5 */
  height: 33.333%;
  /* 3行：100% / 3 */
  padding: 5px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.middle-swiper-container-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  /* justify-content: center; */
  width: 100%;
  height: 100%;
}

.middle-swiper-container-icon image {
  width: 43rpx;
  height: 32rpx;
  min-height: 32rpx;
}

.middle-swiper-container-icon text {
  font-size: 22rpx;
  text-align: center;
  line-height: 1.2;
}

/* 指示点 */
.dots-container {
  background: #fff;
  width: 96%;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 10px;
  border-bottom-left-radius: 8rpx;
  border-bottom-right-radius: 8rpx;
  border: 1rpx solid #f1f1f1;
  border-top: none;
}

.dot {
  width: 20px;
  height: 5px;
  background-color: #aaa;
  border-radius: 20%;
  margin: 0 2px;
}

.active-dot {
  background-color: #007aff;
  width: 10px;
}


/* 主要功能区 */
.main-content {
  width: 96%;
  border-radius: 15rpx;
  display: flex;
  margin-top: 10rpx;
  justify-content: space-between;
}

.main-content-left {
  width: 30%;
  background-repeat: no-repeat;
  background-size: cover;
}

.main-content-right {
  width: 68%;
  border-top-right-radius: 8rpx;
  border-bottom-right-radius: 8rpx;
  /* background-color: #fff; */
  /* padding-left: 12rpx;
  padding-right: 12rpx; */
}

.scroll-view-container {
  height: 100%;
}

.classification-department {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.classification-department-item {
  width: 32%;
  box-sizing: border-box;
  margin-bottom: 10px;
  padding: 10rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.classification-department-item image {
  width: 80rpx;
  height: 80rpx;
}

.classification-department-text {
  font-size: 22rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #333333;
}

.developed {
  opacity: 0.5;
}

.not-developed {
  opacity: 1;
}

/* 新增终端tabs */
.terminal-tabs-container {
  background-color: #ecf7fa;
  height: 40px;
  display: flex;
  width: 96%;
  align-items: center;
  justify-content: space-between;
}

.terminal-tabs-view {
  font-size: 26rpx;
  width: 30%;
  height: 40px;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 弹窗蒙版 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 998;
}

.modal-base-map {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 20rpx;
  z-index: 998;
  padding: 20rpx;
}

.modal-container {
  height: 40vh;
  display: flex;
  flex-direction: column;
}

.modal-container-head {
  display: flex;
  justify-content: row;
  justify-content: space-between;
  align-items: center;
  height: 60rpx;
}

.modal-container-head text {
  font-weight: bold;
  font-size: 34rpx;
  color: #333333;
}

.modal-container-head image {
  width: 24rpx;
  height: 24rpx;
}

.modal-container-middle {
  flex: 1;
  overflow-y: auto;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  gap: 20rpx;
}

.modal-container-footer {
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-container-footer button {
  background: linear-gradient(88deg, #1576dc, #1b64b1);
  box-shadow: 0rpx 1rpx 13rpx 0rpx rgba(51, 63, 92, 0.31);
  border-radius: 36rpx;
  font-weight: bold;
  font-size: 34rpx;
  color: #ffffff;
  width: 50%;
  height: 90%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.middle-form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 45rpx;
  width: 90%;
}

.middle-form-item label {
  font-family: PingFang SC;
  font-weight: 600;
  font-size: 28rpx;
  color: #333333;
}

.modal-form-region {
  display: flex;
  gap: 10rpx;
}

.form-item-text {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 4rpx;
  padding: 4rpx 2rpx 4rpx 10rpx;
  gap: 20rpx;
}

.form-item-text text {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #7b7c7c;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item-text image {
  width: 30rpx;
  height: 30rpx;
}

/* 选择专区 */
.car-select-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx;
}

.car-select-container {
  width: 90%;
  max-width: 600rpx;
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.car-select-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f1f1f1;
}

/* 核心：自适应网格，短文本最多3列，长文本1列 */
.car-select-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140rpx, 1fr)); /* 基础列宽，确保不超边框 */
  gap: 20rpx; /* 统一间距 */
  margin-bottom: 35rpx;
  width: 100%; /* 限制网格宽度不超容器 */
  box-sizing: border-box;
}

/* 短文本选项样式 */
.car-select-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 15rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  cursor: pointer;
  transition: all 0.2s ease;
  justify-content: center;
  white-space: nowrap; /* 禁止折行 */
  box-sizing: border-box; /* 确保内边距不撑大容器 */
  overflow: hidden; /* 极端情况防止内容溢出 */
  text-overflow: ellipsis; /* 超宽时显示省略号（备选方案） */
}

/* 长文本选项独占一行 */
.long-item {
  grid-column: 1 / -1; /* 横跨所有列 */
  justify-content: flex-start; /* 长文本左对齐更美观 */
  padding-left: 30rpx; /* 增加左内边距 */
}

.car-select-checkbox {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0; /* 复选框不压缩 */
}

.car-select-check-icon {
  width: 16rpx;
  height: 16rpx;
  background-color: white;
  transform: rotate(45deg);
  border-width: 0 3rpx 3rpx 0;
  border-style: solid;
  border-color: white;
}

.car-select-actions {
  display: flex;
  gap: 20rpx;
}

.car-select-action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 28rpx;
  white-space: nowrap;
}

.car-select-cancel {
  border: 2rpx solid #ddd;
  color: #666;
}

.car-select-confirm {
  background-color: #4096ff;
  color: white;
  box-shadow: 0 4rpx 8rpx rgba(64, 150, 255, 0.3);
}
/* 群二维码后的弹出 */
/* 容器基础样式 */
.qr-group-container {
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 小图预览区域 */
.qr-group-preview {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
}

.qr-group-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  object-fit: cover;
  cursor: pointer;
}

.qr-group-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

/* 遮罩层样式 */
.qr-group-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.9);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* 关闭按钮 */
.qr-group-close {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  color: white;
  font-size: 60rpx;
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 10;
  cursor: pointer;
}

/* 预览内容区 */
.qr-group-preview-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}

.qr-group-preview-img {
  max-width: 90%;
  max-height: 70vh;
  object-fit: contain;
  border-radius: 12rpx;
}

.qr-group-preview-desc {
  color: white;
  font-size: 24rpx;
  text-align: center;
  padding: 0 40rpx;
  line-height: 1.5;
}

/* 咨询部分 */

.float-button {
  position: fixed;
  right: 20rpx;
  top: 70%;
  transform: translateY(-50%);
  width: 80rpx;
  height: 80rpx;
  background-color: #409eff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(64, 158, 255, 0.3);
  z-index: 999;
  transition: all 0.2s ease;
}

.float-button:active {
  transform: translateY(-50%) scale(0.9);
  background-color: #3a8ee6;
  box-shadow: 0 2rpx 8rpx rgba(64, 158, 255, 0.2);
}

.contact-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}



/* 登录 */
/* 弹窗容器 */
.pop-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}

/* 蒙层（高级灰调+细微纹理） */
.pop-mask {
  position: absolute;
  top: 0;
  z-index: -1;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(12, 18, 30, 0.58);
  backdrop-filter: blur(8rpx);
  /* 细微纹理增强质感 */
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E");
}

/* 卡片主体（专业质感+层次） */
.pop-card {
  width: 100%;
  max-width: 580rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 
    0 12rpx 36rpx rgba(0, 0, 0, 0.15),
    0 2rpx 6rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
  animation: pop-cardFadeIn 0.4s cubic-bezier(0.25, 0.9, 0.35, 1);
}

/* 品牌头部（精致分割） */
.pop-header {
  padding: 30rpx 35rpx;
  background-color: #f9fafc;
  border-bottom: 1rpx solid #f0f2f5;
  position: relative;
}

.pop-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 35rpx;
  right: 35rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #e5e6eb, transparent);
}

.pop-header-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pop-brand-identity {
  display: flex;
  align-items: center;
}

.pop-brand-name {
  font-size: 24rpx;
  color: #1d2129;
  font-weight: 600;
  letter-spacing: 1.2rpx;
}

.pop-brand-tag {
  font-size: 20rpx;
  color: #1056c2;
  background-color: #e8f0fe;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

/* 内容区域 */
.pop-content {
  padding: 50rpx 40rpx 45rpx;
  text-align: center;
}

/* 标题样式（专业层级） */
.pop-title-group {
  margin-bottom: 32rpx;
}

.pop-main-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #1d2129;
  display: block;
  margin-bottom: 14rpx;
  letter-spacing: 0.8rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.03);
}

.pop-sub-title {
  font-size: 22rpx;
  color: #6c757d;
  line-height: 1.6;
  padding: 0 20rpx;
}

/* 信任标识区（精致图标） */
.pop-trust-container {
  display: flex;
  justify-content: space-between;
  margin-bottom: 50rpx;
  padding: 0 15rpx;
}

.pop-trust-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 33%;
}

/* 信任图标（精致图形） */
.pop-trust-icon {
  width: 48rpx;
  height: 48rpx;
  background-color: #f0f5ff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  position: relative;
}

.pop-trust-icon::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.3), transparent);
  border-radius: 12rpx;
}

/* 图标图形 */
.pop-icon-shield {
  width: 24rpx;
  height: 28rpx;
  border: 2rpx solid #1056c2;
  border-radius: 2rpx;
  position: relative;
  z-index: 1;
}

.pop-icon-shield::after {
  content: '';
  position: absolute;
  bottom: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 6rpx;
  background-color: #1056c2;
  border-radius: 1rpx;
}

.pop-icon-check {
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid #1056c2;
  border-radius: 50%;
  position: relative;
  z-index: 1;
}

.pop-icon-check::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 8rpx;
  width: 8rpx;
  height: 14rpx;
  border-right: 2rpx solid #1056c2;
  border-bottom: 2rpx solid #1056c2;
  transform: rotate(45deg);
}

.pop-icon-clock {
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid #1056c2;
  border-radius: 50%;
  position: relative;
  z-index: 1;
}

.pop-icon-clock::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 6rpx;
  height: 2rpx;
  background-color: #1056c2;
  border-radius: 1rpx;
  transform-origin: right center;
  transform: rotate(45deg);
}

.pop-icon-clock::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 6rpx;
  width: 8rpx;
  height: 2rpx;
  background-color: #1056c2;
  border-radius: 1rpx;
  transform-origin: right center;
  transform: rotate(135deg);
}

.pop-trust-text {
  font-size: 20rpx;
  color: #495057;
  line-height: 1.5;
  letter-spacing: 0.3rpx;
}

/* 按钮组（专业质感按钮） */
.pop-button-group {
  display: flex;
  gap: 20rpx;
}

/* 登录按钮（主按钮） */
.pop-btn-login {
  flex: 1;
  background: linear-gradient(135deg, #1056c2, #0d47a1);
  color: #ffffff;
  border-radius: 8rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
}

/* 按钮光效（精致细节） */
.pop-btn-login::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.12), transparent);
  transition: all 0.6s ease;
}

.pop-btn-login:active {
  background: linear-gradient(135deg, #0d47a1, #0a3c8a);
  transform: translateY(2rpx);
  box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.pop-btn-login:active::before {
  left: 100%;
}

/* 咨询按钮（次要按钮） */
.pop-btn-consult {
  flex: 1;
  background-color: #ffffff;
  color: #495057;
  border: 1rpx solid #d0d7e3;
  border-radius: 8rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
}

.pop-btn-consult::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(16, 86, 194, 0.05), transparent);
  transition: all 0.6s ease;
}

.pop-btn-consult:active {
  background-color: #f8fafc;
  border-color: #bcc3cd;
  transform: translateY(2rpx);
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.03);
}

.pop-btn-consult:active::before {
  left: 100%;
}

.pop-btn-text {
  /* 按钮文本样式 */
}

/* 清除按钮默认样式 */
button::after {
  border: none;
}

/* 专业感动画 */
@keyframes pop-cardFadeIn {
  from {
    opacity: 0;
    transform: translateY(30rpx) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}


/* 选择上架or个人弹窗 */
/* 基础样式 - 统一前缀 */
.identity-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.8);
  z-index: 1000;
}

.identity-modal-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  display: flex;
  justify-content: center;
  align-items: center;
}

.identity-modal-content {
  width: 80%;
  min-width: 500rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.identity-modal-title {
  font-size: 36rpx;
  text-align: center;
  margin-bottom: 40rpx;
  color: #333;
}

.identity-modal-options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

/* 选项基础样式 */
.identity-modal-option {
  padding: 28rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  text-align: center;
  font-size: 32rpx;
  color: #666;
  cursor: pointer;
  background-color: transparent;
}

/* 选项选中状态样式 */
.identity-modal-option--selected {
  border-color: #07c160;
  color: #07c160;
  background-color: rgba(7, 193, 96, 0.1);
}

/* 按钮基础样式 */
.identity-modal-confirm {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 32rpx;
  border-radius: 8rpx;
  padding: 0;
  color: #fff;
}

/* 按钮可用状态样式 */
.identity-modal-confirm--enabled {
  background-color: #07c160;
}

/* 按钮禁用状态样式 */
.identity-modal-confirm--disabled {
  background-color: #ccc;
}
