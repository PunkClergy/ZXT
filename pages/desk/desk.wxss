/* 最外层样式 */
.container {
  width: 100%;
  display: flex;
  flex-direction: column;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  touch-action: pan-x;
  align-items: center;
}

/* 自定义头部部分 */
.custom-navbar {
  width: 100%;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
}

.status-bar {
  width: 100%;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 10px;
  box-sizing: border-box;
}

.title-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 100%;
}

.title-container image {
  width: 40rpx;
  height: 40rpx;
}

.title {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 33rpx;
  color: #010101;
  line-height: 30rpx;
}

/* 轮播图部分 */
.swiper-outer-container {
  width: 100%;
  max-height: 500rpx;
  /* 设置最大高度 */
  overflow: hidden;
  /* 裁剪溢出内容 */
  position: relative;
  background-size: cover;
  background-position: center;
}

.banner-swiper {
  margin: auto;
  width: 96%;
  height: 100% !important;
  /* 强制继承容器高度 */
}

.slide-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  /* 图片裁剪适配 */
  transform: translateZ(0);
  /* 触发硬件加速 */
}


/* 快捷入口 */
.middle {
  width: 96%;
  height: 210px;
  /* 3 行高度 */
  border-top-left-radius: 8rpx;
  border-top-right-radius: 8rpx;
  background-color: #fff;
  padding: 10rpx 0;
  border: 1rpx solid #f1f1f1;
  border-bottom: none;
  margin-top: 5rpx;
}

.middle-swiper {
  width: 100%;
  height: 100%;
}

.middle-swiper-item {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  height: 100%;
}

.middle-swiper-container {
  box-sizing: border-box;
  width: 20%;
  /* 5列：100% / 5 */
  height: 33.333%;
  /* 3行：100% / 3 */
  padding: 5px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.middle-swiper-container-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  /* justify-content: center; */
  width: 100%;
  height: 100%;
}

.middle-swiper-container-icon image {
  width: 43rpx;
  height: 32rpx;
  min-height: 32rpx;
}

.middle-swiper-container-icon text {
  font-size: 22rpx;
  text-align: center;
  line-height: 1.2;
}

/* 指示点 */
.dots-container {
  background: #fff;
  width: 96%;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 10px;
  border-bottom-left-radius: 8rpx;
  border-bottom-right-radius: 8rpx;
  border: 1rpx solid #f1f1f1;
  border-top: none;
}

.dot {
  width: 20px;
  height: 5px;
  background-color: #aaa;
  border-radius: 20%;
  margin: 0 2px;
}

.active-dot {
  background-color: #007aff;
  width: 10px;
}


/* 主要功能区 */
.main-content {
  width: 96%;
  border-radius: 15rpx;
  display: flex;
  margin-top: 10rpx;
  justify-content: space-between;
}

.main-content-left {
  width: 30%;
  background-repeat: no-repeat;
  background-size: cover;
}

.main-content-right {
  width: 68%;
  border-top-right-radius: 8rpx;
  border-bottom-right-radius: 8rpx;
  /* background-color: #fff; */
  /* padding-left: 12rpx;
  padding-right: 12rpx; */
}

.scroll-view-container {
  height: 100%;
}

.classification-department {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.classification-department-item {
  width: 32%;
  box-sizing: border-box;
  margin-bottom: 10px;
  padding: 10rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.classification-department-item image {
  width: 80rpx;
  height: 80rpx;
}

.classification-department-text {
  font-size: 22rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #333333;
}

.developed {
  opacity: 0.5;
}

.not-developed {
  opacity: 1;
}

/* 新增终端tabs */
.terminal-tabs-container {
  background-color: #ecf7fa;
  height: 40px;
  display: flex;
  width: 96%;
  align-items: center;
  justify-content: space-between;
}

.terminal-tabs-view {
  font-size: 26rpx;
  width: 30%;
  height: 40px;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 弹窗蒙版 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 998;
}

.modal-base-map {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 20rpx;
  z-index: 998;
  padding: 20rpx;
}

.modal-container {
  height: 40vh;
  display: flex;
  flex-direction: column;
}

.modal-container-head {
  display: flex;
  justify-content: row;
  justify-content: space-between;
  align-items: center;
  height: 60rpx;
}

.modal-container-head text {
  font-weight: bold;
  font-size: 34rpx;
  color: #333333;
}

.modal-container-head image {
  width: 24rpx;
  height: 24rpx;
}

.modal-container-middle {
  flex: 1;
  overflow-y: auto;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  gap: 20rpx;
}

.modal-container-footer {
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-container-footer button {
  background: linear-gradient(88deg, #1576dc, #1b64b1);
  box-shadow: 0rpx 1rpx 13rpx 0rpx rgba(51, 63, 92, 0.31);
  border-radius: 36rpx;
  font-weight: bold;
  font-size: 34rpx;
  color: #ffffff;
  width: 50%;
  height: 90%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.middle-form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 45rpx;
  width: 90%;
}

.middle-form-item label {
  font-family: PingFang SC;
  font-weight: 600;
  font-size: 28rpx;
  color: #333333;
}

.modal-form-region {
  display: flex;
  gap: 10rpx;
}

.form-item-text {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 4rpx;
  padding: 4rpx 2rpx 4rpx 10rpx;
  gap: 20rpx;
}

.form-item-text text {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #7b7c7c;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item-text image {
  width: 30rpx;
  height: 30rpx;
}

/* 选择专区 */
.car-select-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx;
}

.car-select-container {
  width: 90%;
  max-width: 600rpx;
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.car-select-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f1f1f1;
}

/* 核心：自适应网格，短文本最多3列，长文本1列 */
.car-select-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140rpx, 1fr)); /* 基础列宽，确保不超边框 */
  gap: 20rpx; /* 统一间距 */
  margin-bottom: 35rpx;
  width: 100%; /* 限制网格宽度不超容器 */
  box-sizing: border-box;
}

/* 短文本选项样式 */
.car-select-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 15rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  cursor: pointer;
  transition: all 0.2s ease;
  justify-content: center;
  white-space: nowrap; /* 禁止折行 */
  box-sizing: border-box; /* 确保内边距不撑大容器 */
  overflow: hidden; /* 极端情况防止内容溢出 */
  text-overflow: ellipsis; /* 超宽时显示省略号（备选方案） */
}

/* 长文本选项独占一行 */
.long-item {
  grid-column: 1 / -1; /* 横跨所有列 */
  justify-content: flex-start; /* 长文本左对齐更美观 */
  padding-left: 30rpx; /* 增加左内边距 */
}

.car-select-checkbox {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0; /* 复选框不压缩 */
}

.car-select-check-icon {
  width: 16rpx;
  height: 16rpx;
  background-color: white;
  transform: rotate(45deg);
  border-width: 0 3rpx 3rpx 0;
  border-style: solid;
  border-color: white;
}

.car-select-actions {
  display: flex;
  gap: 20rpx;
}

.car-select-action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 28rpx;
  white-space: nowrap;
}

.car-select-cancel {
  border: 2rpx solid #ddd;
  color: #666;
}

.car-select-confirm {
  background-color: #4096ff;
  color: white;
  box-shadow: 0 4rpx 8rpx rgba(64, 150, 255, 0.3);
}
/* 群二维码后的弹出 */
/* 容器基础样式 */
.qr-group-container {
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 小图预览区域 */
.qr-group-preview {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
}

.qr-group-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  object-fit: cover;
  cursor: pointer;
}

.qr-group-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

/* 遮罩层样式 */
.qr-group-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.9);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* 关闭按钮 */
.qr-group-close {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  color: white;
  font-size: 60rpx;
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 10;
  cursor: pointer;
}

/* 预览内容区 */
.qr-group-preview-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}

.qr-group-preview-img {
  max-width: 90%;
  max-height: 70vh;
  object-fit: contain;
  border-radius: 12rpx;
}

.qr-group-preview-desc {
  color: white;
  font-size: 24rpx;
  text-align: center;
  padding: 0 40rpx;
  line-height: 1.5;
}