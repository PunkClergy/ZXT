/* 最外层样式 */
.container {
  width: 100%;
  display: flex;
  flex-direction: column;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  touch-action: pan-x;
  align-items: center;
}

/* 自定义头部部分 */
.custom-navbar {
  width: 100%;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
}

.status-bar {
  width: 100%;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 10px;
  box-sizing: border-box;
}

.title-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 100%;
}

.title-container image {
  width: 40rpx;
  height: 40rpx;
}

.title {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 33rpx;
  color: #010101;
  line-height: 30rpx;
}

/* 轮播图部分 */
.swiper-outer-container {
  width: 100%;
  max-height: 500rpx; /* 设置最大高度 */
  overflow: hidden; /* 裁剪溢出内容 */
  position: relative;
  background-size: cover;
  background-position: center;
}

.banner-swiper {
  margin: auto;
  width: 96%;
  height: 100% !important; /* 强制继承容器高度 */
}

.slide-image {
  width: 100%;
  height: 100%;
  object-fit: cover; /* 图片裁剪适配 */
  transform: translateZ(0); /* 触发硬件加速 */
}


/* 快捷入口 */
.middle {
  width: 96%;
  height: 210px; /* 3 行高度 */
  border-top-left-radius: 8rpx;
  border-top-right-radius: 8rpx;
  background-color: #fff;
}
.middle-swiper {
  width: 100%;
  height: 100%;
}
.middle-swiper-item {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  height: 100%;
}
.middle-swiper-container {
  box-sizing: border-box;
  width: 20%; /* 5列：100% / 5 */
  height: 33.333%; /* 3行：100% / 3 */
  padding: 5px;
  display: flex;
  justify-content: center;
  align-items: center;
}
.middle-swiper-container-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}
.middle-swiper-container-icon image {
  width: 43rpx;
  height: 32rpx;
  min-height: 32rpx;
}
.middle-swiper-container-icon text {
  font-size: 22rpx;
  text-align: center;
  line-height: 1.2;
}

/* 指示点 */
.dots-container {
  background: #fff;
  width: 96%;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 10px;
  border-bottom-left-radius: 8rpx;
  border-bottom-right-radius: 8rpx;
}
.dot {
  width: 20px;
  height: 5px;
  background-color: #aaa;
  border-radius: 20%;
  margin: 0 2px;
}
.active-dot {
  background-color: #007aff;
  width: 10px;
}


/* 主要功能区 */
.main-content {
  width: 96%;
  border-radius: 15rpx;
  display: flex;
  margin-top: 10rpx;
}

.main-content-left {
  width: 30%;
  background-repeat: no-repeat;
  background-size: cover;
}

.main-content-right {
  width: 68%;
  border-top-right-radius: 8rpx;
  border-bottom-right-radius: 8rpx;
  /* background-color: #fff; */
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.scroll-view-container {
  height: 100%;
}

.classification-department {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.classification-department-item {
  width: 32%;
  box-sizing: border-box;
  margin-bottom: 10px;
  padding: 10rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.classification-department-item image {
  width: 80rpx;
  height: 80rpx;
}

.classification-department-text {
  font-size: 22rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #333333;
}

.developed {
  opacity: 0.5;
}

.not-developed {
  opacity: 1;
}

/* 新增终端tabs */
.terminal-tabs-container {
  background-color: #ecf7fa;
  height: 40px;
  display: flex;
  width: 96%;
  align-items: center;
  justify-content: space-between;
}

.terminal-tabs-view {
  font-size: 26rpx;
  width: 30%;
  height: 40px;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 弹窗蒙版 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 998;
}

.modal-base-map {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 20rpx;
  z-index: 998;
  padding: 20rpx;
}

.modal-container {
  height: 40vh;
  display: flex;
  flex-direction: column;
}

.modal-container-head {
  display: flex;
  justify-content: row;
  justify-content: space-between;
  align-items: center;
  height: 60rpx;
}

.modal-container-head text {
  font-weight: bold;
  font-size: 34rpx;
  color: #333333;
}

.modal-container-head image {
  width: 24rpx;
  height: 24rpx;
}

.modal-container-middle {
  flex: 1;
  overflow-y: auto;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  gap: 20rpx;
}

.modal-container-footer {
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-container-footer button {
  background: linear-gradient(88deg, #1576dc, #1b64b1);
  box-shadow: 0rpx 1rpx 13rpx 0rpx rgba(51, 63, 92, 0.31);
  border-radius: 36rpx;
  font-weight: bold;
  font-size: 34rpx;
  color: #ffffff;
  width: 50%;
  height: 90%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.middle-form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 45rpx;
  width: 90%;
}

.middle-form-item label {
  font-family: PingFang SC;
  font-weight: 600;
  font-size: 28rpx;
  color: #333333;
}

.modal-form-region {
  display: flex;
  gap: 10rpx;
}

.form-item-text {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 4rpx;
  padding: 4rpx 2rpx 4rpx 10rpx;
  gap: 20rpx;
}

.form-item-text text {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #7b7c7c;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item-text image {
  width: 30rpx;
  height: 30rpx;
}
