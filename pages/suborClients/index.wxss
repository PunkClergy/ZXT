.container {
  width: 100%;
  height: 95vh;
  display: flex;
  flex-direction: column;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  touch-action: pan-x;
  position: relative;
}
.content-container {
  background-color: #fff;
  position: absolute;
  bottom: 10rpx;
  left: 0;
  right: 0;
  width: 96%;
  margin: auto;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
}
.content-scroll {
  flex: 1;
  width: 100%;
}

.content-inner {
  padding: 10rpx;
  display: flex;
  gap: 10rpx;
  flex-direction: column;
}
.card-info-item {
  display: flex;
  justify-content: space-between;
  border-bottom: 1px solid #f0f0f0;
  padding: 20rpx;
}
.card-info-item label {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #333333;
  display: flex;
  gap: 6rpx;
  align-items: flex-start;
  min-width: 20%;
}
.card-info-item label text {
  color: red;
}
.card-info-item-input {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card-info-item-input input {
  text-align: right;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #333333;
}
.card-info-item-input picker text {
  font-size: 26rpx;
  color: #7b7b7b;
}
.card-footer {
  height: 50px;
  color: white;
  text-align: center;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 34rpx;
  color: #ffffff;
}

.card-footer view {
  width: 40%;
  background-color: #2196f3;
  padding: 10rpx;
  background: linear-gradient(88deg, #1576dc, #1b64b1);
  box-shadow: 0rpx 1rpx 13rpx 0rpx rgba(51, 63, 92, 0.31);
  border-radius: 36rpx;
}
.card-info-item-tabs {
}

.card-info-item-tabs-btn {
  display: flex;
  gap: 10rpx;
  justify-content: flex-end;
}

.card-info-item-tabs-btn text {
  border-radius: 7rpx;
  border: 1px solid #7b7c7c;
  font-family: PingFang SC;
  font-weight: 500;
  padding: 6rpx 20rpx;
  font-size: 24rpx;
  color: #333333;
}
.tabs-active {
  background: #1b64b1;
  border-radius: 7rpx;
  color: #ffffff !important;
}
.ladder-container {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.ladder-container-title {
  font-size: 26rpx;
  font-weight: bold;
  padding: 20rpx;
}
.ladder-container-icon {
  display: flex;
  align-items: center;
  gap: 15rpx;
}
.ladder-container-icon image {
  width: 40rpx;
  height: 40rpx;
}
.picker-title {
  font-size: 26rpx;
  color: #7b7c7c;
}
.picker-title-active {
  font-size: 26rpx;
  color: #333;
}
