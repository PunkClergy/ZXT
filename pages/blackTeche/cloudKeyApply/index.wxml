<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">

  <!-- 自定义头部 -->
  <custom-header title="电子钥匙-申请" />
  <view class="content-container" style="top:{{c_statusBarHeight + c_navBarHeight +2}}px; height: {{c_screen_height-(c_statusBarHeight + c_navBarHeight +2)}}px;">
    <view class="card-info">
      <!-- 启用状态 -->
      <view class="card-info-item">
        <label>申请车辆</label>
        <!-- <switch checked="{{enabled}}" bindchange="handleToggleEnable" /> -->
        <radio-group bindchange="handleToggleEnable">
          <radio value="1" checked="{{allowuse == 1}}" style=" transform: scale(0.7);">手动输入</radio>
          <radio value="2" checked="{{allowuse ==2}}" style=" transform: scale(0.7);">车辆选择</radio>
        </radio-group>
      </view>
      <view class="card-info-item">
        <label>车牌号<text>*</text></label>
        <view class="card-info-item-input">
          <block wx:if="{{allowuse ==2}}">
            <label wx:if="{{vehie_items.platenumber}}" bindtap="handleJumpCarList">{{vehie_items.platenumber}}</label>
            <label bindtap="handleJumpCarList" wx:else>请选择车辆</label>
          </block>

          <input placeholder="请输入车牌号" value="{{params.platenumber}}" data-item="platenumber" bindinput="handleBindinput" wx:if="{{allowuse ==1}}" />
        </view>
      </view>
      <view class="card-info-item">
        <label>车辆使用开始时间<text>*</text></label>
        <view class="modal-form-region">
          <picker mode="date" data-index="startDate" bindchange="bindTimeChange">
            <view class="form-item-text">
              <text>{{startDate}}</text>
            </view>
          </picker>
          <picker mode="time" data-index="startTime" bindchange="bindTimeChange">
            <view class="form-item-text">
              <text>{{startTime}}</text>
            </view>
          </picker>
        </view>
      </view>
      <view class="card-info-item">
        <label>车辆使用结束时间<text>*</text></label>
        <view class="modal-form-region">
          <picker mode="date" data-index="endDate" bindchange="bindTimeChange">
            <view class="form-item-text">
              <text>{{endDate}}</text>
            </view>
          </picker>
          <picker mode="time" data-index="endTime" bindchange="bindTimeChange">
            <view class="form-item-text">
              <text>{{endTime}}</text>
            </view>
          </picker>
        </view>
      </view>
      <view class="card-info-item">
        <label>说明<text>*</text></label>
        <view class="card-info-item-input">
          <input placeholder="请输入用车说明" value="{{params.bak}}" data-item="bak" bindinput="handleBindinput" />
        </view>
      </view>
    </view>
    <view class="card-footer">
      <view bindtap="handleSubmit">确认</view>
    </view>
  </view>

</view>