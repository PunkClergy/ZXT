<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="发送电子钥匙" />
  <view class="record-container" style="height: {{c_screen_height-(navBarHeight + statusBarHeight + 10)}}px;margin-top: {{navBarHeight + statusBarHeight}}px;">
    <!-- 切换部分 -->
    <view class="record-tabs" bindtap="handleSwitchTab">
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 1?s_background_tabs_active_1:s_background_tabs_1}}');">发送钥匙</view>
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 2?s_background_tabs_2:s_background_tabs_active_2}}');">{{btnState}}使用记录</view>
    </view>
    <!-- 详情区域部分 -->
    <block wx:if="{{c_activeTab == 1}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
        <block wx:for="{{g_items}}" wx:key="index" wx:for-item="item">
          <view class="content-item">
            <view class="content-item-head">
              <view class="head-left">
                <view class="left-category">
                  <image src="/assets/images/home/car_icon.png" />
                  <text>{{item.platenumber}}</text>
                </view>

                <view class="left-model" wx:if="{{!item.bluetoothKey}}">
                  {{item.vehicleSerialName||'-'}}{{item.vehicleModeName||''}}111
                </view>
              </view>
            </view>
            <view class="content-item-info">
              <view class="info-item  {{item.vin.length > 15 ? 'long-info-item' : ''}}" wx:if="{{!item.bluetoothKey}}">
                <label>车架号 ：</label>
                <text>{{item.vin||'-'}}</text>
              </view>
              <view class="info-item  {{item.xsgw.length > 15 ? 'long-info-item' : ''}}" wx:if="{{!item.bluetoothKey}}">
                <label>油箱容积 ：</label>
                <text>{{item.xsgw?item.xsgw+'L':'-' }}</text>
              </view>
              <view class="info-item  {{item.carOwnerName.length > 15 ? 'long-info-item' : ''}}" wx:if="{{!item.bluetoothKey}}">
                <label>设备平台 ：</label>
                <text>{{item.carOwnerName||'-'}}</text>
              </view>
              <view class="info-item  {{item.sn.length > 15 ? 'long-info-item' : ''}}">
                <label>设备号 ：</label>
                <text>{{item.sn||'-'}}</text>
              </view>

            </view>
            <view class="content-item-footer">
              <view class="footer-left"></view>
              <view class="footer-right">
                <view class="footer-right-btn" data-item="{{item}}" bindtap="handleShowSendKeyModal">
                  <text>发送钥匙</text>
                </view>
              </view>
            </view>
          </view>
        </block>
        <block wx:if="{{g_items.length<1}}">
          <view style="display: flex;justify-content: center;margin-top: 20rpx;font-size: 24rpx;">暂无数据</view>
        </block>
      </scroll-view>
    </block>
    <block wx:if="{{c_activeTab == 2}}">
      <view class="record-tabs-1" style="display: flex;flex-direction: column;">
        <view class="search-box">
          <icon type="search" size="16" class="search-icon" />
          <input placeholder="车牌号/设备号/使用人" class="search-input" bindblur="bindblurSea" />
        </view>
        <!-- 配合 WXML 结构 -->
        <view class="picker-container custom-arrow-picker" style="width: 92%;font-size: 24rpx;display: flex;flex-direction: row;gap: 20rpx;align-items: center;">
          <view>全部状态：</view>
          <view style="display: flex;flex-direction: row;gap: 10rpx;">
            <view bindtap="handleOnStatusChange" data-id="0" style="display: flex;justify-content: center;align-items: center; background-color: {{his_state == 0?'#F56F48':'#7B7C7C'}};border-radius: 24rpx;color: #fff;padding: 10rpx 20rpx">使用中</view>
            <view bindtap="handleOnStatusChange" data-id="1" style="display: flex;justify-content: center;align-items: center; background-color:  {{his_state == 1?'#F56F48':'#7B7C7C'}};border-radius: 24rpx;color: #fff;padding: 10rpx 20rpx">已过期</view>
          </view>

          <!-- <picker mode="selector" range="{{statusList}}" range-key="name" value="{{selectedIndex}}" bindchange="handleOnStatusChange">
            <view class="picker-text {{selectedIndex !== null ? 'picker-active-text' : 'picker-placeholder'}}">
              <text>选择状态：</text> {{statusList[selectedIndex].name || '请选择状态'}}
            </view>
          </picker> -->
        </view>
      </view>
      <view class="tabs-1-conut">共有{{y_total}}条记录</view>
      <scroll-view class="content-container" scroll-y="true" style="top:{{25 + 5 + 8 + 10 + 10 + searchBarHeight}}px;" bindscrolltolower="handleKeyLower" bindrefresherrefresh="handleKeyRefresh" refresher-enabled="true" refresher-triggered="{{y_triggered}}">
        <block wx:for="{{y_items}}" wx:key="index">
          <view class="content-card">
            <view class="card-head">
              <view class="card-head-left">
                <text>{{item.platenumber}}</text>
                <text>{{item.personname}}</text>
                <text class="split-line"></text>
                <text class="phone-text">{{item.mobile}}</text>
              </view>
              <view class="card-head-right">
                <text wx:if="{{item.status}}" style="color: #7b7b7c;">已取消</text>
                <text wx:else>使用中</text>
              </view>
            </view>
            <view class="card-info">
              <!-- <time-line events="{{[{createdate:item.startdate||'-'},{createdate:item.enddate||'-'}]}}" /> -->
              <time-line events="{{[ {createdate: (item.startdate || '-') + ' 至 ' + (item.enddate || '-')}]}}" />
            </view>
            <view class="card-footer1" style="display: flex;justify-content: space-between;">
              <block wx:if="{{!item.status}}">
                <view>
                  <text bindtap="handleEditKey" data-item="{{item}}" style="float: left;">修改</text>
                </view>
                <view sty le="display: flex;flex-direction: row;">
                  <!-- <button data-item="{{item}}" open-type="share" bindtap="handleForward">一键转发</button> -->
                  <text bindtap="handleCopy" data-item="{{item}}">{{ copied ? '已复制' : '复制链接' }}</text>
                  <text bindtap="handleCance" data-item="{{item}}">取消用车</text>
                </view>
              </block>
              <block wx:else>
                <view>
                </view>
                <view style="display: flex;flex-direction: row;">
                  <text bindtap="handleViewPhotos" data-item="{{item}}">查看照片</text>
                </view>
              </block>
            </view>
          </view>
        </block>
      </scroll-view>
    </block>
  </view>
</view>
<!-- 发送电子钥匙弹窗 -->
<block>
  <view class="modal-mask" wx:if="{{c_send_key_show_momal}}" bindtap="handleHideSengKeyModal"></view>
  <view class="modal-base-map" wx:if="{{c_send_key_show_momal}}" style="bottom: {{flag_item_state?250:0}}rpx;">
    <form bindsubmit="handleFormSubmit">
      <view class="modal-container">
        <view class="modal-container-head">
          <text>发送电子钥匙</text>
          <image src="/assets/images/home/right_1.png" bindtap="handleHideSengKeyModal" />
        </view>
        <view class="modal-container-middle">
          <view class="middle-form-item">
            <label>车牌号</label>
            <view class="modal-form-region" style="position: relative;">
              <view wx:if="{{all_send}}" style="position: relative;">
                <input bindfocus="onInputFocus" bindblur="onInputBlur" class="temporary" placeholder="请输入车牌号" name='platenumber' value="{{keyword}}" bindinput="onInputChange" confirm-type="search" bindconfirm="onSearchConfirm" />
                <view wx:if="{{g_items_temporary.length>0 && keyword.trim()!=''}}" class="g_items_temporary">
                  <view wx:for="{{g_items_temporary}}" wx:key="index" bindtap="handleQueRen" data-item="{{item}}" class="item-card-footer">
                    {{item.platenumber}}
                  </view>
                </view>
              </view>
              <text wx:else>{{cellData.platenumber}}</text>
            </view>
          </view>
          <view class="middle-form-item">
            <label>使用人</label>
            <view class="modal-form-region">
              <input bindfocus="onInputFocus" bindblur="onInputBlur" placeholder="请输入使用人" name='personName' style="text-align: right;font-size: 28rpx;" />
            </view>
          </view>
          <view class="middle-form-item">
            <label>手机号</label>
            <view class="modal-form-region">
              <input bindfocus="onInputFocus" bindblur="onInputBlur" placeholder="请输入手机号" name='mobile' style="text-align: right;font-size: 28rpx;" />
            </view>

          </view>
          <view class="middle-form-item">
            <label>开始时间</label>
            <view class="modal-form-region">
              <picker mode="date" data-index="startDate" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{startDate}}</text>
                </view>
              </picker>
              <picker mode="time" data-index="startTime" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{startTime}}</text>
                </view>
              </picker>
            </view>

          </view>

          <view class="middle-form-item">
            <label>结束时间</label>
            <view class="modal-form-region">
              <picker mode="date" data-index="endDate" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{endDate}}</text>
                </view>
              </picker>
              <picker mode="time" data-index="endTime" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{endTime}}</text>
                </view>
              </picker>
            </view>

          </view>
          <view class="middle-form-item">
            <label>是否允许多人使用</label>
            <view class="modal-form-region">
              <picker mode="selector" range="{{pickerList}}" range-key="name" bindchange="handleOnPickerChange" value="{{pickerIndex}}">
                <text>{{pickerList[pickerIndex].name}}</text>
              </picker>

            </view>

          </view>
          <view class="middle-form-item">
            <label>打开方式</label>
            <view class="modal-form-region">
              <radio-group class="radio-group" bindchange="handleOnRadioChange">
                <!-- 开启（是）选项 -->
                <label class="radio-item">
                  <radio value="1" checked="{{radioValue ==1}}" />
                  <text class="radio-label">智车钥</text>
                </label>

                <!-- 关闭（否）选项 -->
                <label class="radio-item">
                  <radio value="0" checked="{{radioValue ==0}}" />
                  <text class="radio-label">智信通</text>
                </label>
              </radio-group>
            </view>

          </view>
          <view class="middle-form-item">
            <label>备注</label>
            <view class="modal-form-region">
              <input placeholder="请输入车位号或车辆位置" name='bak' style="text-align: right;font-size: 28rpx;" />
            </view>
          </view>
        </view>
        <view class="modal-container-footer">
          <button formType="submit">确认</button>
        </view>
      </view>
    </form>
  </view>
</block>
<!-- 修改电子钥匙 -->
<block>
  <view class="modal-mask" wx:if="{{c_edit_key_show_momal}}" bindtap="handleHideEditKeyModal"></view>
  <view class="modal-base-map" wx:if="{{c_edit_key_show_momal}}">
    <form bindsubmit="handleFormEdit">
      <view class="modal-container">
        <view class="modal-container-head">
          <text>修改</text>
          <image src="/assets/images/home/right_1.png" bindtap="handleHideEditKeyModal" />
        </view>
        <view class="modal-container-middle">
          <view class="middle-form-item">
            <label>车牌号</label>
            <view class="modal-form-region">
              {{g_edit_info.platenumber}}
            </view>
          </view>
          <view class="middle-form-item">
            <label>使用人</label>
