<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="加油验证" />
  <view class="record-container" style="height: {{c_screen_height-(navBarHeight + statusBarHeight + 10)}}px;margin-top: {{navBarHeight + statusBarHeight}}px;">
    <!-- 切换部分 -->
    <view class="record-tabs" bindtap="handleSwitchTab">
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 1?s_background_tabs_active_1:s_background_tabs_1}}');">验证记录</view>
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 2?s_background_tabs_2:s_background_tabs_active_2}}');">{{btnState}}新增验证</view>
    </view>
    <!-- 详情区域部分 -->
    <block wx:if="{{c_activeTab == 1}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
        <block wx:for="{{g_items}}" wx:key="index" wx:for-item="item">
          <view class="content-item">
            <view class="content-item-head">
              <view class="head-left">
                <view class="left-category">
                  <image src="/assets/images/home/01.png" />
                </view>
                <view class="left-brand">
                  {{item.platenumber}}
                </view>
              </view>

            </view>
            <view class="content-item-info">
              <view class="info-item {{item.usecarstartdate.length > 15 ? 'long-info-item' : ''}}">
                <label>车辆使用开始时间 ：</label>
                <text>{{item.usecarstartdate||'-'}}</text>
              </view>
              <view class="info-item  {{item.usecarenddate.length > 15 ? 'long-info-item' : ''}}">
                <label>车辆使用结束时间 ：</label>
                <text>{{item.usecarenddate||'-'}}</text>
              </view>
              <view class="info-item  {{item.oildate.length > 15 ? 'long-info-item' : ''}}">
                <label>加油时间 ：</label>
                <text>{{item.oildate||'-'}}</text>
              </view>
              <view class="info-item  {{item.oil.length > 15 ? 'long-info-item' : ''}}">
                <label>加油油量 ：</label>
                <text>{{item.oil||'-'}}</text>
              </view>

              <view class="info-item  {{item.oilcost.length > 15 ? 'long-info-item' : ''}}">
                <label>加油花费 ：</label>
                <text>{{item.oilcost||'-'}}</text>
              </view>
              <view class="info-item  {{item.oilinvoiceimg.length > 15 ? 'long-info-item' : ''}}">
                <label>发票 ：</label>
                <text style="border: 1px solid #f0f0f0;padding: 5rpx 15rpx;border-radius: 8rpx;" src="{{item.oilinvoiceimg}}" class="card-upload" data-item="{{item.oilinvoiceimg}}" bindtap="handlePreviewImage">预览</text>
              </view>
              <view class="info-item  {{item.statusname.length > 15 ? 'long-info-item' : ''}}">
                <label>审批状态 ：</label>
                <text>{{item.statusname||'-'}}</text>
              </view>
              <view class="info-item  {{item.bak.length > 8 ? 'long-info-item' : ''}}">
                <label>说明 ：</label>
                <text>{{item.bak}}</text>
              </view>
            </view>
          </view>
        </block>
      </scroll-view>
    </block>
    <block wx:if="{{c_activeTab == 2}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;">

        <view class="card-info">
          <view class="card-info-item">
            <label>车牌号<text>*</text></label>
            <view class="card-info-item-input">
              <input placeholder="请输入车牌号" value="{{params.platenumber}}" data-item="platenumber" bindinput="handleBindinput" />
            </view>
          </view>
          <!-- <view class="card-info-item">
            <label>车辆使用开始时间<text>*</text></label>
            <view class="modal-form-region">
              <picker mode="date" data-index="startDate" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{startDate}}</text>
                </view>
              </picker>
              <picker mode="time" data-index="startTime" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{startTime}}</text>
                </view>
              </picker>
            </view>
          </view> -->
          <!-- <view class="card-info-item">
            <label>车辆使用结束时间<text>*</text></label>
            <view class="modal-form-region">
              <picker mode="date" data-index="endDate" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{endDate}}</text>
                </view>
              </picker>
              <picker mode="time" data-index="endTime" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{endTime}}</text>
                </view>
              </picker>
            </view>
          </view> -->
          <view class="card-info-item">
            <label>加油时间<text>*</text></label>
            <view class="modal-form-region">
              <picker mode="date" data-index="oilendDate" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{oilendDate}}</text>
                </view>
              </picker>
              <picker mode="time" data-index="oilendTime" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{oilendTime}}</text>
                </view>
              </picker>
            </view>
          </view>
          <!-- 油箱容积 -->
          <view class="card-info-item">
            <label>加油量(L)<text>*</text></label>
            <view class="card-info-item-input">
              <input placeholder="请输入加油量" value="{{params.oil}}" data-item="oil" bindinput="handleBindinput" />
            </view>
          </view>
          <!-- <view class="card-info-item">
            <label>加油花费<text>*</text></label>
            <view class="card-info-item-input">
              <input placeholder="请输入加油花费" value="{{params.oilcost}}" data-item="oilcost" bindinput="handleBindinput" />
            </view>
          </view> --> 
          <!-- 发票 -->
          <!-- <view class="card-info-item">
            <label style="font-size: 26rpx;">上传发票<text>*</text></label>
            <view class="card-info-item-input" style="display: flex; align-items: center;gap: 10rpx;">
              <text src="{{file}}" class="card-upload" wx:if="{{file}}" bindtap="previewImage">预览</text>
              <text class="card-upload" bindtap="chooseImage">{{file?'重新上传':'选择图片/拍照'}}</text>
            </view>
          </view> -->
          <!-- <view class="card-info-item">
            <label>说明<text>*</text></label>
            <view class="card-info-item-input">
              <input placeholder="请输入用车说明" value="{{params.bak}}" data-item="bak" bindinput="handleBindinput" />
            </view>
          </view> -->
        </view>
        <view class="card-footer">
          <view bindtap="handleSubmit">确认</view>
        </view>
      </scroll-view>
    </block>
  </view>
</view>