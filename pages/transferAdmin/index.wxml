<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="移交管理员" />

  <!-- 搜索框 -->
  <view class="search-container" style="height:{{c_searchBarHeight}}px;margin-top: {{c_totalNavHeight}}px;">
    <view class="search-count">
      <text>共有{{g_total}}人员</text>
    </view>
  </view>

  <!-- 主要内容区域 -->
  <scroll-view class="content-container" scroll-y="true" style="top:{{c_statusBarHeight + c_navBarHeight + c_searchBarHeight+2}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
    <block wx:for="{{g_items}}" wx:key="index">
      <view class="content-item">
        <view class="content-item-head">
          <view class="head-left">
            <view class="left-category">
              <text>{{item.username}}</text>
            </view>
          </view>
        </view>
        <view class="content-item-info">
          <view class="info-item  {{item.mobile.length > 8 ? 'long-info-item' : ''}}">
            <label>联系电话 ：</label>
            <text>{{item.mobile||'-' }}</text>
          </view>
          <view class="info-item">
            <label>身份证号 ：</label>
            <text>{{item.idcard||'-'}}</text>
          </view>
          <view class="info-item  {{item.address.length > 15 ? 'long-info-item' : ''}}">
            <label>地址 ：</label>
            <text>{{item.address||'-'}}</text>
          </view>


        </view>
        <view class="content-item-footer">
          <view class="footer-left"></view>
          <view class="footer-right">
            <view class="footer-right-btn" data-item="{{item}}" bindtap="handleSelectJump">
              <text>移交管理员</text>
            </view>
          </view>
        </view>
      </view>
    </block>
  </scroll-view>
</view>