<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="无人门店信息" />
  <!-- index.wxml -->
  <view class="record-container" style="height: {{c_screen_height-(navBarHeight + statusBarHeight)}}px;margin-top: {{navBarHeight + statusBarHeight}}px;">
    <!-- 切换部分 -->
    <view class="record-tabs" bindtap="handleSwitchTab">
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 1?s_background_tabs_active_1:s_background_tabs_1}}');">门店列表</view>
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 2?s_background_tabs_2:s_background_tabs_active_2}}');">{{btnState}}门店</view>
    </view>
    <!-- 详情区域部分 -->
    <block wx:if="{{c_activeTab == 1}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
        <block wx:for="{{g_items}}" wx:key="index">
          <view class="content-item">
            <view class="content-item-head">
              <view class="head-left">
                <view class="left-category">

                  <text>{{item.name}}</text>
                </view>
                <view class="left-split_line"></view>
                <view class="left-model">
                  {{item.rentcompany||'-'}}
                </view>
              </view>
              <view class="head-right" wx:if="{{!(g_flagMulti)}}">
                <image src="/assets/images/home/_edit.png" data-item="{{item}}" bindtap="handleEdit" />
                <image src="/assets/images/home/_delete.png" data-item="{{item}}" bindtap="handleDelete" />
              </view>
            </view>
            <view class="content-item-info">
              <view class="info-item  {{item.jobpersonname.length > 15 ? 'long-info-item' : ''}}">
                <label>负责人 ：</label>
                <text>{{item.jobpersonname||'-'}}</text>
              </view>
              <view class="info-item  {{item.rentprice.length > 15 ? 'long-info-item' : ''}}">
                <label>租赁价格 ：</label>
                <text>{{item.rentprice||'-'}}</text>
              </view>
              <view class="info-item  {{item.internalperformance.length > 15 ? 'long-info-item' : ''}}">
                <label>内部绩效 ：</label>
                <text>{{item.internalperformance||-''}}</text>
              </view>
              <view class="info-item  {{item.parkingstallscount.length > 15 ? 'long-info-item' : ''}}">
                <label>车位数量 ：</label>
                <text>{{item.parkingstallscount||-''}}</text>
              </view>
              <view class="info-item  {{item.signdate.length > 15 ? 'long-info-item' : ''}}">
                <label>签约时间 ：</label>
                <text>{{item.signdate||'-'}}</text>
              </view>
              <view class="info-item  {{item.rentstartdate.length > 15 ? 'long-info-item' : ''}}">
                <label>租赁开始日期 ：</label>
                <text>{{item.rentstartdate||-''}}</text>
              </view>
              <view class="info-item  {{item.rentenddate.length > 15 ? 'long-info-item' : ''}}">
                <label>租赁结束日期 ：</label>
                <text>{{item.rentenddate||-''}}</text>
              </view>

              <view class="info-item  {{item.address.length > 15 ? 'long-info-item' : ''}}">
                <label>地址 ：</label>
                <text>{{item.address||-''}}</text>
              </view>
            </view>
            <view class="content-item-footer" wx:if="{{g_source}}">
              <view class="footer-left"></view>
              <view class="footer-right">
                <view class="footer-right-btn" data-item="{{item}}" bindtap="handleSelectJump" wx:if="{{!g_flagMulti}}">
                  <text>选择此车</text>
                </view>
                <view wx:else>
                  <checkbox-group data-item="{{item}}" bindchange="handleChangeBlack">
                    <checkbox style="transform: scale(0.7);" />
                  </checkbox-group>
                </view>
              </view>
            </view>
          </view>
        </block>

      </scroll-view>
    </block>
    <block wx:if="{{c_activeTab == 2}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;">

        <view class="card-info">
          <!-- 无人门店名称 -->
          <view class="card-info-item">
            <label>无人门店名称<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入无人门店名称" value="{{params.name}}" data-item="name" bindinput="handleBindinput" />
              </view>
            </block>
          </view>
          <!-- 地址 -->
          <view class="card-info-item">
            <label>地址<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入地址" value="{{params.address}}" data-item="address" bindinput="handleBindinput" />
              </view>
            </block>
          </view>

          <!-- 租赁公司 -->
          <view class="card-info-item">
            <label>租赁公司<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入租赁公司名称" value="{{params.rentcompany}}" data-item="rentcompany" bindinput="handleBindinput" />
              </view>
            </block>
          </view>


          <!-- 租赁价格 -->
          <view class="card-info-item">
            <label>租赁价格<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入租赁价格" value="{{params.rentprice}}" data-item="rentprice" bindinput="handleBindinput" />
              </view>
            </block>
          </view>
          <!-- 租赁开始日期 -->
          <view class="card-info-item">
            <label>租赁开始日期<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <picker mode="date"  bindchange="handleOnDateChange2">
                  <view class="picker">{{rentstartdate?rentstartdate:'请选择租赁开始日期'}}</view>
                </picker>
              </view>
            </block>
          </view>

          <!-- 租赁结束日期 -->
          <view class="card-info-item">
            <label>租赁结束日期<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <picker mode="date" bindchange="handleOnDateChange1">
                  <view class="picker">{{rentenddate?rentenddate:'请选择租赁结束日期'}}</view>
                </picker>
              </view>
            </block>
          </view>

          <!-- 负责人姓名 -->
          <view class="card-info-item">
            <label>负责人姓名<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入负责人姓名" value="{{params.jobpersonname}}" data-item="jobpersonname" bindinput="handleBindinput" />
              </view>
            </block>
          </view>

          <!-- 签约时间 -->
          <view class="card-info-item">
            <label>签约时间<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <picker mode="date"  bindchange="handleOnDateChange3">
                  <view class="picker">{{signdate?signdate:'请选择签约日期'}}</view>
                </picker>
              </view>
            </block>
          </view>

          <!-- 内部绩效 -->
          <view class="card-info-item">
            <label>内部绩效<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入内部绩效" value="{{params.internalperformance}}" data-item="internalperformance" bindinput="handleBindinput" />
              </view>
            </block>
          </view>

          <!-- 车位数量 -->
          <view class="card-info-item">
            <label>车位数量<text>*</text></label>
            <block>
              <view class="card-info-item-input">
                <input placeholder="请输入车位数量" value="{{params.parkingstallscount}}" data-item="parkingstallscount" bindinput="handleBindinput" />
              </view>
            </block>
          </view>
        </view>
        <view class="card-footer">
          <view bindtap="handleSubmit">确认{{btnState}}</view>
        </view>
      </scroll-view>
    </block>
  </view>
  <view class="levitation-button" wx:if="{{c_activeTab==1&&g_flagMulti&&g_black.length>0}}" bindtap="handleJumpBlackInfo">
    <text>确定</text>
  </view>
</view>