.video-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.play-area {
  background-color: #000;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
}

.video-player {
  width: 100%;
  height: 400rpx;
}

.btn-group {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.operate-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 32rpx;
  border-radius: 40rpx;
}

.play-btn {
  background-color: #07c160;
  color: #fff;
}

.download-btn {
  background-color: #1677ff;
  color: #fff;
}

.tip-text {
  font-size: 28rpx;
  text-align: center;
  padding: 10rpx;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

.success {
  color: #07c160;
  background-color: #f0f9ff;
}

.error {
  color: #f53f3f;
  background-color: #fff2f2;
}

.info {
  color: #1677ff;
  background-color: #e8f3ff;
}