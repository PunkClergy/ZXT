
 <privacy />
    <view class='control-area'>
    <view class='empty' ></view>
    <button bindtap='oilButtonTap' class='btn-control'>
      <image class='icon-control' src="../../assets/images/desk/oil@2x.png" mode='aspectFit'></image>
      <text>车务整备</text>
    </button>
    <view class='empty'></view>
    <button bindtap='fengkong' class='btn-control'>
      <image class='icon-control' src="../../assets/images/desk/fengkong@2x.png" mode='aspectFit'></image>
      <text>风控及远程控制</text>
    </button>
    </view>

    <view class='control-area'>

