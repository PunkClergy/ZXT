    <button bindtap='carManagerTap' class='btn-control'>
      <image class='icon-control' src="../../assets/images/desk/rent@2x.png" mode='aspectFit'></image>
      <text>车务管理</text>
    </button>

    <view class='empty'></view>
    <button bindtap='oilDeviceTap' class='btn-control'>
      <image class='icon-control' src="../../assets/images/desk/workorder@2x.png" mode='aspectFit'></image>
      <text>油量设备管理</text>
    </button>
    </view>

    <view class='control-area'>
    <view class='empty'></view>
    <button bindtap='buyCount' class='btn-control'>
      <image class='icon-control' src="../../assets/images/desk/workorder@2x.png" mode='aspectFit'></image>
      <text>设备次数购买</text>
    </button>
   
    </view>
  
