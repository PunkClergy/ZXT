/* pages/order/orderList.wxss */
.container {
  width: 100%;
  height: 95vh;
  display: flex;
  flex-direction: column;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  touch-action: pan-x;
}



/* 车辆基本信息Card */
.vehicle-basic-info-container {}

.vehicle-basic-content-item {
  margin: 15rpx;
  background-color: #ffffff;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.vehicle-content-item-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  border-bottom: 1px solid #f0f0f0;
  padding: 10rpx;
}

.vehicle-content-item-info {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  padding: 10rpx;
  gap: 20rpx;
  border-bottom: 1px solid #f0f0f0;
}

.vehicle-head-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.vehicle-left-category {
  display: flex;
  align-items: center;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #333333;
}

.vehicle-left-category image {
  width: 40rpx;
  height: 40rpx;
}

.vehicle-left-brand {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #1B64B1;
  background: #EEF7FF;
  border-radius: 5rpx;
  padding: 0 15rpx;
}

.vehicle-left-model {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #333333;
}

.vehicle-head-right {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
  align-items: center;
  justify-content: center;
}

.vehicle-right-state {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #1B64B1;
  display: flex;
  align-items: center;
}

.vehicle-right-state image {
  width: 30rpx;
  height: 30rpx;
}

.vehicle-info-item {
  flex: 0 0 48%;
  box-sizing: border-box;
  word-wrap: break-word;
  transition: all 0.3s;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #333333;

}

.vehicle-long-info-item {
  flex-basis: 100% !important;
}

/* 油量检测记录部分 */
.record-container {
  margin: 15rpx;
  position: relative;
  border-radius: 8rpx;
  background-color: #fff;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.record-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 25px;
  border-bottom: 1px solid #f0f0f0;
  padding: 10rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #333333;
}

.record-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 15rpx;
}




/* 搜索框容器 */
.search-container {
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #fff;
  flex-direction: column;
  border-radius: 8rpx;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  gap: 30rpx;
  padding: 10px 0px;
  width: 100%;


}

.search-drop {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  width: 90%;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  border: 1px solid #f0f0f0;
  border-radius: 200rpx;
  padding: 8px 12px;
  width: 90%;
}

/* 搜索图标 */
.search-icon {
  margin-right: 8px;
  /* 图标与输入框之间留出间距 */
}

/* 输入框 */
.search-input {
  flex: 1;
  border: none;
  background-color: transparent;
  outline: none;
  font-size: 16px;
}

.picker {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-family: PingFang SC;
}

.picker text {
  font-weight: bold;
  font-size: 26rpx;
  color: #333333;
}


/* 主要内容容器 */
.content-container {
  position: absolute;
  bottom: 10rpx;
  left: 0;
  right: 0;
  overflow-y: auto;
  /* 当内容超出高度时显示滚动条 */

}

/* 内容项 */
.content-item {
  margin: 15rpx;
  background-color: #ffffff;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.content-item-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  border-bottom: 1px solid #f0f0f0;
  padding: 10rpx;
}

.head-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.left-category {
  display: flex;
  align-items: center;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #333333;
}

.left-category image {
  width: 40rpx;
  height: 40rpx;
}

.left-brand {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #1B64B1;
  background: #EEF7FF;
  border-radius: 5rpx;
  padding: 0 15rpx;
}

.left-model {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #333333;
}

.head-right {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
  align-items: center;
  justify-content: center;
}

.right-state {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #F56F48;

}

.right-special-state {
  border-radius: 8rpx;
  border: 1px solid #DD0B2D;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 20rpx;
  color: #DD0B2D;
  padding: 0 15rpx;
}

.content-item-info {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  padding: 10rpx;
  gap: 20rpx;
  border-bottom: 1px solid #f0f0f0;
}

.info-item {
  flex: 0 0 48%;
  box-sizing: border-box;
  word-wrap: break-word;
  transition: all 0.3s;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #333333;

}

.long-info-item {
  flex-basis: 100% !important;
  /* 长内容时占满整行 */
}

.content-item-footer {
  display: flex;
  padding: 10rpx;
  justify-content: space-between;
}

.footer-left {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 24rpx;
  color: #333333;
}

.footer-right {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.footer-right-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 22rpx;
  color: #ffffff;
  background-color: #1B64B1;
  border-radius: 8rpx;
  padding: 4rpx 15rpx;
}

.detection_button {
  position: absolute;
  bottom: 60px;
  width: 100%;
  display: flex;
  justify-content: center;
}

.detection_button text {
  background: linear-gradient(88deg, #1576DC, #1B64B1);
  box-shadow: 0rpx 1rpx 13rpx 0rpx rgba(51, 63, 92, 0.31);
  border-radius: 50rpx;
  font-family: PingFang SC;
  padding: 0rpx 100rpx;
  font-weight: bold;
  font-size: 30rpx;
  color: #FFFFFF;
  line-height: 76rpx;
}

.footer-left--one {
  display: flex;
  align-items: center;
  gap: 50rpx;
}

.footer-left-two {
  display: flex;
  flex-direction: row;
  gap: 50rpx;
  align-items: center;
}

.footer-left-two view {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  align-items: center;
}

.new-modal-content {
  position: fixed;
  left: 25px;
  z-index: 9500;
  overflow: hidden;
  background: #fff;
  border-radius: 20rpx;
  border: 1px solid #f0f0f0;
  display: flex;
  flex-direction: column;
}

.new-modal-head {
  border-bottom: 1px solid #f0f0f0;
  padding: 12rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #333333;
  height: 10%;
}

.new-modal-info {
  padding: 12rpx;
  display: flex;
  flex-grow: 1;
  justify-content: center;
  align-items: center;
  border-bottom: 1px solid #f0f0f0;
}

.new-modal-info radio-group {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.new-modal-info radio-group label {
  display: flex;
  align-items: center;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #333333;
}

.new-modal-info radio-group label radio {
  transform: scale(0.6);
}

.new-modal-info radio-group label input {
  margin-left: 20rpx;
  border: 1px solid #f0f0f0;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.new-modal-footer {
  padding: 12rpx;
  display: flex;
  height: 15%;
  justify-content: space-around;
  align-items: center;
}

.new-modal-footer-btn {
  font-family: PingFang SC;
  font-weight: 600;
  font-size: 24rpx;
  color: #333333;
  border: 1px solid #f0f0f0;
  padding: 8rpx 50rpx;
  border-radius: 8rpx;
}

.blue-button {
  background-color: #5a94ff;
  color: #fff;
}

.oid-text {
  color: #e2b065;
  font-weight: bold;
}


