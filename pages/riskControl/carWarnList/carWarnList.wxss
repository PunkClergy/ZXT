/* pages/order/orderList.wxss */
page {
    background-color: var(--weui-BG-0);
      height: 100%;
    }
.bg-img {
    width: 100%;
    height: 100%;
    position: fixed;
  }
  .giftListView {
    width: 100%;
    bottom: 0;
    top: 0rpx;
    /* background-color: red; */
    position: absolute;
  
  }
  /* cell */
  .item {
    width: 95%;
    height:200rpx;
    position: relative;
    /* background-color: green;
      border-bottom: 1px solid #dadada; */
  }

  .productDesView {
    top: 20rpx;
    left: 20rpx;
    right: 20rpx;
    /* background-color: gray; 
    position: absolute;*/
  }

  .carImage {
    width: 40rpx;
    height: 40rpx;
    margin-top: 10rpx;
    margin-left: 20rpx;
  }

  .productDesText {
    font-size: 26rpx;
    font-weight: bold;
    line-height: 30rpx;
    color:black;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-top: 15rpx;
    margin-left: 10rpx;
    width: 120rpx;
  }

  .lansekuai {
    font-size: 26rpx;
    width: 160rpx;
    height: 40rpx;
    margin-top: 10rpx;
    margin-left: 10rpx;
    line-height: 40rpx;
    text-overflow:ellipsis;
    overflow: hidden;
    white-space:nowrap;
    color: #699ace;
    background-size: 100% 100%;
    background-image: url('data:image/png;base64,');
  }

  .detialText {
    font-size: 26rpx;
    line-height: 30rpx;
    color:#007bff;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-top: 15rpx;
    margin-left: 40rpx;
  }

