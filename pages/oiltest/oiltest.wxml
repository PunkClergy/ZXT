<!-- scroll-top="{{scrollTop}}"  -->
<scroll-view scroll-y="true" style="height:500rpx;background-color:#FAEBD7;margin-top: 10px;" scroll-into-view="{{scrollTo}}">
  <text class='serText' disabled='true' style="font-size: 12px;overflow-wrap: break-word" selectable="true">{{msg}}</text>
  <view id="hiddenview" style="height: 1px;"></view>
</scroll-view>

<scroll-view scroll-y="true" style="height:50rpx;background-color:#FAEBD7;margin-top: 10px;" scroll-into-view="{{scrollTo2}}">
  <text class='serText' disabled='true' style="font-size: 12px;overflow-wrap: break-word" selectable="true">{{msg2}}</text>
  <view id="hiddenview2" style="height: 1px;"></view>
</scroll-view>

</view>