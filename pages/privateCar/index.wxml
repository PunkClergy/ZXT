<view class="container">
  <!-- 顶部导航 -->
  <view class="header">
    <view class="user-info">
      <icon type="success" size="16" color="#07C160" />
      <text>京A78H7E</text>
    </view>
  </view>

  <!-- 车辆模型 -->
  <view class="car-model">
    <view class="car-image">
      <image src="https://p3.dcarimg.com/img/tos-cn-i-dcdx/9624b20fdddd459f8d0c574946831c72~1200x0.png" mode="aspectFit" />
    </view>
    <view class="car-status">
      <view class="status-indicator"></view>
      <text>已连接 · 车辆就绪</text>
    </view>
  </view>

  <!-- 模式切换区域 -->
  <view class="mode-switch">
    <view class="mode-btn {{isAutoMode ? '' : 'active'}}" bindtap="switchMode" data-mode="manual">
      <text>手动模式</text>
    </view>
    <view class="mode-btn {{isAutoMode ? 'active' : ''}}" bindtap="switchMode" data-mode="auto">
      <text>感应模式</text>
    </view>
  </view>

  <!-- 感应距离设置区域（仅在感应模式时显示） -->
  <view class="distance-setting" wx:if="{{isAutoMode}}">
    <view class="section-title">
      <icon type="settings" size="16" color="#07C160" />
      <text>感应距离设置</text>
    </view>
    <slider 
      value="{{distance}}" 
      min="1" 
      max="10" 
      step="1" 
      show-value 
      activeColor="#07C160" 
      bindchange="changeDistance"
    />
    <view class="distance-hint">
      <text>当前设置：{{distance}}米</text>
      <text>当您靠近车辆{{distance}}米内时，车辆将自动解锁</text>
    </view>
  </view>

  <!-- 控制按钮区域 -->
  <view class="controls-section">
    <view class="section-title">
      <icon type="success" size="16" color="#07C160" />
      <text>车辆控制</text>
    </view>
    
    <!-- 横向滚动控制按钮 -->
    <scroll-view 
      class="controls-scroll" 
      scroll-x="true" 
      scroll-left="{{scrollLeft}}" 
      bindscroll="handleScroll"
      scroll-with-animation
    >
      <view class="controls-container">
        <view class="control-btn" bindtap="toggleLock">
          <view class="btn-icon">
            <icon type="success" size="24" color="#07C160" />
          </view>
          <text class="label">开锁</text>
        </view>
        <view class="control-btn" bindtap="controlLights">
          <view class="btn-icon">
            <icon type="cancel" size="24" color="#FA5151" />
          </view>
          <text class="label">关锁</text>
        </view>
        <view class="control-btn" bindtap="findCar">
          <view class="btn-icon">
            <icon type="warn" size="24" color="#FFC300" />
          </view>
          <text class="label">寻车鸣笛</text>
        </view>
        <view class="control-btn" bindtap="openTrunk">
          <view class="btn-icon">
            <icon type="waiting" size="24" color="#10AEFF" />
          </view>
          <text class="label">开启后备箱</text>
        </view>
        <view class="control-btn" bindtap="climateControl">
          <view class="btn-icon">
            <icon type="info" size="24" color="#6467F0" />
          </view>
          <text class="label">空调控制</text>
        </view>
      </view>
    </scroll-view>
    
    <!-- 滑动指示器 -->
    <view class="indicator-container">
      <view class="indicator-dot {{currentPage === 0 ? 'active' : ''}}"></view>
      <view class="indicator-dot {{currentPage === 1 ? 'active' : ''}}"></view>
    </view>
  </view>
</view>