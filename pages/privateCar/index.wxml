<!-- index.wxml -->
<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="私家车开关锁" />
  <!-- 车辆信息卡片 -->
  <view class="vehicle-card" style="margin-top:{{c_statusBarHeight + c_navBarHeight +2}}px;">
    <!-- 车牌与提示信息 -->
    <view class="license-plate-section">
      <text class="license-plate">{{bluetoothData.platenumber}}</text>
      <view class="connection-tip">
        <text class="connection-tip-bold-text">开启</text>
        <text class="connection-tip-small-text">钥匙电源</text>
      </view>
    </view>
    <view class="battery-info">
      <image src="https://k3a.wiselink.net.cn/img/app/blue/battery_{{parsedData.electric||100}}.png" class="battery-icon">
      </image>
      <text class="battery-percent">{{parsedData.voltage||100}}%</text>
    </view>
    <!-- 车辆图片 -->
    <view style="background-image: url('https://k3a.wiselink.net.cn/img/app/blue/privateCar_bg.png')" class="vehicle-image">
      <image src="https://k3a.wiselink.net.cn/img/app/blue/privateCar.png" alt="车辆图片" class="vehicle-img"></image>
    </view>

    <!-- 模式选择器 -->
    <view class="mode-selector">
      <view class="mode-item">
        <image src="https://k3a.wiselink.net.cn/img/app/blue/bluetooth.png" class="mode-icon" style="background: {{connectionState=='未连接'?'#8c8787':''}};"></image>
        <text class="mode-text">蓝牙连接</text>
      </view>
      <view class="mode-item">
        <image src="https://k3a.wiselink.net.cn/img/app/blue/signal.png" class="mode-icon"></image>
        <text class="mode-text">感应模式</text>
      </view>
    </view>
  </view>

  <!-- 控制功能区 - 可滑动分页（每页4个） -->
  <view class="control-section">
    <scroll-view class="control-scroll" scroll-x="true" bindscroll="scrollHandler">
      <view class="control-page" wx:for="{{pages}}" wx:key="index">
        <view class="control-item" wx:for="{{item}}" wx:key="id" bindtap="{{item.evt}}" data-id="{{item.id}}">
          <view class="control-icon">
            <image src="{{item.id === 1 || item.id === 2 ? (item.id === 1 ? parsedData.lock : !parsedData.lock) ? item.ative : item.icon : item.icon}}" class="control-icon-image"></image>
          </view>
          <text class="control-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 改进的分页指示器 -->
    <view class="indicator-container">
      <view class="indicator-track">
        <view class="indicator-thumb" style="width: {{pages.length === 1 ? '100%' : '20%'}}; left: {{indicatorPosition}}"></view>
      </view>
    </view>
  </view>
</view>