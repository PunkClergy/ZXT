<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <!-- 车辆信息卡片 -->
  <view class="vehicle-card">
    <!-- 车牌与提示信息 -->
    <view class="license-plate-section">
      <view style="display: flex;gap: 10rpx;align-items: center;">
        <text class="license-plate" wx:if="{{bluetoothData.platenumber}}">{{bluetoothData.platenumber}}</text>
        <text class="license-plate" bindtap="handleBindVechi" wx:else>请绑定车辆</text>
        <view style="font-size: 24rpx;border:1px solid #ddd;padding: 0 4rpx;border-radius: 8rpx;" bindtap="handleJumpSc">
          <icon type="info" size="14" color="#999"></icon>
          安装使用手册
        </view>
      </view>
      <view class="connection-tip" bindtap="handleSelectJump" style="font-size: 26rpx;">
        详细设置
      </view>



    </view>

    <!-- 车辆图片 -->
    <image class="vehicle-image" src="https://k3a.wiselink.net.cn/img/app/blue/privateCar.png" mode="aspectFit"></image>

    <!-- 电量与蓝牙状态行 -->
    <view class="status-row">
      <view class="battery-status" bindtap="handleVoltage">
        <view class="tips_voltage" wx:if="{{voltage_state}}">设备剩余电量</view>
        <image src="https://k3a.wiselink.net.cn/img/app/blue/battery_{{parsedData.electric||100}}.png" class="battery-icon" />
        <text style="font-size: 28rpx;" wx:if="{{parsedData.voltage}}">{{parsedData.voltage||100}}%</text>
        <text wx:else>--</text>
      </view>
      <view class="bluetooth-status {{connectionState=='已连接' ? 'connected' : 'disconnected'}}" bindtap="handleBlueToothState">
        <view class="tips_bluetooth" wx:if="{{blue_tooth_state}}">{{connectionState=='已连接'?'可开关锁':'设备不可用'}}</view>
        <icon type="{{connectionState=='已连接' ? 'success' : 'warn'}}" size="16" color="{{connectionState=='已连接'?'#2d8cf0':'#000'}}"></icon>
        <text>{{connectionState=='已连接' ? '蓝牙已连接' : '蓝牙已断开'}}</text>
      </view>
    </view>

    <!-- 模式选择器 -->
    <view class="mode-selector">
      <view class="mode-btn {{!parsedData.induction ? 'active' : ''}}" bindtap="handleSetUpInduction" data-mode="manual">
        {{parsedData.induction||'手动模式'}}
      </view>
      <view class="mode-btn {{parsedData.induction ? 'active' : ''}}" bindtap="handleSetUpInduction" data-mode="auto">
        感应模式
      </view>
    </view>
  </view>

  <!-- 控制功能区 - 每行3个大按钮 -->
  <view class="control-section">
    <view class="control-grid">
      <view class="control-item" wx:for="{{controlItems}}" wx:key="id" bindtap="{{item.evt}}" data-id="{{item.id}}" wx:if="{{item.enabled}}">
        <view class="control-icon">
          <image src="{{item.id === 1 || item.id === 2 ? (item.id === 1 ? parsedData.lock : !parsedData.lock) ? item.ative : item.icon : item.icon}}" class="control-icon-image"></image>
        </view>
        <text class="control-name">{{item.name}}</text>
      </view>
    </view>
  </view>
</view>