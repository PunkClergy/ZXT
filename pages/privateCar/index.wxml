<!-- 自定义头部区域：使用custom-header样式 -->
<view class="custom-header" style="padding-top: {{g_height_from_head}}px;padding-left: {{g_capsule_distance_to_the_right}}px; height: {{g_head_height}}px;">
  <view class="custom-header-outer-layer">
    <image class="custom-header-outer-layer-image" src="/assets/images/index/home.png" bindtap="handleBackHome"></image>
    <view style="max-width: 30%;">
      <view class="custom-header-outer-layer-title">私家车</view>
      <view style="color: #bbb;font-size: 20rpx;">智信通手机汽车互联钥匙 <br />mobile car connect key(MCCK)</view>
    </view>

    <view class="custom-header-outer-layer-user_name">
      <block wx:if="{{account}}">
        <text>{{account}}</text>
      </block>
      <block wx:else>
        <text bindtap="handleOnExistingAccountTap">请登录</text>
        <image bindtap="handleOnExistingAccountTap" src="/assets/images/home/right_1.png" />
      </block>
    </view>
  </view>
</view>

<!-- 核心区域：使用container样式 -->
<view class="container" style="height: {{g_screenTotalHeight - g_tabBarHeight - g_head_height}}px; top: {{g_head_height}}px;">
  <view class="top-fixed" style="height: {{topHeight}}px;">
    <view class="top-fixed-basics">
      <view class="top-fixed-basics-plate">
        <view class="top-fixed-basics-plate-text">{{bluetoothData.platenumber}}</view>
        <view class="top-fixed-basics-plate-btn">
          <view class="top-fixed-basics-plate-btn-install">
            <view class="top-fixed-basics-plate-btn-install-iconfont">
              <icon type="warn" size="14" color="#909090"></icon>
            </view>
            <view class="top-fixed-basics-plate-btn-install-tip" bindtap="handleJumpSc">安装说明</view>
          </view>
          <view class="top-fixed-basics-plate-btn-more" data-key="all_settings" bindtap="handleMoreSettings">
            <text>更多设置</text>
          </view>
        </view>
      </view>
      <view class="top-fixed-signal">
        <view class="top-fixed-signal-layar">
          <image src="https://k1sw.wiselink.net.cn/img/app2.0/sjc/battery-01.png" style="width: 46rpx;height: 25rpx;" />
          <view class="top-fixed-signal-layar-info">
            <text class="top-fixed-signal-layar-title">电量：</text>
            <text class="top-fixed-signal-text">{{parsedData.electric||100}}%</text>
          </view>
          <view style="color: #bbb;font-size: 20rpx;text-align: left;">MCCK设备当前电量</view>
        </view>
        <view class="top-fixed-signal-layar">
          <image src="https://k1sw.wiselink.net.cn/img/app2.0/sjc/bluetooth@2x.png" style="width: 30rpx;height: 33rpx;" />
          <view class="top-fixed-signal-layar-info">
            <text class="top-fixed-signal-layar-title">蓝牙状态：</text>
            <text class="top-fixed-signal-text">{{connectionState=='已连接' ? '已连接' : '已断开'}}</text>
          </view>
          <view style="color: #bbb;font-size: 20rpx;text-align: left;">MCCK蓝牙连接，支持手动</view>
        </view>
        <view class="top-fixed-signal-layar">
          <image src="https://k1sw.wiselink.net.cn/img/app2.0/sjc/pair@2x.png" style="width: 33rpx;height: 23rpx;" />
          <view class="top-fixed-signal-layar-info">
            <text class="top-fixed-signal-layar-title">蓝牙配对：</text>
            <text class="top-fixed-signal-text">{{parsedData.pairStatus||'未配对'}}</text>
          </view>
          <view style="color: #bbb;font-size: 20rpx;text-align: left;">MCCK蓝牙配对，感应生效</view>
        </view>
      </view>
    </view>
  </view>
  <view class="middle-scroll">
    <view class="middle-title">
      <view style="display: flex;flex-direction: column;">
        <text>感应开关锁</text>
        <text style="font-size: 20rpx;color: #bbb;">
          开启：实现手机自动感应智信通mcck蓝牙 实现自动开关锁。进行默认设定 ，如果开关门效果不佳 请选择个性设定。
          没有开启：掏出手机--点开智信通wiselink小程序-点击“我的手机汽车钥匙功能”--开门关门
        </text>
      </view>
      <switch bindchange="handleToggleSensorMode" checked="{{parsedData.inductionMode}}" color="#1B64B1" style="transform: scale(0.8)" />
    </view>
    <view class="middle-concrete-content">
      <!-- 开锁感应DIY -->
      <view class="middle-concrete-content-debugging">
        <view class="middle-concrete-content-debugging-title">开锁信号敏感值DIY</view>
        <view style="display: flex;flex-direction: row;align-items: flex-start;justify-content: space-between;">
          <view class="middle-concrete-content-debugging-slider-track tarck-unlock" id="unlockTrack">
            <view class="middle-concrete-content-debugging-slider-fill fill-unlock" wx:if="{{unlock_sensitivity_mark}}" style="width: {{unlockRange+'%'}}"></view>
            <view class="middle-concrete-content-debugging-slider-fill fill-unlock" wx:else style="width: 0%"></view>
            <view class="middle-concrete-content-debugging-car-icon">
              <view class="middle-concrete-content-debugging-info">
                <image class="middle-concrete-content-debugging-info-image" wx:if="{{unlock_sensitivity_mark}}" src="/assets/images/home/car_icon.png"></image>
                <text class="middle-concrete-content-debugging-info-text">开锁敏感值: {{unlock_sensitivity_mark?parsedData.inductionUnlockSignal:'请先设定开关锁默认值'}}</text>
              </view>
            </view>
            <view class="middle-concrete-content-debugging-person-icon" style="{{myPositionStyle}}" wx:if="{{unlock_sensitivity_mark}}">
              <view class="middle-concrete-content-debugging-person-info">
                <image class="middle-concrete-content-debugging-person-info-image" src="https://k1sw.wiselink.net.cn/img/app2.0/sjc/my_place.png" />
                <text class="middle-concrete-content-debugging-info-text">我的位置:{{parsedData.signalValue||50}}</text>
              </view>
            </view>
          </view>
          <view class="middle-concrete-content-debugging-tip-btn  default-mode" bindtap="handleDefaultMode">默认设定：50</view>
        </view>
        <view style="font-size: 20rpx;">开锁个性化设置:{{unlock_sensitivity_mark?(interimvalue||parsedData.inductionUnlockSignal||50):30}}</view>
        <view class="middle-concrete-content-debugging-tip">
          <view class="de-modal-body" style="width:{{unlock_slide_state?'75%':'98%'}}">
            <view class="de-slider-wrap">
              <view class="de-slider-num de-min-num">{{unlock_sensitivity_mark?unlock_min:30}}</view>
              <slider class="de-slider-core" min="{{unlock_sensitivity_mark?unlock_min:30}}" max="{{unlock_sensitivity_mark?unlock_max:100}}" step="{{1}}" value="{{unlock_sensitivity_mark?(interimvalue||parsedData.inductionUnlockSignal||50):30}}" activeColor="#ff5722" backgroundColor="#e5e5e5" block-size="24" bindchanging="handleOnSliderChanging" bindchange="handleOnSliderChange" />
              <view class="de-slider-num de-max-num">{{unlock_sensitivity_mark?unlock_max:100}}</view>
            </view>
          </view>
          <block wx:if="{{unlock_slide_state}}">
            <view class="middle-concrete-content-debugging-tip-gxh personalized-mode" style="border: 1px solid #bbb;background-color: #ffff;color: #000;" bindtap="handlecanceModal">
              取消
            </view>
            <view class="middle-concrete-content-debugging-tip-gxh personalized-mode" bindtap="handlePersonalizedModal">
              确认
            </view>
          </block>
        </view>
        <view class="middle-concrete-content-debugging-tip">若开锁距离效果不佳，可滑动圆形滑块个性化调整敏感值。温馨提示：进行个性化设定前，请先点击开关锁【默认设定】。</view>
      </view>
      <!-- 关锁感应DIY -->
      <view class="middle-concrete-content-debugging">
        <view class="middle-concrete-content-debugging-title">关锁信号敏感值DIY</view>
        <view style="display: flex;flex-direction: row;align-items: flex-start;justify-content: space-between;">
          <view class="middle-concrete-content-debugging-slider-track tarck-lock" id="lockTrack">
            <view class="middle-concrete-content-debugging-slider-fill fill-lock" wx:if="{{lock_sensitivity_mark}}" style="width: {{lockRange+'%'}}"></view>
            <view class="middle-concrete-content-debugging-slider-fill fill-lock" wx:else style="width: 0%"></view>
            <view class="middle-concrete-content-debugging-car-icon">
              <view class="middle-concrete-content-debugging-info">
                <image class="middle-concrete-content-debugging-info-image" wx:if="{{lock_sensitivity_mark}}" src="/assets/images/home/car_icon.png"></image>
                <text class="middle-concrete-content-debugging-info-text">关锁敏感值: {{lock_sensitivity_mark?parsedData.inductionLockSignal:'请先设定开关锁默认值'}}</text>
              </view>
            </view>

            <view class="middle-concrete-content-debugging-person-icon" style="{{myPositionStyle}}" wx:if="{{lock_sensitivity_mark}}">
              <view class="middle-concrete-content-debugging-person-info">
                <image class="middle-concrete-content-debugging-person-info-image" src="https://k1sw.wiselink.net.cn/img/app2.0/sjc/my_place.png" />
                <text class="middle-concrete-content-debugging-info-text">我的位置:{{parsedData.signalValue||50}}</text>
              </view>
            </view>

          </view>
          <view class="middle-concrete-content-debugging-tip-btn  default-mode" bindtap="handleLockDefaultMode">默认设定：60</view>
        </view>
        <view style="font-size: 20rpx;">关锁个性化设置:{{lock_sensitivity_mark?(lock_interimvalue||parsedData.inductionLockSignal||50):30}}</view>
        <view class="middle-concrete-content-debugging-tip">
          <view class="de-modal-body" style="width: {{lock_slide_state?'75%':'98%'}};">
            <view class="de-slider-wrap">
              <view class="de-slider-num de-min-num">{{lock_sensitivity_mark?lock_min:30}}</view>
              <slider class="de-slider-core" min="{{lock_sensitivity_mark?lock_min:30}}" max="{{lock_max}}" step="{{1}}" value="{{lock_sensitivity_mark?(lock_interimvalue||parsedData.inductionLockSignal||70):30}}" activeColor="#ff5722" backgroundColor="#e5e5e5" block-size="24" data-info="lock" bindchanging="handleOnLockSliderChanging" bindchange="handleOnLockSliderChange" />
              <view class="de-slider-num de-max-num">{{lock_max}}</view>
            </view>
          </view>
          <block wx:if="{{lock_slide_state}}">
            <view class="middle-concrete-content-debugging-tip-gxh personalized-mode" style="border: 1px solid #bbb;background-color: #ffff;color: #000;" bindtap="handleLockCanceModal">
              取消
            </view>
            <view class="middle-concrete-content-debugging-tip-gxh personalized-mode" bindtap="handleLockPersonalizedModal">
              确认
            </view>
          </block>
        </view>
        <view class="middle-concrete-content-debugging-tip">若关锁距离效果不佳，可滑动圆形滑块个性化调整敏感值。温馨提示：进行个性化设定前，请先点击开关锁【默认设定】。</view>
      </view>
      <!-- 特殊情况DIY -->
      <view class="middle-concrete-content-debugging">
        <view class="middle-concrete-content-debugging-title">特殊情况DIY</view>

        <view style="display: flex;flex-direction: row;align-items: flex-start;justify-content: space-between;">
          <view class="middle-concrete-content-debugging-slider-track tarck-special" id="unlockTrack" style="width: 100%;">
            <view class="middle-concrete-content-debugging-slider-fill fill-special" wx:if="{{lock_sensitivity_mark}}" style="width: {{lockRange+'%'}}"></view>
            <view class="middle-concrete-content-debugging-slider-fill fill-special" wx:else style="width: 0%"></view>
            <view class="middle-concrete-content-debugging-car-icon">
              <view class="middle-concrete-content-debugging-info">
                <image class="middle-concrete-content-debugging-info-image" wx:if="{{lock_sensitivity_mark}}" src="/assets/images/home/car_icon.png"></image>
                <text class="middle-concrete-content-debugging-info-text">关锁敏感值: {{lock_sensitivity_mark?parsedData.inductionLockSignal:'请先设定开关锁默认值'}}</text>
              </view>
            </view>

            <view class="middle-concrete-content-debugging-person-icon" style="{{myPositionStyle}}" wx:if="{{lock_sensitivity_mark}}">
              <view class="middle-concrete-content-debugging-person-info">
                <image class="middle-concrete-content-debugging-person-info-image" src="https://k1sw.wiselink.net.cn/img/app2.0/sjc/my_place.png" />
                <text class="middle-concrete-content-debugging-info-text">我的位置:{{parsedData.signalValue||50}}</text>
              </view>
            </view>

          </view>
          <!-- <view class="middle-concrete-content-debugging-tip-btn  default-mode" bindtap="handleLockDefaultMode">默认设定：60</view> -->
        </view>
        <view style="font-size: 20rpx;">特殊情况个性化设置:{{lock_sensitivity_mark?(lock_interimvalue||parsedData.inductionLockSignal||50):30}}</view>
        <view class="middle-concrete-content-debugging-tip">
          <view class="de-modal-body" style="width:{{specific_slide_state?'75%':'98%'}}">
            <view class="de-slider-wrap">
              <view class="de-slider-num de-min-num">{{lock_sensitivity_mark?lock_min:30}}</view>
              <slider class="de-slider-core" min="{{lock_sensitivity_mark?lock_min:30}}" max="{{lock_max}}" step="{{1}}" value="{{lock_sensitivity_mark?(lock_interimvalue||parsedData.inductionLockSignal||70):30}}" activeColor="#ff5722" backgroundColor="#e5e5e5" block-size="24" data-info="specific" bindchanging="handleOnLockSliderChanging" bindchange="handleOnLockSliderChange" />
              <view class="de-slider-num de-max-num">{{lock_max}}</view>
            </view>
          </view>
          <block wx:if="{{specific_slide_state}}">
            <view class="middle-concrete-content-debugging-tip-gxh personalized-mode" style="border: 1px solid #bbb;background-color: #ffff;color: #000;" bindtap="handleLockCanceModal">
              取消
            </view>
            <view class="middle-concrete-content-debugging-tip-gxh personalized-mode" bindtap="handleLockPersonalizedModal">
              确认
            </view>
          </block>
        </view>
        <view class="middle-concrete-content-debugging-tip">特殊情况下（如在车内出现频繁开关锁现象），可个性化调整敏感值，建议适当调大数值。该数值调大后，将增加关锁感应距离。温馨提示：进行个性化设定前，请先点击开关锁【默认设定】</view>
      </view>

    </view>
  </view>
  <view class="bottom-fixed" style="height: {{bottomHeight}}px;">
    <view class="bottom-fixed-identification">
      <text class="bottom-fixed-identification-title">我的手机汽车钥匙功能</text>
      <text class="bottom-fixed-identification-more" data-key="key_settings" bindtap="handleMoreSettings">更多钥匙功能 ></text>
    </view>
    <swiper class="bottom-fixed-swiper" indicator-dots="{{true}}">
      <swiper-item class="bottom-fixed-swiper-item" wx:for="{{controlItemspanel}}" wx:key="swiperIndex">
        <!-- 内层循环遍历每个子数组的控制项 -->
        <view class="bottom-fixed-swiper-item-control" wx:for="{{item}}" wx:for-item="control" wx:for-index="controlIndex" wx:key="index" bindtap="{{control.evt}}" data-id="{{control.id}}" wx:if="{{control.enabled}}">
          <image src="{{ (control.id === 1 || control.id === 2) ? ((control.id === 1 ? parsedData.lock : !parsedData.lock) ? control.ative : control.icon) : control.icon }}" style="width: 29rpx; height: 36rpx;" />
          <text>{{control.name}}</text>
        </view>
      </swiper-item>
    </swiper>
  </view>
</view>

<!-- 固定底部导航栏区域：使用tabbar样式，高度自适应 -->
<view class="tabbar" style="height: {{tabBarHeight}}px;">
  <view class="tab-item {{currentTab === index ? 'active' : ''}}" wx:for="{{tabList}}" wx:key="index" bindtap="handleSwitchTabNavigation" data-index="{{index}}">
    <image src="{{'https://k1sw.wiselink.net.cn/img/' + item.selectedIconPath}}" class="tab-icon" mode="widthFix" wx:if="{{currentTab === index}}" />
    <image src="{{'https://k1sw.wiselink.net.cn/img/' + item.iconPath}}" class="tab-icon" mode="widthFix" wx:else />
    <text>{{item.text}}</text>
  </view>
</view>

<!-- 更多功能弹出区域 -->
<view class="modal-container" wx:if="{{modalisShow}}">
  <view class="modal-mask" bindtap="handleMaskTap"></view>
  <view class="modal-content" style="background-color: #EEF1F4;">
    <view style="margin-top: {{g_height_from_head}}px;" bindtap="handleMaskTap">
      <image src="/assets/images/close.png" style="width: 50rpx;height: 50rpx;" />
    </view>
    <view class="modal-body" style="margin-top: {{g_height_from_head}}px;">
      <block wx:if="{{all_settings}}">
        <view class="modal-body-outer-layer-of-card">
          <view class="modal-body-outer-layer-of-card-layer">
            <text class="modal-body-outer-layer-of-card-layer-title">功能设置</text>
          </view>
          <view class="modal-body-outer-layer-of-card-layer-info">
            <view class="modal-body-outer-layer-of-card-layer-settings-item">
              <view class="modal-body-outer-layer-of-card-layer-item-left">
                <text class="modal-body-outer-layer-of-card-layer-item-text">蓝牙断开自动锁车</text>
                <switch checked="{{parsedData.bleDisconnectLock}}" bindchange="handleToBreakOff" color="#07C160" style="transform: scale(0.7)" />
              </view>
              <view class="modal-body-outer-layer-of-card-layer-item-tips">启用后，若在开锁状态下与车载蓝牙断开，设备将自动执行一次关锁</view>
            </view>
            <view class="modal-body-outer-layer-of-card-layer-settings-item">
              <view class="modal-body-outer-layer-of-card-layer-item-left">
                <text class="modal-body-outer-layer-of-card-layer-item-text">锁车自动升窗</text>
                <switch checked="{{parsedData.lockWindowUp}}" bindchange="handleAutoCloseTheWindow" color="#07C160" style="transform: scale(0.7)" />
              </view>
              <view class="modal-body-outer-layer-of-card-layer-item-tips">启用后，按关锁按钮将执行升窗。需要提前配置升窗动作</view>
            </view>
          </view>
        </view>

        <view class="modal-body-outer-layer-of-card">
          <view class="modal-body-outer-layer-of-card-layer">
            <text class="modal-body-outer-layer-of-card-layer-title">按键功能设置</text>
          </view>
          <view class="modal-body-outer-layer-of-card-layer-info">
            <view class="modal-body-outer-layer-of-card-layer-settings-item" wx:for="{{keyInstructions}}" wx:key="index">
              <view class="modal-body-outer-layer-of-card-layer-item-left">
                <text class="modal-body-outer-layer-of-card-layer-item-text">{{item.name}}</text>
                <picker data-item="{{item}}" data-index="{{index}}" bindchange="handleOutputMethod" range="{{key_out_put[index]}}" range-key="name">
                  <view class="modal-body-outer-layer-of-card-layer-picker">
                    <text>{{item.useType}}</text>
                    <image src="/assets/images/home/right_1.png" />
                  </view>
                </picker>
              </view>
            </view>
          </view>
        </view>
      </block>
      <block wx:if="{{key_settings}}">
        <view class="modal-body-outer-layer-of-card">
          <view class="modal-body-outer-layer-of-card-layer">
            <text class="modal-body-outer-layer-of-card-layer-title">更多按键设置</text>
          </view>
          <view class="modal-body-outer-layer-of-card-layer-info">
            <view class="modal-body-outer-layer-of-card-layer-settings-item" wx:for="{{controlItems}}" wx:key="index">
              <view class="modal-body-outer-layer-of-card-layer-item-left">
                <text class="modal-body-outer-layer-of-card-layer-item-text">{{item.name}}</text>
                <switch checked="{{item.enabled}}" bindchange="handleToggleControl" data-index="{{index}}" color="#07C160" style="transform: scale(0.7)" />
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>