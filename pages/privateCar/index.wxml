<view class="container">
  <!-- 顶部导航 -->
  <view class="header">
    <view class="user-info">
      <icon type="success" size="16" color="#07C160" />
      <text>京A78H7E</text>
    </view>
  </view>

  <!-- 车辆模型 -->
  <view class="car-model">
    <view class="car-image">
      <image src="https://p3.dcarimg.com/img/tos-cn-i-dcdx/9624b20fdddd459f8d0c574946831c72~1200x0.png" mode="aspectFit" />
    </view>
    <view class="car-status">
      <view class="status-indicator"></view>
      <text>{{connectionState}}{{connectionState == '已连接'?'· 车辆就绪':''}}</text>
    </view>
  </view>

  <!-- 控制按钮区域 -->
  <view class="controls-section">
    <view class="section-title">
      <icon type="success" size="16" color="#07C160" />
      <text>车辆控制</text>
    </view>

    <!-- 横向滚动控制按钮 -->
    <scroll-view class="controls-scroll" scroll-x="true" scroll-left="{{scrollLeft}}" bindscroll="handleScroll" scroll-with-animation>
      <view class="controls-container">
        <view class="control-btn" bindtap='handleUnlock'>
          <view class="btn-icon">
            <icon type="success" size="24" color="#07C160" />
          </view>
          <text class="label">开锁</text>
        </view>
        <view class="control-btn" bindtap="handleLock">
          <view class="btn-icon">
            <icon type="cancel" size="24" color="#FA5151" />
          </view>
          <text class="label">关锁</text>
        </view>
        <view class="control-btn" bindtap="handleFindCar">
          <view class="btn-icon">
            <icon type="warn" size="24" color="#FFC300" />
          </view>
          <text class="label">寻车鸣笛</text>
        </view>
        <view class="control-btn" bindtap="handleOpenTrunk">
          <view class="btn-icon">
            <icon type="waiting" size="24" color="#10AEFF" />
          </view>
          <text class="label">开启后备箱</text>
        </view>
      </view>
    </scroll-view>
    <view class="section">
      <text class="title">车辆状态解析结果</text>
      <view wx:for="{{parsedData}}" wx:key="index" class="data-item">
        <text>{{item.key}}: </text>
        <text>{{item.value}}</text>
      </view>
    </view>
    <!-- 滑动指示器 -->
    <view class="indicator-container">
      <view class="indicator-dot {{currentPage === 0 ? 'active' : ''}}"></view>
      <view class="indicator-dot {{currentPage === 1 ? 'active' : ''}}"></view>
    </view>
  </view>
</view>