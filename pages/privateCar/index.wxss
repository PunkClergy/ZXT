/* 页面设置 */
page {
  background-color: #F5F7FA;
  padding: 0 16px;
  box-sizing: border-box;
}

/* 主容器 */
.container {
  background-color: #FFFFFF;
  color: #333333;
  display: flex;
  flex-direction: column;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  margin: 16px 0;
  width: 100%;
}

/* 顶部导航 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px 12px;
  border-bottom: 1px solid #F0F0F0;
}

.user-info {
  display: flex;
  align-items: center;
  background-color: #F6FFED;
  padding: 6px 12px;
  border-radius: 30px;
  font-size: 14px;
  color: #07C160;
  border: 1px solid #B7EB8F;
}

.user-info icon {
  margin-right: 6px;
}

/* 车辆模型 */
.car-model {
  text-align: center;
  padding: 0 20px;
  margin-top: 16px;
}

.car-image {
  width: 100%;
  height: 180px;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 12px;
}

.car-image image {
  max-width: 100%;
  max-height: 100%;
  border-radius: 12px;
}

.car-status {
  font-size: 15px;
  color: #666666;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 16px 0;
}

.status-indicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: #07C160;
  margin-right: 8px;
  animation: pulse 1.5s infinite;
}

/* 控制按钮区域 */
.controls-section {
  padding: 16px 12px;
  background-color: #FFFFFF;
  border-top: 1px solid #F0F0F0;
}

.section-title {
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  color: #333333;
  padding-left: 4px;
}

.section-title icon {
  margin-right: 8px;
}

/* 横向滚动控制按钮 */
.controls-scroll {
  width: 100%;
  white-space: nowrap;
  box-sizing: border-box;
}

.controls-container {
  display: inline-flex;
  gap: 12px;
  padding: 0 8px 8px;
  box-sizing: border-box;
}

/* 确保每屏显示4个完整按钮 */
.control-btn {
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 6px 0;
  text-align: center;
  border: 1px solid #F0F0F0;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(25% - 9px); /* 4个按钮平分宽度，减去间距 */
  min-width: 0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  flex-shrink: 0;
  transition: all 0.2s;
  box-sizing: border-box;
}

.control-btn:active {
  background-color: #F7F7F7;
  transform: scale(0.98);
}

.btn-icon {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 8px;
  background-color: rgba(7, 193, 96, 0.08);
}

.control-btn:nth-child(2) .btn-icon {
  background-color: rgba(250, 81, 81, 0.08);
}

.control-btn:nth-child(3) .btn-icon {
  background-color: rgba(255, 195, 0, 0.08);
}

.control-btn:nth-child(4) .btn-icon {
  background-color: rgba(16, 174, 255, 0.08);
}

.control-btn:nth-child(5) .btn-icon {
  background-color: rgba(100, 103, 240, 0.08);
}

.control-btn .label {
  font-size: 13px;
  color: #333333;
  white-space: nowrap;
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

/* 滑动指示器 */
.indicator-container {
  display: flex;
  justify-content: center;
  padding-top: 12px;
  gap: 6px;
}

.indicator-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: #E0E0E0;
  transition: all 0.3s;
}

.indicator-dot.active {
  background-color: #07C160;
  width: 16px;
  border-radius: 4px;
}

/* 动画 */
@keyframes pulse {
  0% {
    opacity: 0.8;
  }
  50% {
    opacity: 1;
  }
  100% {
    opacity: 0.8;
  }
}