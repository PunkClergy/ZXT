.container {
  background: linear-gradient(135deg, #0a192f 0%, #172a45 100%);
  color: #e6f1ff;

  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow-x: hidden;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 0;
  margin-bottom: 20px;
  width: 100%;
}

.logo {
  display: flex;
  align-items: center;
  font-size: 22px;
  font-weight: 700;
}

.logo icon {
  margin-right: 10px;
}

.user-info {
  display: flex;
  align-items: center;
  background: rgba(100, 255, 218, 0.1);
  padding: 8px 15px;
  border-radius: 30px;
  font-size: 14px;
}

.user-info icon {
  margin-right: 8px;
}

.car-model {
  text-align: center;
  margin-bottom: 30px;
  position: relative;
  padding: 0 10px;
  width: 100%;
}

.car-image {
  width: 100%;
  height: 180px;
  margin: 0 auto;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.car-image image {
  width: 100%;
  height: 100%;
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(0, 100, 255, 0.3);
}

.car-name {
  font-size: 26px;
  font-weight: 700;
  margin: 15px 0 5px;
  color: #64ffda;
  text-shadow: 0 0 10px rgba(100, 255, 218, 0.5);
}

.car-status {
  font-size: 16px;
  color: #a8b2d1;
  display: flex;
  justify-content: center;
  align-items: center;
}

.status-indicator {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background-color: #4caf50;
  margin-right: 10px;
  box-shadow: 0 0 8px #4caf50;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% {
    opacity: 0.7;
  }

  50% {
    opacity: 1;
  }

  100% {
    opacity: 0.7;
  }
}

.status-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15px;
  margin-bottom: 30px;
  width: 100%;
}

.card {
  background: rgba(23, 42, 69, 0.7);
  border-radius: 16px;
  padding: 20px;
  text-align: center;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  border: 1px solid rgba(100, 255, 218, 0.1);
}

.card-title {
  font-size: 14px;
  color: #8892b0;
  margin-bottom: 10px;
}

.card-value {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 5px;
  color: #64ffda;
}

.card-unit {
  font-size: 14px;
  color: #a8b2d1;
}

.progress-bar {
  height: 8px;
  background: rgba(136, 146, 176, 0.2);
  border-radius: 4px;
  margin-top: 15px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #64ffda, #00a8ff);
  border-radius: 4px;
}

.controls {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  margin-bottom: 30px;
  width: 100%;
}

.control-btn {
  background: rgba(23, 42, 69, 0.7);
  border-radius: 16px;
  padding: 20px 10px;
  text-align: center;
  border: 1px solid rgba(100, 255, 218, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.control-btn.active {
  background: rgba(100, 255, 218, 0.2);
  border-color: #64ffda;
}

.control-btn icon {
  margin-bottom: 10px;
}

.control-btn .label {
  font-size: 14px;
  color: #e6f1ff;
}

.charging-section {
  background: rgba(23, 42, 69, 0.7);
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 30px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  border: 1px solid rgba(100, 255, 218, 0.1);
  width: 100%;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.section-title {
  font-size: 18px;
  font-weight: 600;
  color: #64ffda;
}

.charging-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15px;
}

.charging-item {
  text-align: center;
  flex: 1;
}

.charging-label {
  font-size: 14px;
  color: #8892b0;
  margin-bottom: 5px;
}

.charging-value {
  font-size: 18px;
  font-weight: 600;
  color: #e6f1ff;
}

.charging-progress {
  height: 10px;
  background: rgba(136, 146, 176, 0.2);
  border-radius: 5px;
  overflow: hidden;
  margin: 20px 0;
}

.charging-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #64ffda, #00a8ff);
  border-radius: 5px;
  position: relative;
}

.charging-progress-fill::after {
  content: '';
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  background: #fff;
}

.charging-stats {
  display: flex;
  justify-content: space-between;
  color: #8892b0;
  font-size: 12px;
  margin-bottom: 20px;
}

.action-btn {
  background: linear-gradient(135deg, #00a8ff, #64ffda);
  color: #0a192f;
  border: none;
  border-radius: 12px;
  padding: 15px 0;
  width: 100%;
  font-size: 16px;
  font-weight: 600;
  transition: all 0.3s;
  box-shadow: 0 4px 15px rgba(0, 168, 255, 0.4);
}

.footer {
  text-align: center;
  padding: 20px 0;
  color: #8892b0;
  font-size: 14px;
  width: 100%;
}

.connection-status {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 10px;
}

.status-dot {
  width: 10px;
  height: 10px;
  background: #4caf50;
  border-radius: 50%;
  margin-right: 8px;
  animation: pulse 1.5s infinite;
}

/* 响应式调整 */
@media (max-width: 480px) {
  .controls {
    grid-template-columns: repeat(2, 1fr);
  }

  .car-name {
    font-size: 22px;
  }

  .card {
    padding: 15px;
  }
}

/* 动画效果 */
@keyframes charging {
  0% {
    box-shadow: 0 0 5px rgba(100, 255, 218, 0.5);
  }

  50% {
    box-shadow: 0 0 20px rgba(100, 255, 218, 0.8);
  }

  100% {
    box-shadow: 0 0 5px rgba(100, 255, 218, 0.5);
  }
}

.charging-animation {
  animation: charging 2s infinite;
}