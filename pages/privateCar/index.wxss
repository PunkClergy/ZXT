page {
  margin: auto;
  background: linear-gradient(to bottom left, #dbe2e8, #fff 100%);
  background-repeat: no-repeat;
  font-family: PingFang SC;
}

/* ========== 1. 头部区域样式 ========== */
/* 自定义头部样式：固定在顶部，占满宽度，使用flex布局居中对齐内容 */
.custom-header {
  width: 100%;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 100;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

/* 头部外层容器样式：flex布局，水平居中对齐，元素间间距10rpx */
.custom-header-outer-layer {
  display: flex;
  /* justify-content: center; */
  align-items: center;
  gap: 25rpx;
}

/* 头部外层容器图片样式：设置固定宽高 */
.custom-header-outer-layer-image {
  width: 45rpx;
  height: 49rpx;
}

/* 头部标题样式：粗体，字体大小36rpx，颜色深灰 */
.custom-header-outer-layer-title {
  font-weight: bold;
  font-size: 36rpx;
  color: #333333;
}

/* 头部用户名容器样式：flex水平排列，对齐项目中心，间距5rpx */
.custom-header-outer-layer-user_name {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 5rpx;
}

/* 用户名文本样式：中等粗细，字体大小28rpx，颜色深灰 */
.custom-header-outer-layer-user_name text {
  font-weight: 500;
  font-size: 28rpx;
  color: #333333;
}

/* 用户名旁图片样式：设置固定宽高 */
.custom-header-outer-layer-user_name image {
  width: 26rpx;
  height: 26rpx;
}

/* 内容区域样式：占满宽度，绝对定位，允许垂直滚动 */
.content {
  width: 100%;
  position: absolute;
  overflow-y: auto;
  box-sizing: border-box;
}



/* ========== 2. 核心内容区域样式 ========== */
/* 核心内容区域样式：上中下三部分全屏占满 */
.container {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  position: relative;
  gap: 20rpx;
  padding: 20rpx;
}

/* 头部内容区 */
.top-fixed {
  flex-shrink: 0;
  text-align: center;
}

.top-fixed-basics {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.top-fixed-basics-plate {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.top-fixed-basics-plate-text {
  font-weight: bold;
  font-size: 44rpx;
  color: #222222;
}

.top-fixed-basics-plate-btn {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  align-items: center;
}

.top-fixed-basics-plate-btn-install {
  border-radius: 12rpx;
  border: 1px solid #909090;
  display: flex;
  flex-direction: row;
  gap: 10rpx;
  padding: 4rpx 10rpx;
  justify-content: center;
  align-items: center;
}

.top-fixed-basics-plate-btn-install-iconfont {
  display: flex;
  align-items: center;
}

.top-fixed-basics-plate-btn-install-tip {
  font-weight: 500;
  font-size: 24rpx;
  color: #777777;
}

.top-fixed-basics-plate-btn-more {
  background: linear-gradient(0deg, #F7F8F8, #DDE1E8, #F7F8F8);
  box-shadow: 0rpx 1rpx 33rpx 0rpx rgba(166, 173, 186, 0.38);
  border-radius: 13rpx;
  border: 1px solid #FFFFFF;
  padding: 5rpx 20rpx;
  display: flex;
  align-items: center;
}

.top-fixed-basics-plate-btn-more text {
  font-weight: bold;
  font-size: 26rpx;
  color: #222222;
}

.top-fixed-signal {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 15rpx;
}

.top-fixed-signal-layar {
  background: #FAFAFA;
  border-radius: 13rpx;
  border: 1px solid #E1E5EA;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
}

.top-fixed-signal-layar-info {
  display: flex;
  flex-direction: row;
}

.top-fixed-signal-layar-title {
  font-size: 22rpx;
  color: #333333;
}

.top-fixed-signal-text {
  font-weight: bold;
  font-size: 22rpx;
  color: #222222;
}

/* 中部区域 */
.middle-scroll {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  background: #FFFFFF;
  border-radius: 13rpx;
  padding: 20rpx;
}

.middle-title {
  border-bottom: 1rpx solid rgba(210, 211, 212, 0.2);
  font-weight: bold;
  font-size: 27rpx;
  color: #232426;
  padding-bottom: 20rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.middle-concrete-content {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.middle-concrete-content-debugging {
  background: #FAFAFA;
  border-radius: 13rpx;
  border: 1px solid #E1E5EA;
  padding: 10rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.middle-concrete-content-debugging-title {
  font-weight: bold;
  font-size: 23rpx;
  color: #BA2B2B;
}

.middle-concrete-content-debugging-slider-track {
  height: 40px;
  border-radius: 10px;
  position: relative;
  margin-bottom: 12px;
  overflow: hidden;
  width: 75%;
}

.tarck-unlock {
  background-color: #f3f4f6;
}

.tarck-lock {
  background-color: #F0EEEE;
}

.tarck-special {
  background-color: #F0eeee;
}

.middle-concrete-content-debugging-slider-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  transition: width 0.1s ease;
  z-index: 1;
  border-bottom-right-radius: 35rpx;
  border-top-right-radius: 35rpx;

}

.fill-unlock {
  background-color: #95D5FE;
  border-right: 6rpx solid #2DA2EC;
}

.fill-lock {
  background-color: #CD80E9;
  border-right: 6rpx solid #7D16A3;
}

.fill-special {
  background-color: #E9808C;
  border-right: 6rpx solid #E53146;
}

.middle-concrete-content-debugging-slider-thumb {
  width: 55px;
  height: 40px;
  border-radius: 50%;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

.middle-concrete-content-debugging-slider-thumb image {
  width: 31rpx;
  height: 33rpx;
}

.middle-concrete-content-debugging-car-icon {
  width: 35%;
  position: absolute;
  /* left: 16px; */
  top: 50%;
  transform: translateY(-50%);
  color: #3b82f6;
  font-size: 20px;
  z-index: 2;
  position: relative;
}

.middle-concrete-content-debugging-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.middle-concrete-content-debugging-info-image {
  width: 40rpx;
  height: 30rpx;
}

.middle-concrete-content-debugging-info-text {
  font-weight: bold;
  font-size: 20rpx;
  color: #333333;
}

.middle-concrete-content-debugging-person-icon {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  color: #6b7280;
  z-index: 1;
}

.middle-concrete-content-debugging-person-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.middle-concrete-content-debugging-person-info-image {
  width: 30rpx;
  height: 32rpx;
}

.middle-concrete-content-debugging-tip {
  font-weight: 500;
  font-size: 18rpx;
  color: #5B5959;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.middle-concrete-content-debugging-tip-btn {
  padding: 15rpx 20rpx;
  border-radius: 15rpx;
  font-size: 20rpx;
  color: #fff;
}

.personalized-mode {
  border: 1px solid #ff5722;
  background-color: #ff5722;
  margin-top: 2rpx;
  padding: 10rpx 10rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  color: #fff;
  text-align: center;
}

.default-mode {
  margin-top: 2rpx;
  border: 1px solid #2DA2EC;
  padding: 20rpx 10rpx;
  background-color: #2DA2EC;
  border-radius: 20rpx;
  font-size: 20rpx;
}

/* 下部区域 */
.bottom-fixed {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  padding: 10rpx 30rpx 0rpx 30rpx;
  background: #FFFFFF;
  box-shadow: 0rpx 1rpx 13rpx 0rpx rgba(177, 177, 177, 0.31);
  border-radius: 13rpx;
  gap: 10rpx;
}

.bottom-fixed-identification {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.bottom-fixed-identification-title {

  font-weight: bold;
  font-size: 27rpx;
  color: #232426;
}

.bottom-fixed-identification-more {
  font-weight: 500;
  font-size: 21rpx;
  color: #5B5959;
}

.bottom-fixed-swiper {
  height: 90%;
}

.bottom-fixed-swiper-item {
  display: flex;
  flex-direction: row;
  flex-direction: row;
  justify-content: flex-start;
  gap: 20rpx;

}

.bottom-fixed-swiper-item-control {
  padding: 20rpx;
  height: 40rpx;
  width: 25%;
  display: flex;
  flex-direction: row;
  gap: 10rpx;
  justify-content: center;
  align-items: center;
  background: linear-gradient(0deg, #F7F8F8, #DDE1E8, #F7F8F8);
  border-radius: 19rpx;
  border: 1px solid #E1E5EA;
}

.bottom-fixed-swiper-item-control text {
  font-weight: bold;
  font-size: 21rpx;
  color: #1A2028;
}


/* ========== 3. 底部 Tabbar 区域样式 ========== */
.tabbar {
  width: 100%;
  background-color: #fff;
  display: flex;
  justify-content: space-around;
  align-items: center;
  position: fixed;
  bottom: 0;
  left: 0;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
  box-sizing: border-box;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 25%;
}

.tab-icon {
  width: 50rpx;
  height: 50rpx;
  margin-bottom: 10rpx;
}

.tab-item text {
  font-size: 24rpx;
  color: #999;
}

.tab-item.active text {
  color: #3498db;
}

/* ========== 4. 更多功能 modal  区域样式 ========== */
.modal-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  transition: opacity 0.3s ease;
}

.modal-content {
  position: absolute;
  top: 0;
  right: 0;
  width: 80%;
  height: 100%;
  background-color: #ffffff;
  box-sizing: border-box;
  padding: 20rpx;
  overflow-y: auto;
  transition: transform 0.3s ease;
  transform: translateX(0);
}

/* 主体内容样式 */
.modal-body {
  font-size: 28rpx;
  color: #666666;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.modal-body-outer-layer-of-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 15rpx;
}

.modal-body-outer-layer-of-card-layer {
  border-bottom: 1rpx solid rgba(238, 241, 244, 0.5);
  padding: 10rpx 0;
}

.modal-body-outer-layer-of-card-layer-title {
  font-size: 26rpx;
  color: #222;
  font-weight: bold;
}

.modal-body-outer-layer-of-card-layer-info {
  padding: 10rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.modal-body-outer-layer-of-card-layer-settings-item {
  display: flex;
  justify-content: space-between;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.middle-concrete-content-debugging-tip-gxh {
  width: 10%;
  margin-left: 5rpx;
}

.modal-body-outer-layer-of-card-layer-item-left {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  width: 100%;
  align-items: center;
}

.modal-body-outer-layer-of-card-layer-item-text {
  font-weight: bold;
  font-size: 24rpx;
  color: #333333;
}

.modal-body-outer-layer-of-card-layer-item-tips {
  display: flex;
  justify-content: flex-start;
  width: 100%;
  font-weight: 500;
  font-size: 20rpx;
  color: #5B5959;
}

.modal-body-outer-layer-of-card-layer-picker {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.modal-body-outer-layer-of-card-layer-picker text {
  font-weight: 500;
  font-size: 22rpx;
  color: #5B5959;
}

.modal-body-outer-layer-of-card-layer-picker image {
  width: 25rpx;
  height: 25rpx;
}

/* 遮罩层样式 */
.de-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  /* 配合z-index确保遮罩在最下层，弹窗在上方 */
  z-index: 998;
}

/* 弹窗主体样式 */
.de-modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  max-width: 600rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-sizing: border-box;
  /* 弹窗层级高于遮罩 */
  z-index: 999;
  /* 轻微阴影增强立体感 */
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

/* 弹窗标题样式 */
.de-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 弹窗内容区域样式 */
.de-modal-body {
  /* margin-bottom: 40rpx; */
  width: 75%;
}

/* 滑块容器：实现最小值、滑块、最大值横向排列 */
.de-slider-wrap {
  display: flex;
  align-items: center;
  width: 100%;
}

/* 滑块数值（最小值/最大值）通用样式 */
.de-slider-num {
  font-size: 24rpx;
  color: #666666;
  width: 60rpx;
  text-align: center;
}

/* 最小值样式（可单独定制，也可复用通用样式） */
.de-min-num {
  color: #999999;
}

/* 最大值样式（可单独定制） */
.de-max-num {
  color: #666666;
}

/* 滑块核心样式：占满中间剩余空间 */
.de-slider-core {
  flex: 1;
  margin: 0 10rpx;
}

/* 弹窗按钮区样式 */
.de-modal-footer {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

/* 弹窗按钮通用样式 */
.de-modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  margin: 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  /* 去除小程序按钮默认的边框和背景 */
  background: none;
  border: none;
}

/* 取消按钮样式（这里根据代码中按钮文字，实际是“确认”按钮，可按需求调整） */
.de-cancel {
  background-color: #f5f5f5;
  color: #333333;
}

/* 确认按钮样式（这里根据代码中按钮文字，实际是“取消”按钮，可按需求调整） */
.de-confirm {
  background-color: #ff5722;
  color: #ffffff;
}

/* 去除小程序按钮默认的伪元素边框 */
button::after {
  border: none;
}

/* 按钮点击态效果 */
.de-cancel:active {
  background-color: #e5e5e5;
}

.de-confirm:active {
  background-color: #e64a19;
}

/* 当前数值显示样式 */
.de-value-display {
  /* 与滑块保持合适间距，提升布局美观度 */
  margin-top: 20rpx;
  /* 文字居中，与滑块对齐 */
  text-align: center;
  /* 字体大小适配弹窗，比滑块数值稍大 */
  font-size: 28rpx;
  /* 突出显示数值，使用品牌主色 */
  color: #ff5722;
  /* 字体加粗，增强视觉识别 */
  font-weight: 600;
  /* 可选：添加轻微的文字阴影，提升层次感 */
  text-shadow: 0 1rpx 2rpx rgba(255, 87, 34, 0.1);
}

/* 新手引导蒙层 */
.guide-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.1);
  z-index: 9999;
  pointer-events: auto;
}

/* 高亮区域（挖空效果） */
.guide-highlight {
  position: absolute;
  background-color: transparent;
  border: 2rpx solid #fff;
  box-shadow: 0 0 0 9999rpx rgba(0, 0, 0, 0.7);
  z-index: 1;
  pointer-events: auto;
  border-radius: 20rpx; /* 匹配按钮圆角 */
}

/* 引导文字 */
.guide-text {
  position: absolute;
  background-color: #fff;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  max-width: 300rpx;
  z-index: 2;
  font-size: 28rpx;
  color: #333;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}
/* 弹窗遮罩 */
.time-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

/* 弹窗内容容器 */
.time-modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  min-width: 90%;
  box-sizing: border-box;
  z-index: 1000;
}

/* 标题样式 */
.time-modal-title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
  color: #333;
}

/* 内容样式 */
.time-modal-desc {
  font-size: 28rpx;
  /* text-align: center; */
  margin-bottom: 40rpx;
  color: #666;
}

/* 按钮组 */
.time-modal-btn-group {
  display: flex;
  justify-content: center;
}

/* 确认按钮 */
.time-modal-confirm-btn {
  width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* 禁用状态的确认按钮 */
.time-modal-confirm-btn[disabled] {
  background-color: #ccc;
  color: #999;
}