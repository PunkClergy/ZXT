/* Base styles for the container */
.container {
  display: flex;
  flex-direction: column;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  padding: 0 20rpx;
}

/* Styles for vehicle card section */
.vehicle-card {
  margin: 30rpx 0;
}

/* License plate section styles */
.license-plate-section {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.license-plate {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

/* Connection tip styles */
.connection-tip {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  color: #666;
}

.connection-tip-bold-text {
  font-size: 40rpx;
  font-weight: bold;
}

.connection-tip-small-text {
  font-size: 20rpx;
}

/* Battery info styles */
.battery-info {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  flex-direction: row;
  gap: 10rpx;
  margin-bottom: 15rpx;
}

.battery-icon {
  width: 36rpx;
  height: 36rpx;
}

.battery-percent {
  font-size: 28rpx;
}

/* Vehicle image styles */
.vehicle-image {
  width: 100%;
  height: 620rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-size: cover;
  background-position: center;
}

.vehicle-img {
  width: 290px;
  height: 154px;
}

/* Mode selector styles */
.mode-selector {
  display: flex;
  justify-content: space-around;
  margin-bottom: 30rpx;
  background-color: #ececec;
  border-radius: 50rpx;
  padding: 20rpx;
}

.mode-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.mode-icon {
  width: 40rpx;
  height: 40rpx;
  background: #54c3f1;
  padding: 15rpx;
  border-radius: 50rpx;
}

.mode-text {
  font-size: 36rpx;
}

/* Control section styles */
.control-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.control-scroll {
  white-space: nowrap;
  width: 100%;
  overflow: hidden;
}
.control-scroll ::-webkit-scrollbar {
  display: none;
}


.control-page {
  display: inline-flex;
  width: 100%;
  justify-content: space-between;
  flex-wrap: wrap;
}

.control-item {
  width: 22%;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
  margin-right: 4%;
}

.control-item:nth-child(4n) {
  margin-right: 0;
}

.control-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 15rpx;
}

.control-icon-image {
  width: 40rpx;
  height: 40rpx;
}

.control-name {
  font-size: 32rpx;
  color: #333;
  text-align: center;
  white-space: nowrap;
}

/* Indicator styles */
.indicator-container {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-top: 30rpx;
}

.indicator-track {
  width: 200rpx;
  height: 10rpx;
  display: flex;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.1);
  border-radius: 5rpx;
  position: relative;
}

.indicator-thumb {
  position: absolute;
  height: 10rpx;
  background-color: #59ab30;
  border-radius: 2rpx;
  transition: left 0.3s ease;
}