<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">

  <!-- 自定义头部 -->
  <custom-header title="留言" />
  <view class="share-container" style="top:{{c_statusBarHeight + c_navBarHeight +15}}px;">
    <textarea bindinput="handleInput" placeholder-style="font-size:26rpx" bindblur="bindTextAreaBlur" auto-height placeholder="请输入留言" style="border:1px solid #ddd;width: 100%;border-radius: 8rpx;min-height: 150rpx;" />
    <button bindtap="handleSubmit" style="width: 100%;height: 80rpx;font-size: 26rpx;background: #1B64B1;display: flex;justify-content: center;align-items: center;color: #fff;">提交</button>
  </view>
</view>