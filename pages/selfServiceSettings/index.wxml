<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="tip">拖动☰排序，点击✖隐藏</text>
    <view class="sort-btn" bindtap="sortListByNumber">🔢 排序</view>
  </view>

  <!-- 滚动区域 -->
  <scroll-view class="scroll-list" scroll-y>
    <movable-area class="movable-area-inner" style="height: {{containerHeight}}px;">
      <movable-view wx:if="{{item.name !='个性化界面 智信通服务  退出登录'}}" wx:for="{{dataList}}" wx:key="id" class="item {{item.isHidden ? 'hidden' : ''}} {{item.id === moveId ? 'dragging' : ''}}" y="{{item.y}}" x="{{item.x}}" direction="all" bindchange="moving" bindtouchend="moved" data-moveid="{{item.id}}" out-of-bounds>
        <!-- 拖拽手柄 -->
        <view class="handle">☰</view>
        <!-- 内容 -->
        <view class="content">{{item.name}}</view>
        <!-- 排序输入框 -->
        <input class="sort-input" type="number" placeholder="1-99" value="{{item.sortNumber}}" bindinput="onSortInput" data-id="{{item.id}}" disabled="{{item.isHidden}}" bindfocus="onInputFocus" bindblur="onInputBlur" />
        <!-- 显示/隐藏按钮 -->
        <view class="toggle-btn" bindtap="toggleItem" data-id="{{item.id}}">
          {{ item.isHidden ? '👁️' : '✖' }}
        </view>
      </movable-view>
    </movable-area>
  </scroll-view>
</view>