.container {
  width: 100%;
  height: 100vh;
  background: linear-gradient(135deg, #f0f5ff, #e6f0ff);
  padding: 20rpx;
  box-sizing: border-box;
  position: relative;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container::before {
  content: '';
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  height: 6rpx;
  background: linear-gradient(to right, #4a9fff, #66b3ff);
  border-radius: 20rpx;
  opacity: 0.8;
  box-shadow: 0 2rpx 8rpx rgba(74, 159, 255, 0.3);
}

/* 头部样式 */
.header {
  height: 90rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  background: #ffffff;
  border-bottom: 1px solid #dbe3e8;
  font-size: 28rpx;
  color: #4a5568;
  background: linear-gradient(to right, #ffffff, #f8fafc);
  z-index: 10;
  position: relative;
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.header .tip {
  color: #64758b;
  font-weight: 500;
}

.sort-btn {
  font-size: 26rpx;
  padding: 10rpx 20rpx;
  background: #4a9fff;
  color: white;
  border-radius: 12rpx;
  box-shadow: 0 6rpx 12rpx rgba(74, 159, 255, 0.25);
  transition: all 0.2s ease;
}

.sort-btn:hover {
  background: #3a8cf0;
  transform: translateY(-1rpx);
}

/* 滚动区域 */
.scroll-list {
  height: calc(100vh - 130rpx);
  background: #f8fafc;
  border-radius: 0 0 24rpx 24rpx;
  overflow: hidden;
  box-shadow: inset 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* movable-area 必须设置高度，由 JS 控制 */
.movable-area-inner {
  width: 100%;
  position: relative;
  overflow: hidden;
}

/* 列表项 */
.item {
  width: calc(100% - 40rpx);
  height: 100rpx;
  margin: 10rpx auto;
  /* 👈 这就是上下间距的来源 */
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.5, 1);
  box-sizing: border-box;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  position: absolute;
  left: 20rpx;
  border: 1px solid #edf2f7;
}

.item.hidden {
  opacity: 0.55;
  background: #f9fafb;
  color: #a0aec0;
  border: 1px dashed #cbd5e1;
  transform: scale(0.98);
}

.item.hidden .content,
.item.hidden .handle,
.item.hidden .sort-input,
.item.hidden .toggle-btn {
  color: #a0aec0;
}

.item.dragging {
  z-index: 1000 !important;
  transform: scale(1.04) translateY(-10rpx);
  box-shadow: 0 30rpx 60rpx rgba(0, 100, 255, 0.2);
  border: 2rpx solid #4a9fff;
  background: #ffffff;
  left: 10rpx;
  width: calc(100% - 20rpx);
  margin: 14rpx auto;
  /* 拖拽时也调整了间距，保持视觉稳定 */
}

.handle {
  width: 50rpx;
  text-align: center;
  font-size: 36rpx;
  color: #a0aec0;
  flex-shrink: 0;
  cursor: grab;
}

.handle:active {
  color: #4a9fff;
  transform: scale(1.1);
}

.content {
  flex: 1;
  text-align: center;
  color: #2d3748;
  background: #ebf4ff;
  padding: 6rpx 16rpx;
  margin: 0 10rpx;
  border-radius: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
  font-size: 28rpx;
  line-height: 40rpx;
  border: 1px solid #bee3f8;
}

.sort-input {
  width: 80rpx;
  height: 50rpx;
  text-align: center;
  font-size: 26rpx;
  border: 1px solid #cbd5e1;
  border-radius: 12rpx;
  margin-right: 12rpx;
  background-color: #ffffff;
  color: #2d3748;
  box-shadow: inset 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

.sort-input[disabled] {
  background-color: #f7fafc;
  color: #a0aec0;
  border-color: #e2e8f0;
}

.sort-input:focus {
  border-color: #4a9fff;
  outline: none;
  box-shadow: 0 0 0 2rpx rgba(74, 159, 255, 0.3);
}

.toggle-btn {
  width: 50rpx;
  text-align: center;
  font-size: 32rpx;
  color: #718096;
  flex-shrink: 0;
  transition: color 0.2s;
}

.toggle-btn:hover {
  color: #e53e3e;
}

.card-footer {
  position: absolute;
  text-align: center;
  /* margin: 0rpx 20rpx 0rpx 0rpx; */
  bottom: 120rpx;
  width: 90%;
  display: flex;
  justify-content: center;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 34rpx;
  color: #ffffff;
}

.card-footer view {
  width: 50%;
  background-color: #2196f3;
  padding: 10rpx;
  background: linear-gradient(88deg, #1576dc, #1b64b1);
  box-shadow: 0rpx 1rpx 13rpx 0rpx rgba(51, 63, 92, 0.31);
  border-radius: 36rpx;
}