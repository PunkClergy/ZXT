<view class="settings-container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="车辆设置" />
  <!-- 设置项列表 -->
  <scroll-view class="settings-list" scroll-y style="margin-top: {{navBarHeight + statusBarHeight}}px;">
    <view class="settings-group">
      <view class="settings-item" data-sign="1" bindtap="navigateToUserInfo">
        <view class="item-left">
          <text class="item-text">感应设置</text>
        </view>
        <image class="item-arrow" src="/assets/images/home/right_1.png"></image>
      </view>
    </view>
    <view class="settings-group">
      <view class="settings-item" data-sign="4" bindtap="navigateToUserInfo">
        <view class="item-left">
          <text class="item-text">个性配置</text>
        </view>
        <image class="item-arrow" src="/assets/images/home/right_1.png"></image>
      </view>
      <view class="settings-item" data-sign="5" bindtap="navigateToUserInfo">
        <view class="item-left">
          <text class="item-text">车辆转移</text>
        </view>
        <image class="item-arrow" src="/assets/images/home/right_1.png"></image>
      </view>
    </view>
  </scroll-view>
</view>