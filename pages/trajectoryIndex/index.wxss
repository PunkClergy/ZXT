/* 页面全局样式重置 */
page {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  background-color: #f5f5f5;
  padding-bottom: env(safe-area-inset-bottom);
}

.container {
  width: 100vw;
  /* 改为 100vh 充满整个视口 */
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  /* 防止内容溢出 */
  overflow: hidden;
}

/* 关键修改：map 改为 flex:1 自适应剩余高度 */
#map {
  width: 100vw;
  flex: 1;
  flex-shrink: 0;
}

.control-bar {
  width: 100%;
  padding: 15rpx 20rpx 25rpx env(safe-area-inset-bottom);
  background-color: #ffffff;
  box-shadow: 0 -2rpx 15rpx rgba(0, 0, 0, 0.05);
  border-radius: 20rpx 20rpx 0 0;
  box-sizing: border-box;
  /* 固定最小高度，保证基础内容可见 */
  min-height: 200rpx;
  /* 控制最大高度 */
  max-height: 40vh;
  /* 不被压缩 */
  flex-shrink: 0;
}

/* 新增滚动容器 */
.control-bar-scroll {
  width: 100%;
  height: 100%;
  /* 内容超出时显示滚动条 */
  overflow-y: auto;
  /* 优化滚动体验 */
  -webkit-overflow-scrolling: touch;
}

.info {
  font-size: 26rpx;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 15rpx;
  color: #333333;
}

.speed-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  line-height: 1.5;
}

.selected-speed {
  color: #1E88E5;
  font-weight: bold;
  margin-left: 8rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid #1E88E5;
  border-radius: 12rpx;
  font-size: 24rpx;
}

slider {
  width: 90%;
  margin: 0 auto;
  height: 35rpx;
}

.control-bar button {
  width: 90%;
  margin: 15rpx auto 0;
  background-color: #1E88E5;
  color: #ffffff;
  border-radius: 8rpx;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 28rpx;
  border: none;
  box-shadow: 0 2rpx 8rpx rgba(30, 136, 229, 0.3);
  position: relative;
  z-index: 10;
}

.control-bar button:active {
  background-color: #1976D2;
  box-shadow: 0 1rpx 4rpx rgba(30, 136, 229, 0.2);
}

@media (max-height: 600px) {
  .control-bar {
    padding: 10rpx 20rpx 20rpx env(safe-area-inset-bottom);
    min-height: 180rpx;
  }

  .info {
    margin-bottom: 10rpx;
    font-size: 24rpx;
  }

  .control-bar button {
    height: 65rpx;
    line-height: 65rpx;
    font-size: 26rpx;
    margin-top: 10rpx;
  }
}

.no-vehicle-selected {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: auto;
  width: 96%;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  border-radius: 8px;
}

.no-vehicle-selected-item {
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #fff;
  margin: 10rpx auto;
  width: 100%;
  border-radius: 8px;
}

.no-vehicle-selected-item-btn {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  width: 90%;
  align-items: center;
  background-color: #EEF7FF;
  padding: 20rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
  color: #1B64B1;
}

/* 车辆基本信息Card */
.vehicle-basic-info-container {}

.vehicle-basic-content-item {
  margin: 15rpx;
  background-color: #ffffff;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.vehicle-content-item-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  border-bottom: 1px solid #f0f0f0;
  padding: 10rpx;
}

.vehicle-content-item-info {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  padding: 10rpx;
  gap: 20rpx;
  border-bottom: 1px solid #f0f0f0;
}

.vehicle-head-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.vehicle-left-category {
  display: flex;
  align-items: center;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #333333;
}

.vehicle-left-category image {
  width: 40rpx;
  height: 40rpx;
}

.vehicle-left-brand {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #1B64B1;
  background: #EEF7FF;
  border-radius: 5rpx;
  padding: 0 15rpx;
}

.vehicle-left-model {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #333333;
}

.vehicle-head-right {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
  align-items: center;
  justify-content: center;
}

.vehicle-right-state {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #1B64B1;
  display: flex;
  align-items: center;
}

.vehicle-right-state image {
  width: 30rpx;
  height: 30rpx;
}

.vehicle-info-item {
  flex: 0 0 48%;
  box-sizing: border-box;
  word-wrap: break-word;
  transition: all 0.3s;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #333333;
}

.vehicle-long-info-item {
  flex-basis: 100% !important;
}

.info-upper {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  position: absolute;
  right: 22rpx;
  bottom: 50rpx;
  
}

.info-upper text {
  background-color: #fff;
  font-family: PingFang SC;
  font-weight: bold;
  width: 126rpx;
  padding: 10rpx 10px;
  font-size: 30rpx;
  color: #000;
  background: rgba(79, 195, 247, 0.9);
  border-radius: 7rpx;
}
/* 弹窗蒙版 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 998;
}

.modal-base-map {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 20rpx;
  z-index: 998;
  padding: 20rpx;
}

.modal-container {
  height: 40vh;
  display: flex;
  flex-direction: column;
}

.modal-container-head {
  display: flex;
  justify-content: row;
  justify-content: space-between;
  align-items: center;
  height: 60rpx;
}

.modal-container-head text {
  font-weight: bold;
  font-size: 34rpx;
  color: #333333;
}

.modal-container-head image {
  width: 24rpx;
  height: 24rpx;
}

.modal-container-middle {
  flex: 1;
  overflow-y: auto;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  gap: 40rpx;
}

.modal-container-footer {
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-container-footer button {
  background: linear-gradient(88deg, #1576DC, #1B64B1);
  box-shadow: 0rpx 1rpx 13rpx 0rpx rgba(51, 63, 92, 0.31);
  border-radius: 36rpx;
  font-weight: bold;
  font-size: 34rpx;
  color: #FFFFFF;
  width: 50%;
  height: 90%;
  display: flex;
  justify-content: center;
  align-items: center;

}

.middle-form-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 45rpx;
}

.middle-form-item label {
  font-family: PingFang SC;
  font-weight: 600;
  font-size: 28rpx;
  color: #333333;

}

.modal-form-region {
  display: flex;
  gap: 10rpx;
}

.form-item-text {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 4rpx;
  padding: 4rpx 2rpx 4rpx 10rpx;
  gap: 20rpx;
}

.form-item-text text {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #7B7C7C;
  border-bottom: 1rpx solid #f0f0f0;

}

.form-item-text image {
  width: 30rpx;
  height: 30rpx;
}

.time-frame {
  display: flex;
  position: fixed;
  left: 55%;
  transform: translateX(-50%);
  background-color: rgba(0, 0, 0, 0.5);
  /* 黑色背景，50% 透明 */
  color: #fff;
  padding: 5rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 75%;
}