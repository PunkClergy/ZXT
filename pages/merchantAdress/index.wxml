<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">

  <!-- 自定义头部 -->
  <custom-header title="智信通开票信息" />
  <view class="content-container" style="top:{{c_statusBarHeight + c_navBarHeight +2}}px; height: {{c_screen_height-(c_statusBarHeight + c_navBarHeight +2)}}px;">
    <view class="card-info">
      <view wx:for="{{allRes}}" wx:key="index" style="border-bottom: 1rpx solid #f0f0f0;">
        <view class="card-info-item">
          <label style="font-weight: bold;">公司信息</label>
        </view>
        <view class="card-info-item">
          <label>{{item.tel}}</label>
        </view>
        <view class="card-info-item">
          <label>{{item.name}}</label>
        </view>
        <view class="card-info-item">
          <label>{{item.address}}</label>
        </view>
        <view class="card-info-item">
          <label style="font-weight: bold;">开票信息</label>
        </view>
        <view class="card-info-item">
          <label>统一社会信用代码：{{item.taxnumber}}</label>
        </view>
        <view class="card-info-item">
          <label>开户支行：{{item.depositbank}}</label>
        </view>
        <view class="card-info-item">
          <label>开户账号：{{item.bankaccounts}}</label>
        </view>
      </view>
    </view>
  </view>
</view>