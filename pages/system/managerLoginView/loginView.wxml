<view class='container'>
  <image src="{{logoSrc}}" style="width: 191rpx;height: 191rpx;margin-top: 30rpx;"></image>
  <view style="color: white;font-size:50rpx;font-weight: bold;"> </view>
  <view style="color: white;font-size:50rpx;">智信通wiselink </view>
  <form>

    <view class='input_views'>
      <view class='input_item'>
        <view class='input_title'>邀请码</view>
        <input class='input_v' value="{{invit_code}}" placeholder='邀请码' disabled></input>
      </view>

      <view class='input_item'>
        <view class='input_title'>账号</view>
        <input class='input_v' placeholder='请输入账号或手机号' bindinput='accountInput' maxlength='11'></input>
      </view>


      <view class='input_item'>
        <view class='input_title'>密码</view>
        <input class='input_v' placeholder='请输入' bindinput='vericodeInput' password="true"></input>
      </view>

    </view>

    <button class='login_btn' hover-class="btn_tapcolor" bindtap='loginBtnTap'>登录</button>
    <button open-type="getPhoneNumber" class='login_btn' hover-class="btn_tapcolor" bindgetphonenumber="onGetPhoneNumber">快捷登录</button>
  </form>
</view>