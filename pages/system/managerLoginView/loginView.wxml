<!-- index.wxml -->
<view class="container">
  <!-- 上部分：登录区域 -->
  <view class="login-area">
    <!-- Logo 区域 -->
    <view class="logo-container fade-in">
      <view class="logo-wrapper">
        <image src="{{logoSrc}}" class="logo-img" />
        <text class="logo-text">智信通wiselink</text>
      </view>
      <text class="slogan">领先的出行技术服务商</text>
    </view>

    <!-- 登录方式选择 -->
    <view class="radio-container">
      <radio-group class="radio-group" bindchange="radioChange">
        <label class="radio-label">
          <radio value="1" checked color="#4cd964" class="radio-item" />
          <text class="radio-text">微信登录</text>
        </label>
        <label class="radio-label">
          <radio value="2" color="#4cd964" class="radio-item" />
          <text class="radio-text">账号密码登录</text>
        </label>
      </radio-group>
    </view>

    <!-- 登录按钮 -->
    <view class="form-container" wx:if="{{type==2}}">
      <view class="input-group">
        <view class="input-item">
          <view class="input-label">账号</view>
          <input class="input-field" placeholder='请输入账号或手机号' bindinput='accountInput' />
        </view>
        <view class="input-item">
          <view class="input-label">密码</view>
          <input class="input-field" placeholder='请输入密码' bindinput='vericodeInput' password="true" />
        </view>
        <view bindtap="loginBtnTap">
          <button class="login-btn">登录</button>
          <text class="login-tip">账号为登录后设定，无账号请使用微信登录</text>
        </view>
      </view>
    </view>
    <view class="wx-login-container" hover-class="button-hover" wx:else>
      <button class="wx-login-btn" open-type="getPhoneNumber" hover-class="btn_tapcolor" bindgetphonenumber="onGetPhoneNumber">微信一键登录</button>
    </view>
  </view>

  <!-- 下部分：信息展示 -->
  <view class="info-area">
    <view class="info-card">
      <text class="product-name">智前通手机汽车互联钥匙期MCCK
        <!-- <text class="product-en">(mobile car connect key)</text> -->
      </text>
      <text class="core-title">核心功能</text>

      <view class="function-list">
        <!-- <view class="function-item">无人租车（自助起租 自动还车 降低取送车成本）</view>
        <view class="function-item">起租油量精准检测 还租油量精准检测（避免油量损失）</view>
        <view class="function-item">控制风控方案（轻点鼠标 远程安全控车）</view>
        <view class="function-item">里程收集（实现按里程收费的小时租）</view> -->
        <view class="function-item">无人租车</view>
        <view class="function-item">起租还租油呈检测</view>
        <view class="function-item">控车风控 </view>
        <view class="function-item">里程收集</view>

      </view>

      <view class="contact-info">
        <text class="company-name">智信通·中国北京</text>
        <!-- <view class="contact-details">
          <text>电话: 010-68283131 网址: www.wiselink.net.cn</text>
        </view> -->
      </view>
    </view>
  </view>
</view>