
<view class='container'>

<form>
  <!--
  <view class='page_title'>注册车辆</view>
-->
  <view class='input_views'>
    <view class='input_item'>
      <view class='input_title'>客户类型</view>
      <radio-group bindchange="radioChange">
        <radio value="0" checked="checked">企业</radio>
        <radio value="1" style="margin-left: 20px;" >个人</radio>
        </radio-group>
    </view>
    <view class='input_item' wx:if="{{companyType == '0'}}">
      <view class='input_title'>企业名称</view>
      <input class='input_v'  value="{{name}}" placeholder='请输入' bindinput='nameInput' ></input>
    </view>
    <view class='input_item' wx:if="{{companyType == '1'}}">
      <view class='input_title'>姓名</view>
      <input class='input_v'  value="{{name}}" placeholder='请输入' bindinput='nameInput' ></input>
    </view>

    <view class='input_item'  wx:if="{{companyType == '0'}}">
        <view class='input_title'>联系人</view>
        <input class='input_v'  value="{{chargename}}" placeholder='请输入' bindinput='chargenameInput' ></input>
      </view>
      <view class='input_item'>
        <view class='input_title'>联系电话</view>
        <input class='input_v'  value="{{chargemobile}}" placeholder='请输入' bindinput='chargemobileInput' ></input>
      </view>
      <view class="input_item">
        <view class="input_title">所在省</view>
        <picker  style="width: 100%;" bindchange="provincePickerChange"  range-key="name" value="{{provinceIndex}}" range="{{provinceList}}">
            <view class='input_v' style="text-align: left;">
            {{provinceIndex !='' ? provinceList[provinceIndex].name :'请选择'}}
            </view>
        </picker>
        <image class="arrowDown" src="../../../assets/images/system/arrow_down@2x.png"></image>
        </view>
      <view class='input_item'>
        <view class='input_title'>所在市</view>
        <picker  style="width: 100%;" bindchange="cityPickerChange"  range-key="name" value="{{cityIndex}}" range="{{cityList}}">
            <view class='input_v' style="text-align: left;">
            {{cityIndex !='' ? cityList[cityIndex].name :'请选择'}}
            </view>
        </picker>
        <image class="arrowDown" src="../../../assets/images/system/arrow_down@2x.png"></image>
      </view>
      <view class='input_item'>
        <view class='input_title'>地址</view>
        <input class='input_v' value="{{address}}" placeholder='请输入' bindinput='addressInput'></input>
      </view>

  </view>

  <view class="g_agreement">
      <checkbox-group bindchange="handleCheckboxChange" data-item="{{checkboxState}}">
        <checkbox value="{{checkboxState}}" checked="{{checkboxState}}" />
      </checkbox-group>
      <text>已阅读并同意</text>
      <text class="user_agreement" bindtap="serviceTap">《用户服务协议》</text>
      <text>&</text>
      <text class="privacy_agreement" bindtap="privateTap">《隐私政策》</text>
    </view>

  <button class='login_btn' hover-class="btn_tapcolor" bindtap='regBtnTap' disabled="{{checkboxState!='checked'}}">提交</button>
 
</form>
</view>