<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="账号管理" />
  <!-- index.wxml -->
  <view class="record-container" style="height: {{c_screen_height-(navBarHeight + statusBarHeight)}}px;margin-top: {{navBarHeight + statusBarHeight}}px;">
    <!-- 切换部分 -->
    <view class="record-tabs" bindtap="handleSwitchTab">
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 1?s_background_tabs_active_1:s_background_tabs_1}}');">账号列表</view>
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 2?s_background_tabs_2:s_background_tabs_active_2}}');">{{btnState}}账号</view>
    </view>
    <!-- 详情区域部分 -->
    <block wx:if="{{c_activeTab == 1}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
        <block wx:for="{{g_items}}" wx:key="index">
          <view class="content-item">
            <view class="content-item-head">
              <view class="head-left">
                <view class="left-category">
                  <text>{{item.realname}}</text>
                </view>
              </view>
              <view class="head-right">
                <image src="/assets/images/home/_edit.png" data-item="{{item}}" bindtap="handleEdit" />
                <image src="/assets/images/home/_delete.png" data-id="{{item.id}}" bindtap="handleDelete" />
              </view>
            </view>
            <view class="content-item-info">
              <view class="info-item  {{item.username.length > 15 ? 'long-info-item' : ''}}">
                <label>账号 ：</label>
                <text>{{item.username||'-'}}</text>
              </view>
              <view class="info-item  {{item.mobile.length > 15 ? 'long-info-item' : ''}}">
                <label>手机号 ：</label>
                <text>{{item.mobile||'-'}}</text>
              </view>
            </view>
          </view>
        </block>
      </scroll-view>
    </block>
    <block wx:if="{{c_activeTab == 2}}">
      <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;">
        <view class="long-range-control-car">
          <block>
            <view class="card-head">
              <text>基础信息</text>
            </view>
            <!-- 标题 -->
            <view class="long-range-control-car-subitem">
              <label>账号<text>*</text></label>
              <view class="card-info-item-input">
                <input placeholder="请输入账号" value="{{params.username}}" data-item="username" bindinput="handleBindinput" />
              </view>
            </view>
            <!-- 密码 -->
            <view class="long-range-control-car-subitem">
              <label>密码<text>*</text></label>
              <view class="card-info-item-input">
                <input placeholder="请输入密码" value="{{params.password}}" data-item="password" bindinput="handleBindinput" />
              </view>
            </view>
            <!-- 姓名 -->
            <view class="long-range-control-car-subitem">
              <label>姓名<text>*</text></label>
              <view class="card-info-item-input">
                <input placeholder="请输入姓名" value="{{params.realname}}" data-item="realname" bindinput="handleBindinput" />
              </view>
            </view>
            <!-- 手机号 -->
            <view class="long-range-control-car-subitem">
              <label>手机号<text>*</text></label>
              <view class="card-info-item-input">
                <input placeholder="请输入手机号" value="{{params.mobile}}" data-item="mobile" bindinput="handleBindinput" />
              </view>
            </view>
          </block>

          <view style="height: 30rpx;"></view>
          <block>
            <view class="card-head">
              <text>权限设置</text>
            </view>
            <view class="long-range-control-car-subitem">
              <view class="tree-container">
                <block wx:for="{{tree}}" wx:key="id">
                  <view class="node">
                    <!-- 一级节点 -->
                    <view class="node-header">
                      <view class="arrow {{item.isExpanded ? 'expanded' : ''}}" wx:if="{{item.children.length}}" bindtap="toggleExpand" data-id="{{item.id}}">▶</view>
                      <view class="checkbox {{item.checked ? 'checked' : ''}} {{item.indeterminate ? 'indeterminate' : ''}}" data-id="{{item.id}}" bindtap="handleCheck">
                        <view class="checkmark" wx:if="{{item.checked}}">✓</view>
                        <view class="indeterminate-line" wx:if="{{item.indeterminate}}"></view>
                      </view>
                      <text class="node-name">{{item.name}}</text>
                    </view>

                    <!-- 二级节点 -->
                    <view class="children" wx:if="{{item.children.length && item.isExpanded}}">
                      <block wx:for="{{item.children}}" wx:key="id">
                        <view class="child-node">
                          <view class="node-header">
                            <view class="arrow {{item.isExpanded ? 'expanded' : ''}}" wx:if="{{item.children.length}}" bindtap="toggleExpand" data-id="{{item.id}}">▶</view>
                            <view class="checkbox {{item.checked ? 'checked' : ''}} {{item.indeterminate ? 'indeterminate' : ''}}" data-id="{{item.id}}" bindtap="handleCheck">
                              <view class="checkmark" wx:if="{{item.checked}}">✓</view>
                              <view class="indeterminate-line" wx:if="{{item.indeterminate}}"></view>
                            </view>
                            <text class="node-name">{{item.name}}</text>
                          </view>

                          <!-- 三级节点 -->
                          <view class="children" wx:if="{{item.children.length && item.isExpanded}}">
                            <block wx:for="{{item.children}}" wx:key="id">
                              <view class="child-node">
                                <view class="node-header">
                                  <view class="arrow {{item.isExpanded ? 'expanded' : ''}}" wx:if="{{item.children.length}}" bindtap="toggleExpand" data-id="{{item.id}}">▶</view>
                                  <view class="checkbox {{item.checked ? 'checked' : ''}} {{item.indeterminate ? 'indeterminate' : ''}}" data-id="{{item.id}}" bindtap="handleCheck">
                                    <view class="checkmark" wx:if="{{item.checked}}">✓</view>
                                    <view class="indeterminate-line" wx:if="{{item.indeterminate}}"></view>
                                  </view>
                                  <text class="node-name">{{item.name}}</text>
                                </view>

                                <!-- 四级节点 -->
                                <view class="children" wx:if="{{item.children.length && item.isExpanded}}">
                                  <block wx:for="{{item.children}}" wx:key="id">
                                    <view class="child-node">
                                      <view class="node-header">
                                        <view class="arrow {{item.isExpanded ? 'expanded' : ''}}" wx:if="{{item.children.length}}" bindtap="toggleExpand" data-id="{{item.id}}">▶</view>
                                        <view class="checkbox {{item.checked ? 'checked' : ''}} {{item.indeterminate ? 'indeterminate' : ''}}" data-id="{{item.id}}" bindtap="handleCheck">
                                          <view class="checkmark" wx:if="{{item.checked}}">✓</view>
                                          <view class="indeterminate-line" wx:if="{{item.indeterminate}}"></view>
                                        </view>
                                        <text class="node-name">{{item.name}}</text>
                                      </view>

                                      <!-- 五级节点 -->
                                      <view class="children" wx:if="{{item.children.length && item.isExpanded}}">
                                        <block wx:for="{{item.children}}" wx:key="id">
                                          <view class="child-node">
                                            <view class="node-header">
                                              <view class="checkbox {{item.checked ? 'checked' : ''}}" data-id="{{item.id}}" bindtap="handleCheck">
                                                <view class="checkmark" wx:if="{{item.checked}}">✓</view>
                                              </view>
                                              <text class="node-name">{{item.name}}</text>
                                            </view>
                                          </view>
                                        </block>
                                      </view>
                                    </view>
                                  </block>
                                </view>
                              </view>
                            </block>
                          </view>
                        </view>
                      </block>
                    </view>
                  </view>
                </block>
              </view>

            </view>
          </block>
          <view class="card-footer">
            <view bindtap="handleSubmit">确认{{btnState}}</view>
          </view>
        </view>

      </scroll-view>
    </block>
  </view>

</view>