<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">

  <!-- 自定义头部 -->
  <custom-header title="{{c_list_details?'角色管理':'添加角色'}}" />
  <block wx:if="{{c_list_details}}">
    <scroll-view class="content-container" scroll-y="true" style="top:{{c_statusBarHeight + c_navBarHeight +2}}px; height: {{c_screen_height-(c_statusBarHeight + c_navBarHeight +2)}}px">
      <block wx:for="{{items}}" wx:key="index">
        <view class="content-item">
          <view class="content-item-head">
            <view class="head-left">
              <view class="left-category">
                <text>{{item.realname}}</text>
              </view>
            </view>
            <view class="head-right">
              <image src="/assets/images/home/_edit.png" data-item="{{item}}" bindtap="handleEdit" />
              <image src="/assets/images/home/_delete.png" bindtap="handleDelete" />
            </view>
          </view>
          <view class="content-item-info">
            <view class="info-item  {{item.username.length > 15 ? 'long-info-item' : ''}}">
              <label>账号 ：</label>
              <text>{{item.username||'-'}}</text>
            </view>
            <view class="info-item  {{item.mobile.length > 15 ? 'long-info-item' : ''}}">
              <label>手机号 ：</label>
              <text>{{item.mobile||'-'}}</text>
            </view>
          </view>
        </view>
      </block>
      <view class="not-yet" wx:if="{{items.length<1}}" style="height: {{c_screen_height-(c_statusBarHeight + c_navBarHeight +2)}}px;">暂无账号</view>
    </scroll-view>
    <view id="{{index}}" class="detection_button" bindtap="handleShowSendKeyModal">
      <text>添加子账号</text>
    </view>
  </block>
  <block wx:else>
    <view class="content-container" style="top:{{c_statusBarHeight + c_navBarHeight +2}}px; height: {{c_screen_height-(c_statusBarHeight + c_navBarHeight +2)}}px">
      <view class="card-head">
        <image src="/assets/images/home/car_icon.png" />
        <text>添加账号</text>
      </view>
      <view class="card-info">
        <!-- 账号 -->
        <view class="card-info-item">
          <label>账号<text>*</text></label>
          <view class="card-info-item-input">
            <input placeholder="请输入账号" value="{{params.username}}" data-item="username" bindinput="handleBindinput" />
          </view>
        </view>
        <!-- 密码 -->
        <view class="card-info-item">
          <label>密码<text>*</text></label>
          <view class="card-info-item-input eye" style="display: flex;align-items: center;gap: 10rpx;">
            <input placeholder="请输入密码" password="{{eye_show_hide}}" value="{{params.password}}" data-item="password" bindinput="handleBindinput" />
            <image src="/assets/images/home/{{eye_show_hide?'eye_hide':'eye_show'}}.png" bindtap="handleshowHide" />
          </view>
        </view>
        <!-- 姓名 -->
        <view class="card-info-item">
          <label>姓名<text>*</text></label>
          <view class="card-info-item-input">
            <input placeholder="请输入姓名" value="{{params.realname}}" data-item="realname" bindinput="handleBindinput" />
          </view>
        </view>
        <!-- 手机号 -->
        <view class="card-info-item">
          <label>手机号<text>*</text></label>
          <view class="card-info-item-input">
            <input placeholder="请输入手机号" value="{{params.mobile}}" data-item="mobile" bindinput="handleBindinput" />
          </view>
        </view>
      </view>
      <view class="card-footer">
        <view bindtap="handleSubmit">确认添加</view>
      </view>
    </view>
  </block>
</view>