<!--pages/system/registView/registView.wxml-->
<!-- <text>pages/system/registView/registView.wxml</text> -->

<image class='bg-img' src="../../../assets/images/background.jpg"></image> 
 <!-- <view class='navigation-bar'></view>  -->

<view class='container'>
  <form>
   
    <view class='input_views'>
    

   

   
      <view class='input_item'>
        <view class='input_title'>原密码</view>
        <input class='input_v' placeholder='请输入' bindinput='oldPasswordInput' password='{{!oldSeepwd}}' value='{{oldPassword}}' ></input>
        <view class='see_v' bindtap='oldChangeSeeState'>
          <image class='see_img' src='{{oldSeeimg_url}}' ></image>
        </view>
    </view>
    <view class='input_item'>
        <view class='input_title'>新密码</view>
        <input class='input_v' placeholder='请输入' bindinput='newPasswordInput' password='{{!newSeepwd}}' value='{{newPassword}}' ></input>
        <view class='see_v' bindtap='newChangeSeeState'>
          <image class='see_img' src='{{newSeeimg_url}}' ></image>
        </view>
    </view>

    <button class='registBtn' hover-class="btn_tapcolor" bindtap='submitBtnTap'>提交</button>

    </view>

  </form>
</view>
