/* pages/system/registView/registView.wxss */

page {
  background-color: black;
  height: 100%;
  width: 100%;
  position: fixed;
} 

.bg-img{
  width: 100%;
  height: 100%;
  position: fixed;
}

.navigation-bar{
  height: 140rpx;
  width: 100%;
  opacity:1;
  position: relative;
  text-align: center;
  line-height: 140rpx;
  background-color: #131313;
  color: white;
  font-size: 35rpx;
}

.container{
  width: 100%;
  text-align: center;
  position: relative;
  font-weight: 200;
}

.page_title
{
  margin-top: 30rpx;
  color: white;
  font-size: 65rpx;
}

.input_views
{
   width: 100%;
}

.input_item
{
  display: flex;
  flex-direction: row;
  margin-top: 50rpx;
  margin-left: 40rpx;
  margin-right: 40rpx;
  height: 90rpx;
  background-color: white;
  border-radius: 10rpx;
  align-items: center;
}

.input_title
{
  width: 20%;
  min-width: 150rpx;
  font-size: 30rpx;
  margin-left: 5rpx;
  color: #4a4a4a;

}
.input_v
{
  margin-left: 10rpx;
  height: 100%;
  width: 75%;
  text-align: left;
  color: #4a4a4a;
  font-size: 30rpx;
}

.veri_v
{
  display: flex;
  flex-direction: row;
  margin-top: 50rpx;
  margin-left: 40rpx;
  margin-right: 40rpx;
  height: 90rpx;
  align-items: center;
}

.input_item1
{
  display: flex;
  flex-direction: row;
  margin-right: 20rpx;
  height: 90rpx;
  background-color: white;
  border-radius: 10rpx;
  align-items: center;
  width: 430rpx;
}

.veri_btn
{
  background-color: rgba(255, 255, 255, 0.2);
  color: white;
  height: 90rpx;
  width: 220rpx;
  font-size: 28rpx;
  line-height: 90rpx;
}

.btn_tapcolor
{
  background-color: #575757;
}

.see_v
{
  width: 100rpx;
  height: 100%;
}

.see_img
{
  margin-left: 10rpx;
  margin-top: 30%;
  width: 70%;
  height: 40%;
}

.registBtn
{
  margin-top: 60rpx;
  margin-left: 40rpx;
  margin-right: 40rpx;
  background-color: #045f33;
  height: 90rpx;
  color: white;
  text-align: bottom;
  font-size: 40rpx;
  line-height: 90rpx;
}
