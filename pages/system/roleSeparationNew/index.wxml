<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">
  <custom-header title="人员角色设定" />
  <!-- index.wxml -->
  <view class="record-container" style="height: {{c_screen_height-(navBarHeight + statusBarHeight)}}px;margin-top: {{navBarHeight + statusBarHeight}}px;">
    <!-- 详情区域部分 -->
    <scroll-view scroll-y style="height:{{c_screen_height-(navBarHeight + statusBarHeight + 10 + 50)}}px;" bindscrolltolower="handleLower" bindrefresherrefresh="handleRefresh" refresher-enabled="true" refresher-triggered="{{g_triggered}}">
      <block wx:for="{{g_items}}" wx:key="index">
        <view class="content-item">
          <view class="content-item-head">
            <view class="head-left">
              <view class="left-category">
                <text>{{item.realname}}<text style="font-size: 22rpx;padding: 4rpx; border-radius: 6rpx;background: #f0f0f0; color: #575656;margin-left: 20rpx;" wx:if="{{item.acquiescent}}">超级管理员</text></text>
              </view>
            </view>
            <view class="head-right">
              <image src="/assets/images/home/_edit.png" data-item="{{item}}" bindtap="handleEdit" />
              <image src="/assets/images/home/_delete.png" data-id="{{item.id}}" bindtap="handleDelete" />
            </view>
          </view>
          <view class="content-item-info">
            <view class="info-item  {{item.username.length > 15 ? 'long-info-item' : ''}}">
              <label>账号 ：</label>
              <text>{{item.username||'-'}}</text>
            </view>
            <view class="info-item  {{item.roleName.length > 15 ? 'long-info-item' : ''}}" style="display: flex;flex-direction: row;">
              <label>角色 ：</label>
              <text wx:if="{{item.roleName}}">{{item.roleName}}</text>
              <!-- <picker data-item="{{item}}" mode="selector" range="{{roleArray}}" range-key="name" value="{{index}}" bindchange="handleBindPickerChange">
                <view class="picker" style="color: royalblue;">
                  {{item.roleName?item.roleName:'绑定角色'}}
                </view>
              </picker> -->
            </view>
            <view class="info-item  {{item.mobile.length > 15 ? 'long-info-item' : ''}}">
              <label>手机号 ：</label>
              <text>{{item.mobile||'-'}}</text>
            </view>
          </view>
        </view>
      </block>
      <block wx:if="{{g_items.length<1}}">
        <view style="display: flex;justify-content: center; align-items: center;font-size: 26rpx;color: #ccc;height: 80vh;">
          无数据
        </view>
      </block>
    </scroll-view>
    <!-- 一键操作按钮 -->
    <view class="levitation-button" bindtap="handleJumpInfo">
      <text>新增人员</text>
    </view>
  </view>

</view>

<!-- 新增人员 -->
<block>
  <view class="modal-mask" wx:if="{{c_send_key_show_momal}}" bindtap="handleHideSengKeyModal"></view>
  <view class="modal-base-map" wx:if="{{c_send_key_show_momal}}">
    <form bindsubmit="handleFormSubmit">
      <view class="modal-container">
        <view class="modal-container-head">
          <text>{{user_text}}人员</text>
          <image src="/assets/images/home/right_1.png" bindtap="handleHideSengKeyModal" />
        </view>
        <view class="modal-container-middle">
          <!-- <view class="middle-form-item">
            <label>账号</label>
            <view class="modal-form-region">
              <input placeholder="请输入账号" value="{{g_uesr_details.username}}" name='username' style="text-align: right;font-size: 28rpx;" />
            </view>

          </view> -->
          <!-- <view class="middle-form-item">
            <label>密码</label>
            <view class="modal-form-region">
              <input placeholder="请输入密码" value="{{g_uesr_details.password}}" name='password' style="text-align: right;font-size: 28rpx;" />
            </view>
          </view> -->
          <view class="middle-form-item">
            <label>姓名</label>
            <view class="modal-form-region">
              <input placeholder="请输入姓名" value="{{g_uesr_details.realname}}" name='realname' style="text-align: right;font-size: 28rpx;" />
            </view>

          </view>
          <view class="middle-form-item">
            <label>手机号</label>
            <view class="modal-form-region">
              <input placeholder="请输入手机号" value="{{g_uesr_details.mobile}}" name='mobile' style="text-align: right;font-size: 28rpx;" />
            </view>
          </view>
          <view class="middle-form-item">
            <label>角色</label>
            <view class="modal-form-region">
              <picker data-item="{{item}}" mode="selector" range="{{roleArray}}" range-key="name" value="{{index}}" bindchange="handleBindPickerChange">
                <view class="picker" style="font-size: 28rpx;color: #575656;">
                  {{new_role.name?new_role.name:'请选择角色'}}
                </view>
              </picker>
            </view>
          </view>
        </view>
        <view class="modal-container-footer">
          <button formType="submit">确认</button>
        </view>
      </view>
    </form>
  </view>
</block>