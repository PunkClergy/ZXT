<!--pages/order/orderList.wxml style="background-color:lightgray"-->
<wxs module="tagsformat" src="../../../utils/filter.wxs"></wxs>
<view wx:if="{{items.length == 0}}" class="scrollView_noDataTip">无数据</view>
<view class='giftListView' >
<view style="width: 100%;display:flex;">
<view style="width: 85%;">
  <mp-searchbar  search='ser' placeholder='姓名' id="searchbar" bindselectresult="selectRes" bindinput="inputChange" bindclear="clearInput" bindcancel="cancel" cancelText="搜索">
  
  </mp-searchbar>
</view>
<view  style="align-items: center;display: flex;margin-left: 0rpx;">
  <button class="addButton"  bindtap="regCarBtnTap"></button>
</view>
</view>
  
<scroll-view style="height: {{scrollHihgt}}px" scroll-y="true" refresher-enabled="true" bindscrolltolower="lower" bindrefresherrefresh="refresh" refresher-triggered="{{triggered}}">
 <block wx:for="{{items}}">
 <!-- 每个cell -->
  <view class='item' style="background-color:white;margin: auto;border-radius: 5px;margin-top: 6px;" wx:key="*this" data-item= "{{item}}" data-id="{{item.ID}}" id="{{item.mappingid}}" bindtap="handleSelectStaff">
  
<!--
   <view class='moneyView'> 
    <text class = 'productDesText'>金额: {{item.ordercost}}元</text>
   </view>
 -->
  <view style="float: left;height: 100%;vertical-align: middle;">
  </view>
   <!-- 具体产品 -->
   <view class='productDesView' style="display: flex;">
    <view class="productDesText" >账号：{{item.username}}</view>
  
    <view class="detialText" style="margin-left: 140rpx;" id="{{index}}" bindtap="editTap" >编辑</view>
    <view class="detialText"  id="{{item.id}}"   bindtap="delTap">删除</view>
    <view class="detialText"  id="{{item.id}}"   bindtap="resetTap">重置密码</view>
    
   </view>
   <view class="fengexian"></view>
   <view class='productDesView' style="display: flex;">
    <view class = 'yibiaoText'>姓名</view>
    <view class = 'qiText'>{{item.name}}</view>
    <view class = 'yibiaoText'>手机号</view>
    <view class = 'qiText'>{{item.mobile}}</view>
   </view>

   <view class='productDesView' style="display: flex;">
    <view class = 'yibiaoText'>创建时间</view>
    <view class = 'qiText' >{{item.createdate}}</view>
   </view>
  </view>
 </block>
</scroll-view>
</view>


