page {
  background-color: #eee;
}

/* s搜索框部分 */
.search-secondary .weui-search-bar__box,
.search-secondary .weui-search-bar__label,
.search-secondary .weui-search-bar__form {
  border-radius: 300px;
}

/* 优化后的WXSS */
.drop-down-filter {
  --filter-active-color: #007aff;
  /* 定义CSS变量 */
  display: flex;
  align-items: center;
  gap: 32rpx;
  justify-content: space-between;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  transition: all 0.2s ease;
  position: relative;
}

.filter-item.active {
  background: var(--filter-active-color);
  color: #fff;
}

.filter-text {
  font-size: 28rpx;
  margin-right: 8rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 25rpx;
  color: #333333;
}

.filter-arrow {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 8rpx 6rpx 0 6rpx;
  border-color: currentColor transparent transparent transparent;
  transition: transform 0.2s;
}

.filter-arrow.up {
  transform: rotate(180deg);
}

.filter-icon {
  width: 30rpx;
  height: 30rpx;
  display: block;
  /* 统一图标颜色 */
}

/* 点击态反馈 */
.filter-item:active {
  opacity: 0.8;
  transform: scale(0.98);
}




/* 触发按钮样式 */
.picker-trigger {
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
}

.trigger-text {
  color: #888;
}

/* 遮罩层 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
}

/* 选择器容器 */
.picker-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 600rpx;
  background: #fff;
  z-index: 1000;
  animation: slideUp 0.3s;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }

  to {
    transform: translateY(0);
  }
}

/* 头部操作栏 */
.picker-header {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}

.picker-btn {
  color: #666;
  font-size: 32rpx;
}

.confirm {
  color: #1aad19;
}

/* 选择器内容 */
.picker-view {
  height: 500rpx;
}

.picker-item {
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
}