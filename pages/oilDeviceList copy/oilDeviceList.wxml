<mp-searchbar ext-class="search-secondary" placeholder="搜索车牌号/地点/车务人员" search="{{false}}" cancel="{{false}}" bindblur="handleMpBulur" bindclear="" bindfocus="" bindinput="" />
<!-- 下拉筛选组件 -->

<view class="drop-down-filter">
  <!-- 使用列表渲染统一处理筛选项 -->
  <view wx:for="{{filterItems}}" wx:key="index" class="filter-item {{item.active ? 'active' : ''}}" bindtap="handleFilterPicker" data-type="{{item.type}}" role="button" aria-label="{{item.label}}筛选">
    <!-- 文本项 -->
    <block wx:if="{{!item.icon}}">
      <text class="filter-text">{{item.label || item.value}}</text>
      <view class="filter-arrow {{item.active ? 'up' : 'down'}}"></view>
    </block>

    <!-- 图标项 -->
    <image wx:else src="{{item.icon}}" class="filter-icon" mode="aspectFit" aria-hidden="true" />
  </view>
</view>


<view class="picker-mask" wx:if="{{showPicker}}" bindtap="hidePicker"></view>

<view class="picker-container" wx:if="{{showPicker}}">
  <view class="picker-header">
    <text class="picker-btn" bindtap="hidePicker">取消</text>
    <text class="picker-btn confirm" bindtap="handleConfirm">确定</text>
  </view>

  <picker-view class="picker-view" value="{{pickerIndex}}" bindchange="bindPickerChange">
    <picker-view-column>
      <view wx:for="{{pickerData}}" wx:key="index" data-index="{{index}}" class="picker-item" bindtap="selectItem">{{item.value}}</view>
    </picker-view-column>
  </picker-view>
</view>

