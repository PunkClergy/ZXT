<view class='top-container'>
  <map id="{{mapId}}"  scale='{{scale}}'  bindmarkertap='markertap' polyline="{{polyline}}" include-points="{{includePoints}}" markers="{{markers}}" longitude="{{longitude}}" latitude="{{latitude}}"   show-scale="true" style="width:100%;height:{{mapHeight}}px">

  <view class='car-time-parent' wx:if="{{type == 1 && code != ''}}">
    <view class='car-info-text'>使用时间</view>
    <view class='address-info-text'>{{rentTimeInfo}}</view>
  </view>

  <!--
  <view class='car-time-parent' hidden="{{isShowRentView || type == 0}}" bindtap="rentViewTap">
    <view class='car-info-text'>订单信息</view>
    <view class='address-info-text'>{{rentTimeInfo}}</view>
  </view>
  
  <view class='car-time-parent' wx:if="{{type==3 && code != ''}}">
    <view class='car-info-text'>{{plateNumber}}</view>
    <view class='address-info-text'>开始使用时间：{{rentTimeInfo}}</view>
  </view>

  <view class='car-time-parent' wx:if="{{type==2}}">
    <view class='car-info-text'>工单任务</view>
    <view class='address-info-text'>任务时间：{{work.receivedate}}</view>
    <view class='address-info-text'>接车地点：{{work.receiveaddress}}</view>
    <view class='address-info-text'>送车地点：{{work.giveaddress}}</view>
  </view>
-->

  <cover-image id="-4" bindtap="controlTap" class='network-icon' src="{{networkControlImg}}" wx:if="{{networkControlImg.length > 0}}"></cover-image>
  <cover-image id="-5" bindtap="controlTap" class='bluetooth-icon' src="{{bluetoothControlImg}}"  wx:if="{{bluetoothControlImg.length > 0}}"></cover-image>
  <cover-image id="-3" bindtap="controlTap" class='position-icon' src="{{positionUrl}}" wx:if="{{positionUrl.length > 0}}"></cover-image>
  <cover-image id="-6" bindtap="controlTap" class='pnavigation-icon' src="{{navigationUrl}}" wx:if="{{navigationUrl.length > 0}}"></cover-image>
  <cover-image id="{{kefuControlId}}" bindtap="controlTap" class='kefu-icon' src="../../assets/images/kefu.png" wx:if="{{navigationUrl.length > 0}}"></cover-image>
  <cover-image id="-8" bindtap="controlTap" class='person-icon' src="../../assets/images/user3.png" wx:if="{{navigationUrl.length > 0}}"></cover-image>

