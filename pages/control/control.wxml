<view hidden="{{coverHeightHidden}}" class='bottom-container' style='height:{{coverHeight}}rpx;'>
  <image class='bg-control-img' src="../../assets/images/control_down_bg.jpg"></image>
  <view class='car-info-parent'>
    <!--<image class='bg-car-img' src="{{carUrl}}" mode='aspectFit'></image>-->
    <view class='car-info-text'>{{carInfo}}</view>
    <view class='address-info-text'>{{addressInfo}}</view>
  </view>
  <view class='control-area'>
    <!-- <view class='empty'></view>
    <button bindtap='downloadApp' class='btn-control'>
      <image class='icon-control' src="../../assets/images/iphone.png" mode='aspectFit'></image>
      <text>下载APP</text>
    </button> -->
    <view class='empty'></view>
    <button bindtap='openLock' class='btn-control'>
      <image class='icon-control' src="../../assets/images/open.png" mode='aspectFit'></image>
      <text>开锁</text>
    </button>
    <view class='empty'></view>
    <button bindtap='closeLock' class='btn-control'>
      <image class='icon-control' src="../../assets/images/close.png" mode='aspectFit'></image>
      <text>关锁</text>
    </button>
    <view class='empty'></view>
    <button bindtap='lookForCar' class='btn-control'>
      <image class='icon-control' src="../../assets/images/find.png" mode='aspectFit'></image>
      <text>寻车</text>
    </button>
    <view class='empty'></view>
    <!--
   <button bindtap='showCarImg' class='btn-control'>
      <image class='icon-control' src="../../assets/images/photo.png" mode='aspectFit'></image>
      <text>查看照片</text>
    </button>
    -->
    <button bindtap='subletTap' class='btn-control'>
      <image class='icon-control' src="../../assets/images/shareCar.png" mode='aspectFit'></image>
      <text>分享车辆</text>
    </button>
    <view class='empty'></view>
  </view>

</view><!--
