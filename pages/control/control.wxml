<view wx:if="{{type==2}}">
  <button class="zuche-icon"  bindtap="uploadImg">完成任务</button>
</view>

<view wx:if="{{isShowRentView && type == 0}}">
  <button class="zuche-icon"  bindtap="uploadImg" style="background-color: red;">归还车辆</button>
</view>

