/* pages/oilList/rentHistoryCom/historyDetail/historyDetail.wxss */
page {
    background-color: var(--weui-BG-0);
      height: 100%;
    }
  
    .swiper-tab{
      width: 100%;
      text-align: center;
      line-height: 80rpx;
      display: flex;
    }
    .swiper-tab-list{
      font-size: 30rpx;
  
      width: 25%;
      color: #000;
      background-color: #fff;
      
    }
    .on{
      color: #da7c0c;
      border-bottom: 5rpx solid #da7c0c;
     
    }
    .swiper-box{
  
      height: 100%;
      width: 100%;
      overflow: hidden;
    }
    .swiper-box view{
        text-align: center;
    }
    .fengexian{
      height: 1rpx;
      width: 100%;
      margin:0rpx auto;
      margin-top: 10rpx;
      background-color:#d2d2d2;
      opacity:0.36;
    }
  
  
  
  
   
  /* 白色背景 */
   
  .modal-content {
    
    width: 100%;
    height: auto;
    overflow: hidden;
    background: #fff;
  
  }
  .model-textView
  {
    display:flex;
    width: 100%;
  }
  
  .model-text
  {
    margin-left: 50rpx;
    font-size: 26rpx;
  }
  
  .model-img
  {
    height: 150rpx;
    width:250rpx ;
    margin-left: 50rpx;
  }
  
  .cancelbtn{
    height: 90rpx;
    width: 50%;
    background-color:white;
    color:gray;
    text-align: center;
    line-height: 90rpx;
    margin: 0 auto;
    margin-top: 40rpx;
    font-size: 32rpx;
  }
  
  .btn{
    height: 90rpx;
    width: 50%;
    background-color: #5a94ff;
    color: #fff;
    text-align: center;
    line-height: 90rpx;
    margin: 0 auto;
    margin-top: 40rpx;
    font-size: 32rpx;
  }
  
  .button-hover {
    background-color:lightgray;
  }
  
  button::after{ 
    border: none; 
  }
  
  button{ 
    border-radius: 0;
  }