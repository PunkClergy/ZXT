
page {
  background-color: var(--weui-BG-0);
    height: 100%;
  }

  .swiper-tab{
    width: 100%;
    text-align: center;
    line-height: 80rpx;
    display: flex;
  }
  .swiper-tab-list{
    font-size: 30rpx;

    width: 25%;
    color: #000;
    background-color: #fff;
    
  }
  .on{
    color: #da7c0c;
    border-bottom: 5rpx solid #da7c0c;
   
  }
  .swiper-box{

    height: 100%;
    width: 100%;
    overflow: hidden;
  }

  .swiper-item{
    margin-top: -60rpx;
  }
  .swiper-box view{
      text-align: center;
  }
  .fengexian{
    height: 1rpx;
    width: 100%;
    margin:0rpx auto;
    margin-top: 10rpx;
    background-color:#d2d2d2;
    opacity:0.36;
  }

/* 遮盖层 */
 
.modal-mask {
  width: 100%;
  height: 100%;
  position: fixed;
  top: 0;
  left: 0;
  background: #000;
  opacity: 0.5;
  overflow: hidden;
  z-index: 9000;
  color: #fff;
}


 
/* 白色背景 */
 
.modal-content {
  position: fixed;
  top: 220rpx;
  left: 50rpx;
  z-index: 9500;
  width: 650rpx;
  height: 600rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 20rpx;
}
