<view class="container" style="background-image: url('{{s_background_picture_of_the_front_page}}');height: {{c_screen_height}}px;">

  <!-- 自定义头部 -->
  <custom-header title="租车人电子钥匙发送" />
  <!-- 车辆基本信息Card -->
  <view class="vehicle-basic-info-container" style="height:{{searchBarHeight}}px;margin-top: {{totalNavHeight}}px">
    <view class="vehicle-basic-content-item {{!cellData?'vehicle-basic-active':''}}">
      <block wx:if="{{!cellData}}">
        <view class="vehicle-basic-active-container" bindtap="handleJumpCarList">
          <text>请选择车辆</text>
          <image src="/assets/images/home/right_1.png" style="width: 30rpx;height: 30rpx;" />
        </view>
      </block>
      <block wx:else>
        <view class="vehicle-content-item-head">
          <view class="vehicle-head-left">
            <view class="vehicle-left-category">
              <image src="/assets/images/home/01.png" />
              <text>{{cellData.platenumber||'-'}}</text>
            </view>
            <view class="split-line"></view>
            <view class="vehicle-left-brand">
              {{cellData.vehicleSerialName||'-'}}{{cellData.vehicleModeName||''}}
            </view>
            <view class="split-line"></view>
            <view class="vehicle-left-model">
              {{cellData.sn ?'自助取还':cellData.sn===null?'非自助取还':'-'}}
            </view>
          </view>
          <view class="vehicle-head-right">
            <view class="vehicle-right-state" bindtap="handleJumpCarList">
              <text>{{cellData?'更换车辆':'选择车辆'}}</text>
              <image src="/assets/images/home/right_1.png" />
            </view>
          </view>
        </view>
        <view class="vehicle-content-item-info">
          <view class="info-item  {{cellData.vin.length > 15 ? 'long-info-item' : ''}}">
            <label>车架号 ：</label>
            <text>{{cellData.vin||'-'}}</text>
          </view>

          <view class="info-item  {{cellData.xsgw.length > 15 ? 'long-info-item' : ''}}">
            <label>油箱容积 ：</label>
            <text>{{item.xsgw||0}}L</text>
          </view>
        </view>
      </block>
    </view>
  </view>
  <!-- 信息内容部分 -->
  <view class="record-container" style="height: {{c_screen_height-(searchBarHeight+totalNavHeight)}}px;">
    <!-- 切换部分 -->
    <view class="record-tabs" bindtap="handleSwitchTab">
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 1?s_background_tabs_active_1:s_background_tabs_1}}');">电子钥匙</view>
      <view class="record-tabs-item" style="background-image: url('{{c_activeTab == 2?s_background_tabs_2:s_background_tabs_active_2}}');">数据及风控</view>
    </view>
    <!-- 详情区域部分 -->
    <block wx:if="{{c_activeTab == 1}}">
      <view class="record-tabs-1">
        <view class="tabs-1-title">
          <image src="/assets/images/home/mcck.png" />
          <text>电子钥匙发送记录</text>
        </view>
        <view class="search-box">
          <icon type="search" size="16" class="search-icon" />
          <input placeholder="车牌号/设备号/租车人" class="search-input" />
        </view>
      </view>
      <view class="tabs-1-conut">共有{{g_total}}辆车</view>
      <scroll-view class="content-container" scroll-y="true" style="top:{{25 + 5 + 8 + 10 + 10 + searchBarHeight}}px;" bindscrolltolower="handleLower">
        <block wx:for="{{g_items}}" wx:key="index">
          <view class="content-card">
            <view class="card-head">
              <view class="card-head-left">
                <text>{{item.personname}}</text>
                <text class="split-line"></text>
                <text class="phone-text">{{item.mobile}}</text>
              </view>
              <view class="card-head-right">
                <text wx:if="{{item.status}}" style="color: #7b7b7c;">已取消</text>
                <text wx:else>使用中</text>

              </view>
            </view>
            <view class="card-info">
              <time-line events="{{[{content:item.startAddress||'-',createdate:item.startdate||'-'},{content:item.endAddress||'-',createdate:item.enddate||'-'}]}}" />
            </view>
            <view class="card-footer" wx:if="{{!item.status}}">
              <text>取消用车</text>
            </view>
          </view>
        </block>
      </scroll-view>
    </block>
    <block wx:if="{{c_activeTab == 2}}">
      <view style="margin: 10rpx; height: {{c_screen_height-(searchBarHeight+totalNavHeight+100)}}px;position: relative;">
        <map-com sn="{{cellData.sn}}" cellData="{{cellData}}" source="sending" />
      </view>
    </block>
  </view>

  <!-- 操作按钮 -->
  <view id="{{index}}" class="detection_button" bindtap="handleShowSendKeyModal" wx:if="{{cellData && c_activeTab == 1}}">
    <text>发送电子钥匙</text>
  </view>
</view>
<!-- 发送电子钥匙弹窗 -->
<block>
  <view class="modal-mask" wx:if="{{c_send_key_show_momal}}" bindtap="handleHideSengKeyModal"></view>
  <view class="modal-base-map" wx:if="{{c_send_key_show_momal}}">
    <form bindsubmit="handleFormSubmit">
      <view class="modal-container">
        <view class="modal-container-head">
          <text>发送电子钥匙</text>
          <image src="/assets/images/home/right_1.png" bindtap="handleHideSengKeyModal" />
        </view>
        <view class="modal-container-middle">
          <view class="middle-form-item">
            <label>车牌号</label>
            <view class="modal-form-region">
              {{cellData.platenumber}}
            </view>

          </view>
          <view class="middle-form-item">
            <label>使用人</label>
            <view class="modal-form-region">
              <input placeholder="请输入使用人" name='personName' style="text-align: right;font-size: 28rpx;" />
            </view>
          </view>
          <view class="middle-form-item">
            <label>手机号</label>
            <view class="modal-form-region">
              <input placeholder="请输入手机号" name='mobile' style="text-align: right;font-size: 28rpx;" />
            </view>

          </view>
          <view class="middle-form-item">
            <label>开始时间</label>
            <view class="modal-form-region">
              <picker mode="date" data-index="startDate" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{startDate}}</text>
                </view>
              </picker>
              <picker mode="time" data-index="startTime" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{startTime}}</text>
                </view>
              </picker>
            </view>

          </view>
          <view class="middle-form-item">
            <label>结束时间</label>
            <view class="modal-form-region">
              <picker mode="date" data-index="endDate" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{endDate}}</text>
                </view>
              </picker>
              <picker mode="time" data-index="endTime" bindchange="bindTimeChange">
                <view class="form-item-text">
                  <text>{{endTime}}</text>
                </view>
              </picker>
            </view>

          </view>
        </view>
        <view class="modal-container-footer">
          <button formType="submit">确认</button>
        </view>
      </view>
    </form>
  </view>
</block>