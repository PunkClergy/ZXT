/* 外层容器 */
.container {
  width: 100%;
  height: 95vh;
  display: flex;
  flex-direction: column;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  touch-action: pan-x;
}


/* 顶部样式 */
.upper {
  background-color: rgb(red, green, blue, 0);
}

.custom-header {
  display: flex;
  align-items: center;
  padding-left: 10px;
}

.logo {
  width: 100%;
  height: 100%;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-left: 10px;
  display: flex;
  align-items: center;
}
.title image{
  margin-left: 10rpx;
}

.title text {
  font-size: 29rpx
}

.swiper-outer-container {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: center;
  padding: 20rpx 20rpx 0rpx 0rpx;
}

.swiper {
  width: 96%;
}


.slide-image {
  width: 100%;
  height: 100%;
  display: block;
}


/* 中间样式 */
.middle {
  flex-grow: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 10rpx;
}

.initialize-quick-entry {
  display: flex;
  justify-content: space-around;
  /* 图标均匀分布 */
  align-items: center;
  flex-wrap: nowrap;
  /* 不换行 */
  padding: 10px 0;
}

.initialize-quick-entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
  /* 每个图标占 20% 的宽度 */
}

.initialize-quick-entry-icon {
  width: 50rpx;
  /* 图标宽度 */
  height: 44rpx;
  /* 图标高度 */
}

.initialize-quick-entry-text {
  font-size: 12px;
  margin-top: 5px;
  text-align: center;
  white-space: nowrap;
  /* 防止文字换行 */
  overflow: hidden;
  text-overflow: ellipsis;
  /* 超出部分用省略号代替 */
}

.slide-quick {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0px;
}

.slide-quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(25% - 10px);
  margin-bottom: 10px;
}

.slide-quick-image {
  width: 50rpx;
  height: 44rpx;
}

.slide-quick-text {
  font-size: 12px;
  margin-top: 5px;
}

.dots-container {
  display: flex;
  justify-content: center;
  margin-top: 10px;
}

.dot {
  width: 20px;
  height: 5px;
  background-color: #aaa;
  border-radius: 20%;
  margin: 0 2px;
}

.active-dot {
  background-color: #007aff;
  width: 10px;
}


/* 底部样式 */
.lower {
  flex-grow: 3;
  display: flex;
  padding: 10rpx;
  justify-content: space-between;

}

.lower-left {
  overflow: auto;
  width: 34%;
  border-radius: 13rpx;
  display: flex;
  flex-direction: column;
  background-repeat: no-repeat;
  background-size: cover;
  padding-top: 20rpx;
}

.lower-right {
  overflow: auto;
  width: 64%;
  background: #FFFFFF;
  padding-top: 20rpx;
  border-radius: 4rpx;
}


.classification-department {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.classification-department-item {
  width: 32%;
  box-sizing: border-box;
  margin-bottom: 10px;
  padding: 10rpx;
  text-align: center;
}

.classification-department-item image {
  width: 80rpx;
  height: 80rpx;
}

.classification-department-text {
  font-size: 22rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #333333;
}

.developed {
  background-color: #fff;
  opacity: 0.5;
}

.not-developed {
  opacity: 1;
}



.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* background-color: rgba(0, 0, 0, 0.5); */
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.dialog-content {
  width: 80%;
  background-color: #fff;
  border-radius: 10px;
  padding: 20px;
  box-sizing: border-box;
  border: 1px solid #eee;
}

.dialog-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 10px;
}

.dialog-body {
  font-size: 16px;
  color: #333;
  margin-bottom: 20px;
}

.dialog-footer {
  display: flex;
  justify-content: space-between;
}

.dialog-btn {
  width: 45%;
  background-color: #fff;
  border: 1px solid #ccc;
  border-radius: 5px;
  padding: 10px;
  box-sizing: border-box;
}

.dialog-confirm {
  background-color: #1aad19;
  color: white;
  border: none;
}