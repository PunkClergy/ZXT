<cover-view class="tab-bar">
  <cover-view class="tab-bar-border"></cover-view>
  <cover-view wx:for="{{list}}" wx:key="index" class="tab-bar-item" data-path="{{item.pagePath}}" data-index="{{index}}" bindtap="switchTab">
    <cover-image src="{{c_link}}/img/{{selectedtext == item.text? item.selectedIconPath : item.iconPath}}"></cover-image>
    <cover-view style="color: {{selectedtext == item.text ? selectedColor : color}}">{{item.text}}</cover-view>
  </cover-view>
</cover-view>