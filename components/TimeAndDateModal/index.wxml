<view class="mask" wx:if="{{visible}}" bindtap="_hideMask"></view>
<view class="popup" wx:if="{{visible}}">
  <view style="border-bottom:1px solid #f0f0f0 ;display: flex;padding: 0 0 12rpx 0;">区间选择</view>

  <view class="picker-container">
    <!-- 开始时间选择器 -->
    <view>开始时间</view>
    <picker-view indicator-style="height: 50px;" style="width: 100%; height: 100px;" value="{{start_value}}" bindchange="bindStartChange">
      <picker-view-column>
        <view wx:for="{{start_years}}" wx:key="index">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{start_months}}" wx:key="index">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{start_days}}" wx:key="index">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{start_hours}}" wx:key="index">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{start_minutes}}" wx:key="index">{{item}}</view>
      </picker-view-column>
    </picker-view>
    <!-- 结束时间选择器 -->
    <view>结束时间</view>
    <picker-view indicator-style="height: 50px;" style="width: 100%; height: 100px;" value="{{end_value}}" bindchange="bindEndChange">
      <picker-view-column>
        <view wx:for="{{end_years}}" wx:key="index">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{end_months}}" wx:key="index">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{end_days}}" wx:key="index">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{end_hours}}" wx:key="index">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{end_minutes}}" wx:key="index">{{item}}</view>
      </picker-view-column>
    </picker-view>
  </view>
  <view class="actions" style="display: flex; justify-content: space-between; width: 100%;border-top: 1px solid #f0f0f0;">
    <view bindtap="handleCancel" style="flex: 1; text-align: center;">取消</view>
    <view bindtap="handleSubmitMask" style="flex: 1; text-align: center;">确定</view>
  </view>
</view>