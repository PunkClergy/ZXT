.component_content_begins_container {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.component_content_begins_container_section {
  display: flex;
  gap: 20rpx;
  align-items: center;
  width: 100%;
}

.component_content_begins_container_section_title {
  font-size: 26rpx;
  width: 30%;
  display: flex;
  justify-content: flex-end;
}

.form_picker {
  width: 70%;
  border: 1px solid #eee;
}

picker {
  height: 60rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
}

picker .picker {
  border-radius: 10px;
  padding: 0 10rpx;
}

.six_choices_for_location {
  width: 70%;
  border: 1px solid #eee;
  border-radius: 4px;
}

.six_choices_for_location input {
  height: 60rpx;
  width: 100%;
  padding: 0 10rpx;
  color: #eee;
}

.six_choices_for_location_map {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0px 10rpx;
  height: 60rpx;
  justify-content: space-between;
}

.input_box_type {
  width: 70%;
  border: 1px solid #eee;
  border-radius: 4px;
}

.input_box_type input {
  height: 60rpx;
  width: 100%;
  padding: 0 10rpx;

  color: #eee;
}

.container {
  padding: 20px;
}

.dialog-background {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.dialog-content {
  background-color: #fff;
  padding: 20px;
  border-radius: 10px;
  width: 80%;
  max-width: 600px;
  text-align: center;
  position: relative;
  z-index: 1001;
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.dialog-body {
  padding: 0 20px;
}